-- Members unnested straight after CLUSTER BY are never collected: the plan has no listify and no GROUP BY
-- on the cluster id, only the labelled rows with the cluster id assigned per row and the member record
-- built above them. Collecting first would build each cluster's whole member list -- the entire input, as k
-- arrays -- to take it apart again, and a large input exceeds the size one list can reach.
drop dataverse clusterby_test if exists;
create dataverse clusterby_test;
use clusterby_test;
create type clusterby_test.ReviewType as closed {
  id : integer,
  reviewEmbedding : [double]
};
create dataset Reviews(ReviewType) primary key id;
with mc as (
  from Reviews as r
  cluster by r.reviewEmbedding as sc cluster as members
  with { "clustering_algorithm": "K-Means", "dimension": [2], "num_clusters": 2, "seed": 42 }
  select sc.cluster_id as cid, members
)
from mc, mc.members as m
select mc.cid as cid, m.r.id as id;
