-- A filter on the cluster id gets pushed below the UNNEST, between it and the operator. It selects whole
-- clusters, and the cluster id is constant across a cluster's rows, so the shortcut still applies with the
-- filter re-applied over the per-row cluster id: no listify of members and no GROUP BY on the cluster id,
-- only a SELECT on it above the labelled rows.
drop dataverse clusterby_test if exists;
create dataverse clusterby_test;
use clusterby_test;
create type clusterby_test.ReviewType as closed {
  id : integer,
  reviewEmbedding : [double]
};
create dataset Reviews(ReviewType) primary key id;
with mc as (
  from Reviews as r
  cluster by r.reviewEmbedding as sc cluster as members
  with { "clustering_algorithm": "K-Means", "dimension": [2], "num_clusters": 2, "seed": 42 }
  select sc.cluster_id as cid, members
)
from mc, mc.members as m
where mc.cid = 1
select mc.cid as cid, m.r.id as id;
