-- CLUSTER BY over an input whose parallelism differs from the loop's. A global LIMIT collapses its input to
-- one partition, while the k-means loop stages are pinned to one instance per compute partition. The physical
-- operator therefore requires a partitioning over the computation node domain on its vector input, and the
-- property enforcer answers with a repartition -- so this plan must contain a RANDOM_PARTITION_EXCHANGE.
-- Without that requirement the two are joined one-to-one and the connector addresses a producer partition
-- that does not exist, failing the job.
drop dataverse clusterby_test if exists;
create dataverse clusterby_test;
use clusterby_test;

create type clusterby_test.ReviewType as closed {
  id : integer,
  reviewEmbedding : [double]
};
create dataset Reviews(ReviewType) primary key id;

from (select value r from Reviews r order by r.id limit 100) as t
cluster by t.reviewEmbedding as sc
with { "clustering_algorithm": "K-Means", "dimension": [2], "num_clusters": 2 }
select sc.cluster_id as cid;
