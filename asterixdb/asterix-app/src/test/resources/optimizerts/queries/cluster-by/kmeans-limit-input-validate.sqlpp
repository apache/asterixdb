-- CLUSTER BY over an unpartitioned input. A global LIMIT collapses its input to one partition, and the
-- stages follow it, as GROUP BY would: one loop instance where the rows already are, no repartition. So this
-- plan must contain NO RANDOM_PARTITION_EXCHANGE and NO HASH_PARTITION_EXCHANGE, since the stages, the group-by
-- and the result all stay unpartitioned. Repartitioning instead sent the rows through the unseeded random
-- exchange (the clustering then varied run to run), left the operators above the clause with a stale
-- unpartitioned mode (an ORDER BY over the clusters was dropped as already satisfied), and evaluated the
-- subquery once per stage copy.
drop dataverse clusterby_test if exists;
create dataverse clusterby_test;
use clusterby_test;

create type clusterby_test.ReviewType as closed {
  id : integer,
  reviewEmbedding : [double]
};
create dataset Reviews(ReviewType) primary key id;

from (select value r from Reviews r order by r.id limit 100) as t
cluster by t.reviewEmbedding as sc
with { "clustering_algorithm": "K-Means", "dimension": [2], "num_clusters": 2, "seed": 42 }
select sc.cluster_id as cid;
