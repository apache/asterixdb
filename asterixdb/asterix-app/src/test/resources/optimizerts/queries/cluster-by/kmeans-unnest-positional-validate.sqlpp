-- A positional unnest numbers the members within their cluster, which needs the whole list: the shortcut
-- must stand aside, and the plan keeps the GROUP BY with its listify of members under the UNNEST.
drop dataverse clusterby_test if exists;
create dataverse clusterby_test;
use clusterby_test;
create type clusterby_test.ReviewType as closed {
  id : integer,
  reviewEmbedding : [double]
};
create dataset Reviews(ReviewType) primary key id;
with mc as (
  from Reviews as r
  cluster by r.reviewEmbedding as sc cluster as members
  with { "clustering_algorithm": "K-Means", "dimension": [2], "num_clusters": 2, "seed": 42 }
  select sc.cluster_id as cid, members
)
from mc, mc.members as m at pos
select mc.cid as cid, pos, m.r.id as id;
