-- CLUSTER BY syntax plan validation (minimal): the clause desugars into the distributed k-means shape
-- validated by kmeans-validate — first-k seed + 3 unrolled Lloyd iterations (two-step CENTROID
-- aggregate, centroid list broadcast into nearest_centroid) + a final GROUP BY labeling pass.
drop dataverse clusterby_test if exists;
create dataverse clusterby_test;
use clusterby_test;

create type clusterby_test.ReviewType as closed {
  id : integer,
  reviewEmbedding : [double]
};
create dataset Reviews(ReviewType) primary key id;

from Reviews as r
cluster by r.reviewEmbedding as sc
with { "clustering_algorithm": "K-Means", "dimension": [2], "num_clusters": 2 }
select sc.cluster_id as cid, sc.centroid as centroid;
