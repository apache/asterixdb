-- A WITH variable that is not inlined (non-functional binding) read after CLUSTER BY is a decoration of the operator, and of the labelling GROUP BY in the expansion.
drop dataverse clusterby_test if exists;
create dataverse clusterby_test;
use clusterby_test;
create type clusterby_test.ReviewType as closed {
  id : integer,
  reviewEmbedding : [double]
};
create dataset Reviews(ReviewType) primary key id;
with t as current_datetime()
from Reviews as r cluster by r.reviewEmbedding as sc cluster as members
with {"clustering_algorithm": "K-Means",  "dimension": [2], "num_clusters": 2, "seed": 42 }
select sc.cluster_id as cid, t, array_count(members) as cnt
order by cid;
