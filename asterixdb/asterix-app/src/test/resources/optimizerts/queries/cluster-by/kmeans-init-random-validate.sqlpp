-- initMode "random" seeds Lloyd directly from k vectors of the data set. Guards HOW those k are chosen:
-- the ORDER BY key must be random(vec[0]) -- a per-row hash, so the k smallest keys are a uniform sample --
-- and NOT the vector itself, which would return the k lexicographically smallest vectors, i.e. the k most
-- SIMILAR points in the data set. The plan must also carry no oversample loop and no recluster.
drop dataverse clusterby_test if exists;
create dataverse clusterby_test;
use clusterby_test;

create type clusterby_test.ReviewType as closed {
  id : integer,
  reviewEmbedding : [double]
};
create dataset Reviews(ReviewType) primary key id;

from Reviews as r
cluster by r.reviewEmbedding as sc
with { "clustering_algorithm": "K-Means", "dimension": [2], "num_clusters": 3, "init_mode": "random" }
select sc.cluster_id as cid;
