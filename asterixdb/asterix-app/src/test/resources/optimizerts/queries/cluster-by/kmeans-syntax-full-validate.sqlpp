-- CLUSTER BY syntax plan validation (full): the flagship APE 33 example — movies clustered by the
-- embedding of their summarized reviews — exercising CLUSTER AS plus every WITH option. Desugars into
-- the same distributed k-means shape as kmeans-full-validate (seed + 3 unrolled Lloyd iterations).
drop dataverse clusterby_test if exists;
create dataverse clusterby_test;
use clusterby_test;

create type clusterby_test.MovieType as closed {
  movie_id : integer,
  movie_year : integer,
  reviewEmbedding : [double]
};
create dataset movies(MovieType) primary key movie_id;

from movies as m
where m.movie_year < 2020
cluster by m.reviewEmbedding as sc
cluster as movieCluster
with {
  "clustering_algorithm": "K-Means",
  "dimension": [2], "num_clusters": 5,
  "cross_pollination": false,
  "similarity": "euclidean"
}
select sc.cluster_id as cid, array_count(movieCluster) as cnt, movieCluster;
