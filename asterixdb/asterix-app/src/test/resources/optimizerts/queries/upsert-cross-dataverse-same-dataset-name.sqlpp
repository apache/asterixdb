/*
 * Description     : UPSERT INTO a dataset selecting from a DIFFERENT dataset that happens to share
 *                   the same dataset name in another dataverse. This is NOT a self-scan, so
 *                   IntroduceMaterializationForInsertWithSelfScanRule must NOT insert a
 *                   materialize: doing so spills the whole decompressed input to a local run file.
 *                   Compare with insert-and-scan-dataset.sqlpp, a genuine self-scan, which must
 *                   keep its materialize.
 * Expected Result : Success, plan contains no MATERIALIZE
 */

drop  dataverse sync if exists;
drop  dataverse prod if exists;
create  dataverse sync;
create  dataverse prod;

create type sync.myDataType as
{
  id : integer
};

create type prod.myDataType as
{
  id : integer
};

create  dataset sync.myData(sync.myDataType) primary key id;
create  dataset prod.myData(prod.myDataType) primary key id;

upsert into prod.myData
select element {'id':x.id}
from  sync.myData as x
;
