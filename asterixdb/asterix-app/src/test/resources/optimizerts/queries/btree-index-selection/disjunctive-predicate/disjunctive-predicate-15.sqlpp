/*
 * Description: An IN list on the second field of an untyped index, after a range on the first, is left to the
 *              SELECT: a search for each of its values would overlap the others.
 * Expected Result: Success
 */

drop  dataverse test if exists;
create  dataverse test;

use test;

create  dataset TestSet primary key (id: bigint);
create  dataset CompositeKeySet primary key (k1: bigint, k2: bigint);

create  index idx_a  on TestSet (a) type btree;
create  index idx_cd  on TestSet (c, d) type btree;

select value sum(x.b)
from  TestSet as x
where x.c > 1 and x.d in [3, 4]
;
