/*
 * Description: An equality on the key of an IN list is added to the list, so the search covers every value of the
 *              list and the SELECT tests both conditions.
 * Expected Result: Success
 */

drop  dataverse test if exists;
create  dataverse test;

use test;

create type test.TestType as
{
  id : bigint,
  a : bigint,
  b : bigint,
  c : bigint,
  d : bigint
};

create type test.CompositeKeyType as
{
  k1 : bigint,
  k2 : bigint,
  v : bigint
};

create  dataset TestSet(TestType) primary key id;
create  dataset CompositeKeySet(CompositeKeyType) primary key k1, k2;

create  index idx_a  on TestSet (a) type btree;
create  index idx_cd  on TestSet (c, d) type btree;

select element x
from  TestSet as x
where x.a in [1, 2, 3] and x.a = 2
;
