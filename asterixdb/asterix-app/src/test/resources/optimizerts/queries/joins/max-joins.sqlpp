/*
 * Description  : A query with more joins than the join order enumeration is allowed to handle.
 * Expected Res : The rule based optimizer plan, as the cost based optimizer is skipped.
 */

drop dataverse test if exists;
create dataverse test;
use test;

create dataset ds(id uuid not unknown) open type primary key `id` autogenerated;

set `compiler.cbo.maxjoins` "2";

select count(*) from ds t1, ds t2, ds t3, ds t4
where t1.x = t2.x and t2.x = t3.x and t3.x = t4.x;
