/*
 * Description  : A WHERE that an outer query applies to the rows a subquery's LIMIT let through must stay
 *                above that LIMIT. Pushed below it, the filter would decide which rows the LIMIT is taken
 *                from instead, a different query (ASTERIXDB-3870). The plan must show the SELECT above the
 *                LIMIT, not beneath the sort.
 * Expected Res : Success
 */

DROP DATAVERSE test IF EXISTS;
CREATE DATAVERSE test;
USE test;

CREATE TYPE MovieType AS { id: int, year: int };
CREATE DATASET Movies(MovieType) PRIMARY KEY id;

SET `compiler.sort.parallel` "false";

SELECT VALUE t.id
FROM (SELECT VALUE m FROM Movies m ORDER BY m.year LIMIT 3) t
WHERE t.year > 2001
ORDER BY t.id;
