/*
 * Description  : A time travel value may be built from a clock function. Such a function is impure and is not
 *              : folded anywhere else, but this position is consumed before the job exists, so it is resolved
 *              : here. The datasets are internal, so the resolved value is discarded and the plan is the plain
 *              : plan -- what is tested is that each form compiles, which it cannot do unless the value was
 *              : reduced to a constant.
 * Expected Res : Success
 */

drop dataverse timetravel if exists;
create dataverse timetravel;

use timetravel;

create type timetravel.UserType as {
  uid : integer
};

create dataset Users(UserType) primary key uid;

select element {'a': u.uid, 'b': v.uid, 'c': w.uid}
from Users as u AT TIMESTAMP current_datetime_immediate() - duration("P3M"),
     Users as v AT TIMESTAMP current_date_immediate(),
     Users as w AT SNAPSHOT unix_time_from_datetime_in_ms(current_datetime_immediate())
where u.uid = v.uid and v.uid = w.uid
;
