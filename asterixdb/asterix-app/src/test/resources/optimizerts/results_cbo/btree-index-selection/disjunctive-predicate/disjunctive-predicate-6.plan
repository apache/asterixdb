distribute result [$$x]
-- DISTRIBUTE_RESULT  |PARTITIONED|
  exchange
  -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
    project ([$$x]) [cardinality: 1000000.0, doc-size: -1.0, op-cost: 0.0, total-cost: 499992.37]
    -- STREAM_PROJECT  |PARTITIONED|
      exchange [cardinality: 1000000.0, doc-size: -1.0, op-cost: 0.0, total-cost: 499992.37]
      -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
        unnest-map [$$23, $$x] <- index-search("TestSet", 0, "Default", "test", "TestSet", false, true, 1, $$25, 1, $$25, true, true, true) [cardinality: 1000000.0, doc-size: -1.0, op-cost: 0.0, total-cost: 499992.37]
        -- BTREE_SEARCH  |PARTITIONED|
          exchange [cardinality: 0.0, doc-size: 0.0, op-cost: 0.0, total-cost: 0.0]
          -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
            order (ASC, $$25) [cardinality: 1000000.0, doc-size: -1.0, op-cost: 499992.37, total-cost: 499992.37]
            -- STABLE_SORT [$$25(ASC)]  |PARTITIONED|
              exchange [cardinality: 0.0, doc-size: 0.0, op-cost: 0.0, total-cost: 0.0]
              -- HASH_PARTITION_EXCHANGE [$$25]  |PARTITIONED|
                unnest $$25 <- scan-collection(array: [ "one", "two" ]) [cardinality: 0.0, doc-size: 0.0, op-cost: 0.0, total-cost: 0.0]
                -- UNNEST  |PARTITIONED|
                  empty-tuple-source [cardinality: 0.0, doc-size: 0.0, op-cost: 0.0, total-cost: 0.0]
                  -- EMPTY_TUPLE_SOURCE  |PARTITIONED|
