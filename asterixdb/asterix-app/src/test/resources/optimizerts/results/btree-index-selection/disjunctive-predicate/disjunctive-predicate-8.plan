distribute result [$$x]
-- DISTRIBUTE_RESULT  |PARTITIONED|
  exchange
  -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
    select (eq($$x.getField(2), 1))
    -- STREAM_SELECT  |PARTITIONED|
      project ([$$x])
      -- STREAM_PROJECT  |PARTITIONED|
        exchange
        -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
          unnest-map [$$24, $$x] <- index-search("TestSet", 0, "Default", "test", "TestSet", false, true, 1, $$26, 1, $$26, true, true, true)
          -- BTREE_SEARCH  |PARTITIONED|
            exchange
            -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
              order (ASC, $$26)
              -- STABLE_SORT [$$26(ASC)]  |PARTITIONED|
                exchange
                -- HASH_PARTITION_EXCHANGE [$$26]  |PARTITIONED|
                  unnest $$26 <- scan-collection(array: [ 1, 2, 3 ])
                  -- UNNEST  |PARTITIONED|
                    empty-tuple-source
                    -- EMPTY_TUPLE_SOURCE  |PARTITIONED|
