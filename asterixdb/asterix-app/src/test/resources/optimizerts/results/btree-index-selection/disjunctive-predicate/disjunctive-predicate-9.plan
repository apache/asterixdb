distribute result [$$x]
-- DISTRIBUTE_RESULT  |PARTITIONED|
  exchange
  -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
    project ([$$x])
    -- STREAM_PROJECT  |PARTITIONED|
      exchange
      -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
        unnest-map [$$24, $$25, $$x] <- index-search("CompositeKeySet", 0, "Default", "test", "CompositeKeySet", false, true, 2, $$27, $$28, 2, $$27, $$28, true, true, true)
        -- BTREE_SEARCH  |PARTITIONED|
          exchange
          -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
            order (ASC, $$27) (ASC, $$28)
            -- STABLE_SORT [$$27(ASC), $$28(ASC)]  |PARTITIONED|
