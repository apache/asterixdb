distribute result [$$x]
-- DISTRIBUTE_RESULT  |PARTITIONED|
  exchange
  -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
    select (and(gt($$36, $$37), ge($$36, $$37))) project: [$$x]
    -- STREAM_SELECT  |PARTITIONED|
      assign [$$36] <- [$$y.getField(1)] project: [$$x, $$37, $$36]
      -- ASSIGN  |PARTITIONED|
        project ([$$x, $$37, $$y])
        -- STREAM_PROJECT  |PARTITIONED|
          exchange
          -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
            unnest-map [$$39, $$y] <- index-search("DsTwo", 0, "Default", "test1", "DsTwo", true, false, 1, $$41, 1, $$41, true, true, true)
            -- BTREE_SEARCH  |PARTITIONED|
              exchange
              -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                order (ASC, $$41)
                -- STABLE_SORT [$$41(ASC)]  |PARTITIONED|
                  exchange
                  -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                    project ([$$x, $$37, $$41])
                    -- STREAM_PROJECT  |PARTITIONED|
                      exchange
                      -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                        unnest-map [$$40, $$41] <- index-search("idx_key2", 0, "Default", "test1", "DsTwo", true, true, 1, $$37, 0, false, true, false)
                        -- BTREE_SEARCH  |PARTITIONED|
                          exchange
                          -- BROADCAST_EXCHANGE  |PARTITIONED|
                            assign [$$37] <- [$$x.getField(1)]
                            -- ASSIGN  |PARTITIONED|
                              project ([$$x])
                              -- STREAM_PROJECT  |PARTITIONED|
                                exchange
                                -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                  data-scan []<-[$$38, $$x] <- test1.DsOne
                                  -- DATASOURCE_SCAN  |PARTITIONED|
                                    exchange
                                    -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                      empty-tuple-source
                                      -- EMPTY_TUPLE_SOURCE  |PARTITIONED|
