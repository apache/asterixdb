  exchange
  -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
    project ([$$x])
    -- STREAM_PROJECT  |PARTITIONED|
      exchange
      -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
        unnest-map [$$39, $$y] <- index-search("DsTwo", 0, "Default", "test1", "DsTwo", true, true, 1, $$37, 0, false, true, false)
        -- BTREE_SEARCH  |PARTITIONED|
          exchange
          -- BROADCAST_EXCHANGE  |PARTITIONED|
            assign [$$37] <- [$$x.getField(1)]
            -- ASSIGN  |PARTITIONED|
              project ([$$x])
