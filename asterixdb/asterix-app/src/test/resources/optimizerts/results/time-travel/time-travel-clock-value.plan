                            empty-tuple-source
                            -- EMPTY_TUPLE_SOURCE  |PARTITIONED|
          exchange
          -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
            assign [$$66] <- [$$65] project: [$$66]
            -- ASSIGN  |PARTITIONED|
              exchange
              -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                replicate
