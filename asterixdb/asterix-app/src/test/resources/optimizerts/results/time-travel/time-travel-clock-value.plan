distribute result [$$60]
-- DISTRIBUTE_RESULT  |PARTITIONED|
  exchange
  -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
    assign [$$60] <- [{"a": $$64, "b": $$65, "c": $$66}] project: [$$60]
    -- ASSIGN  |PARTITIONED|
      exchange
      -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
        join (eq($$65, $$66))
        -- HYBRID_HASH_JOIN [$$65][$$66]  |PARTITIONED|
          exchange
          -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
            join (eq($$64, $$65))
            -- HYBRID_HASH_JOIN [$$64][$$65]  |PARTITIONED|
              exchange
              -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                assign [$$64] <- [$$65] project: [$$64]
                -- ASSIGN  |PARTITIONED|
                  exchange
                  -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                    replicate
                    -- REPLICATE  |PARTITIONED|
