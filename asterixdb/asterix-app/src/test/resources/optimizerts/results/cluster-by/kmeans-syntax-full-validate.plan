                                                          exchange
                                                          -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                            assign [$$160] <- [$$m.getField(2)]
                                                            -- ASSIGN  |PARTITIONED|
                                                              project ([$$m])
                                                              -- STREAM_PROJECT  |PARTITIONED|
                                                                exchange
                                                                -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                                  data-scan []<-[$$196, $$m] <- clusterby_test.movies
                                                                  -- DATASOURCE_SCAN  |PARTITIONED|
                                                                    exchange
                                                                    -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                                      empty-tuple-source
                                                                      -- EMPTY_TUPLE_SOURCE  |PARTITIONED|
                                        exchange
                                        -- BROADCAST_EXCHANGE  |PARTITIONED|
                                          kmeans-stage $$171 <- recluster pool $$169 to 5 means
                                          -- KMEANS_RECLUSTER  |PARTITIONED|
                                            exchange
                                            -- BROADCAST_EXCHANGE  |PARTITIONED|
                                              kmeans-stage $$169 <- oversample-loop 5 rounds of $$154 vs seed $$160
                                              -- KMEANS_OVERSAMPLE_LOOP  |PARTITIONED|
                                                exchange
                                                -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                  replicate
                                                  -- REPLICATE  |PARTITIONED|
                                                    exchange
                                                    -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                      select (lt($$m.getField(1), 2020)) project: [$$154]
                                                      -- STREAM_SELECT  |PARTITIONED|
                                                        assign [$$m, $$154] <- [$$m, $$160] project: [$$m, $$154]
                                                        -- ASSIGN  |PARTITIONED|
                                                          exchange
