                    order (ASC, $$141)
                    -- STABLE_SORT [$$141(ASC)]  |PARTITIONED|
                      exchange
                      -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                        kmeans-stage $$141 <- lloyd-loop 3 iterations of $$140 vs pool $$139 by euclidean_squared
                        -- KMEANS_LLOYD_LOOP  |PARTITIONED|
                          exchange
                          -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                            assign [$$140] <- [$$118] project: [$$140]
                            -- ASSIGN  |PARTITIONED|
                              exchange
                              -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                replicate
