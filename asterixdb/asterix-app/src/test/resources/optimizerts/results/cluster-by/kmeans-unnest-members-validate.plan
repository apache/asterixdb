distribute result [$$129]
-- DISTRIBUTE_RESULT  |PARTITIONED|
  exchange
  -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
    assign [$$129] <- [{"cid": $$143, "id": $$119.getField(0).getField(0)}] project: [$$129]
    -- ASSIGN  |PARTITIONED|
      select (not(is-unknown($$143)))
      -- STREAM_SELECT  |PARTITIONED|
        assign [$$143] <- [nearest-centroid($$118, $$142, "euclidean_squared")] project: [$$119, $$143]
        -- ASSIGN  |PARTITIONED|
          exchange
          -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
            join (true)
            -- NESTED_LOOP  |PARTITIONED|
              exchange
              -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                replicate
                -- REPLICATE  |PARTITIONED|
                  exchange
                  -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                    assign [$$119, $$118] <- [{"r": $$r}, $$r.getField(1)] project: [$$119, $$118]
                    -- ASSIGN  |PARTITIONED|
                      project ([$$r])
                      -- STREAM_PROJECT  |PARTITIONED|
                        exchange
                        -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                          data-scan []<-[$$130, $$r] <- clusterby_test.Reviews
                          -- DATASOURCE_SCAN  |PARTITIONED|
                            exchange
                            -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                              empty-tuple-source
                              -- EMPTY_TUPLE_SOURCE  |PARTITIONED|
