                                        -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                          data-scan []<-[$$130, $$r] <- clusterby_test.Reviews
                                          -- DATASOURCE_SCAN  |PARTITIONED|
                                            exchange
                                            -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                              empty-tuple-source
                                              -- EMPTY_TUPLE_SOURCE  |PARTITIONED|
                          exchange
                          -- BROADCAST_EXCHANGE  |PARTITIONED|
                            kmeans-stage $$139 <- recluster pool $$138 to 2 means (seed 42) by euclidean_squared
                            -- KMEANS_RECLUSTER  |PARTITIONED|
                              exchange
                              -- BROADCAST_EXCHANGE  |PARTITIONED|
                                kmeans-stage $$138 <- oversample-loop 5 rounds of $$137 vs seed $$135 (seed 42) by euclidean_squared
                                -- KMEANS_OVERSAMPLE_LOOP  |PARTITIONED|
                                  exchange
                                  -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                    assign [$$137] <- [$$118] project: [$$137]
                                    -- ASSIGN  |PARTITIONED|
                                      exchange
                                      -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                        replicate
                                        -- REPLICATE  |PARTITIONED|
                                          exchange
                                          -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                            assign [$$119, $$118] <- [{"r": $$r}, $$r.getField(1)] project: [$$119, $$118]
                                            -- ASSIGN  |PARTITIONED|
                                              project ([$$r])
                                              -- STREAM_PROJECT  |PARTITIONED|
                                                exchange
                                                -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                  data-scan []<-[$$130, $$r] <- clusterby_test.Reviews
                                                  -- DATASOURCE_SCAN  |PARTITIONED|
                                                    exchange
                                                    -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                      empty-tuple-source
                                                      -- EMPTY_TUPLE_SOURCE  |PARTITIONED|
                                  exchange
                                  -- BROADCAST_EXCHANGE  |PARTITIONED|
                                    limit 1
                                    -- STREAM_LIMIT  |UNPARTITIONED|
                                      project ([$$135])
                                      -- STREAM_PROJECT  |PARTITIONED|
                                        exchange
                                        -- SORT_MERGE_EXCHANGE [$$136(ASC) ]  |PARTITIONED|
                                          limit 1
                                          -- STREAM_LIMIT  |PARTITIONED|
                                            exchange
                                            -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                              order (topK: 1) (ASC, $$136)
                                              -- STABLE_SORT [topK: 1] [$$136(ASC)]  |PARTITIONED|
                                                exchange
                                                -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                  assign [$$136] <- [vector-shuffle-key($$135, 42)]
                                                  -- ASSIGN  |PARTITIONED|
                                                    select (and(is-array($$135), eq(sql-count($$135), 2)))
