              order (ASC, $$147)
              -- STABLE_SORT [$$147(ASC)]  |PARTITIONED|
                exchange
                -- HASH_PARTITION_EXCHANGE [$$147]  |PARTITIONED|
                  select (not(is-unknown($$147)))
                  -- STREAM_SELECT  |PARTITIONED|
                    assign [$$147] <- [nearest-centroid($$118, $$146, "euclidean_squared")] project: [$$119, $$147]
                    -- ASSIGN  |PARTITIONED|
                      exchange
                      -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                        join (true)
                        -- NESTED_LOOP  |PARTITIONED|
                          exchange
                          -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                            replicate
                            -- REPLICATE  |PARTITIONED|
                              exchange
                              -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                assign [$$119, $$118] <- [{"r": $$r}, $$r.getField(1)] project: [$$119, $$118]
