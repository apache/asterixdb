                                order (ASC, $$145)
                                -- STABLE_SORT [$$145(ASC)]  |PARTITIONED|
                                  exchange
                                  -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                    kmeans-stage $$145 <- lloyd-loop 3 iterations of $$144 vs pool $$143 by euclidean_squared
                                    -- KMEANS_LLOYD_LOOP  |PARTITIONED|
                                      exchange
                                      -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                        assign [$$144] <- [$$118] project: [$$144]
                                        -- ASSIGN  |PARTITIONED|
                                          exchange
                                          -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                            replicate
                                            -- REPLICATE  |PARTITIONED|
                                              exchange
                                              -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                assign [$$119, $$118] <- [{"r": $$r}, $$r.getField(1)] project: [$$119, $$118]
                                                -- ASSIGN  |PARTITIONED|
                                                  project ([$$r])
                                                  -- STREAM_PROJECT  |PARTITIONED|
                                                    exchange
                                                    -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                      data-scan []<-[$$132, $$r] <- clusterby_test.Reviews
                                                      -- DATASOURCE_SCAN  |PARTITIONED|
                                                        exchange
                                                        -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                          empty-tuple-source
                                                          -- EMPTY_TUPLE_SOURCE  |PARTITIONED|
                                      exchange
                                      -- BROADCAST_EXCHANGE  |PARTITIONED|
                                        kmeans-stage $$143 <- recluster pool $$142 to 2 means (seed 42) by euclidean_squared
                                        -- KMEANS_RECLUSTER  |PARTITIONED|
                                          exchange
                                          -- BROADCAST_EXCHANGE  |PARTITIONED|
                                            kmeans-stage $$142 <- oversample-loop 5 rounds of $$141 vs seed $$139 (seed 42) by euclidean_squared
                                            -- KMEANS_OVERSAMPLE_LOOP  |PARTITIONED|
                                              exchange
                                              -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                assign [$$141] <- [$$118] project: [$$141]
                                                -- ASSIGN  |PARTITIONED|
                                                  exchange
                                                  -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                    replicate
                                                    -- REPLICATE  |PARTITIONED|
                                                      exchange
                                                      -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                        assign [$$119, $$118] <- [{"r": $$r}, $$r.getField(1)] project: [$$119, $$118]
                                                        -- ASSIGN  |PARTITIONED|
                                                          project ([$$r])
                                                          -- STREAM_PROJECT  |PARTITIONED|
                                                            exchange
                                                            -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                              data-scan []<-[$$132, $$r] <- clusterby_test.Reviews
                                                              -- DATASOURCE_SCAN  |PARTITIONED|
                                                                exchange
                                                                -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                                  empty-tuple-source
                                                                  -- EMPTY_TUPLE_SOURCE  |PARTITIONED|
                                              exchange
                                              -- BROADCAST_EXCHANGE  |PARTITIONED|
                                                limit 1
                                                -- STREAM_LIMIT  |UNPARTITIONED|
                                                  project ([$$139])
                                                  -- STREAM_PROJECT  |PARTITIONED|
                                                    exchange
                                                    -- SORT_MERGE_EXCHANGE [$$140(ASC) ]  |PARTITIONED|
                                                      limit 1
                                                      -- STREAM_LIMIT  |PARTITIONED|
                                                        exchange
                                                        -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                          order (topK: 1) (ASC, $$140)
                                                          -- STABLE_SORT [topK: 1] [$$140(ASC)]  |PARTITIONED|
                                                            exchange
                                                            -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                              assign [$$140] <- [vector-shuffle-key($$139, 42)]
