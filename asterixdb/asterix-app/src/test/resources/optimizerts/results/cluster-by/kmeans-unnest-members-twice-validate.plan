distribute result [$$131]
-- DISTRIBUTE_RESULT  |PARTITIONED|
  exchange
  -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
    assign [$$131] <- [{"cid": $#1, "size": $$138, "id": $$m.getField(0).getField(0)}] project: [$$131]
    -- ASSIGN  |PARTITIONED|
      unnest $$m <- scan-collection($$members) project: [$$138, $#1, $$m]
      -- UNNEST  |PARTITIONED|
        exchange
        -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
          group by ([$#1 := $$147]) decor ([]) {
                    aggregate [$$members, $$138] <- [listify($$119), agg-sql-count($$119)]
                    -- AGGREGATE  |LOCAL|
                      nested tuple source
                      -- NESTED_TUPLE_SOURCE  |LOCAL|
                 }
          -- PRE_CLUSTERED_GROUP_BY[$$147]  |PARTITIONED|
            exchange
