               }
        -- PRE_CLUSTERED_GROUP_BY[$$237, $#1]  |PARTITIONED|
          exchange
          -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
            order (ASC, $$237) (ASC, $#1)
            -- STABLE_SORT [$$237(ASC), $#1(ASC)]  |PARTITIONED|
