                                              data-scan []<-[$$240, $$m] <- clusterby_test.Items project ({main_category:any,title:any})
                                              -- DATASOURCE_SCAN  |PARTITIONED|
                                                exchange
                                                -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                  empty-tuple-source
