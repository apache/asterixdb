                                          -- KMEANS_RECLUSTER  |PARTITIONED|
                                            exchange
                                            -- BROADCAST_EXCHANGE  |PARTITIONED|
                                              kmeans-stage $$252 <- oversample-loop 5 rounds of $$251 vs seed $$249 (seed 42) by euclidean_squared
