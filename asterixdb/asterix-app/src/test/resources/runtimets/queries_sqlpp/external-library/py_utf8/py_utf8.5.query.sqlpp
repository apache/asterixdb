/*
 * Description  : A string header that overstates its payload does not corrupt only that string: everything packed
 *                after it in the same message is read at the wrong offset. Check the argument that follows one.
 * Expected Res : Success
 */

use externallibtest;

roundtrip2(codepoint_to_string([128512]), "tail")[1];
