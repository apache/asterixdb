-- The mixed-branch case. Six single-row files hold buckets 0..5; only bucket 3's file has a deletion vector, so five
-- of the six tasks take the no-deletes read path and one takes the delete-aware path, within one scan. Bucket 3 is
-- gone. Steps start at 030 to mirror the CBAS-side copy of this suite one-for-one.
SELECT id,
       variant_field.bucket AS bucket,
       variant_field.name AS name
FROM deletionVectorVariant
WHERE variant_field.bucket < 6
ORDER BY id;
