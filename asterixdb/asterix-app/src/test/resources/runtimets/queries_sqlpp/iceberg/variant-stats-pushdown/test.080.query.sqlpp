-- Nested sub-path: a 2-level variant path (obj.deep) as the filter, to confirm it resolves to the right
-- sub-field rather than the top-level one of the same name.
SELECT id,
       variant_field.bucket AS bucket,
       variant_field.name AS name
FROM manyFilesVariant
WHERE variant_field.obj.deep = 5
ORDER BY id;
