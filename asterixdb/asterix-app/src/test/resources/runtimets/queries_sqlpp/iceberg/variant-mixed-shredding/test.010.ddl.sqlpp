// mixedShreddingVariant: 6 single-row files that do NOT agree on which variant sub-fields are shredded. Buckets 0-2
// are fully shredded so each publishes a bound for "bucket"; buckets 3-5 shred only "name", so their "bucket" sits
// in the residual and those files publish NO bound for it. This is the shape schema evolution leaves behind when the
// shredding config changes under a table written over time.
DROP COLLECTION variantMixedShredding IF EXISTS;
DROP TYPE variantMixedShredding IF EXISTS;

CREATE TYPE variantMixedShredding AS open {};
CREATE EXTERNAL COLLECTION variantMixedShredding(variantMixedShredding)
USING S3
(
    ("table-format"="iceberg"),
    ("namespace"="my_namespace"),
    ("tableName"="mixedShreddingVariant"),
    ("region"="custom-region"),
    ("serviceEndpoint"="%DOCKER_S3_CONTAINER%"),
    ("pathStyleAddressing"="true"),
    ("catalogName"="myNessieCatalog"),
    ("format"="parquet")
);
