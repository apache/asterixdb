-- Step 030's predicate, checked by the number of objects read rather than the rows returned: each of
-- the 6 files holds one row, and the predicate is pushed exactly, so only the matching file is read.
-- Results alone cannot tell this apart from no pushdown at all.
SELECT VALUE z.id FROM tzCollt z WHERE z.t = time("09:00:00.123");
