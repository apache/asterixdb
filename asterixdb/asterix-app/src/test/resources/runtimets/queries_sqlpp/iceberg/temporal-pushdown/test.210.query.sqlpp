-- Variant timestamps are not pushed down, so this checks the value the engine compares: ids 6 and 9 both read
-- back as 23:59:59.999 in every variant timestamp kind.
SELECT e.id FROM temporalPrecision e
WHERE e.v.ts = datetime("1969-12-31T23:59:59.999Z") AND e.v.ntz = datetime("1969-12-31T23:59:59.999")
  AND e.v.tsn = datetime("1969-12-31T23:59:59.999Z") AND e.v.ntzn = datetime("1969-12-31T23:59:59.999")
ORDER BY e.id;
