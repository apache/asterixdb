// deletesVariant is manyFilesVariant's shredded per-bucket layout plus EQUALITY DELETES removing buckets 2 and 3.
// The only coverage of shredded variants together with deletes. Two things it pins down:
//   1. The deletes are committed after the appends, so they apply to every data file. Every scan task therefore
//      carries deletes and is read against DeleteFilter.requiredSchema(), the path where variant PROJECTION pushdown
//      is deliberately skipped — so these queries prove the fallback reconstructs sub-fields correctly.
//   2. Variant PREDICATE pushdown is still active, because file skipping happens during planning and ignores deletes
//      (sound, since deletes only remove rows). A query must both prune correctly and drop the deleted rows.
DROP COLLECTION deletesVariant IF EXISTS;
DROP TYPE deletesVariant IF EXISTS;

CREATE TYPE deletesVariant AS open {};
CREATE EXTERNAL COLLECTION deletesVariant(deletesVariant)
USING S3
(
    ("table-format"="iceberg"),
    ("namespace"="my_namespace"),
    ("tableName"="deletesVariant"),
    ("region"="custom-region"),
    ("serviceEndpoint"="%DOCKER_S3_CONTAINER%"),
    ("pathStyleAddressing"="true"),
    ("catalogName"="myNessieCatalog"),
    ("format"="parquet")
);
