-- the engine orders NaN above every number, while Iceberg never matches NaN in > or >= and leaves it out of the
-- upper bound, so a pushed "f > 1" alone would skip id 5, whose file holds only NaN.
SELECT n.id FROM numericPrecision n WHERE n.f > 1 ORDER BY n.id;
