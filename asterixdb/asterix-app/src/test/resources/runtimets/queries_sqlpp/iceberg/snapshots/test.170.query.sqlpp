-- param $ts:string=2030-01-01
// the value supplied as a query parameter. 2030-01-01 is past every snapshot, so it resolves to
// the latest one: ids 1-1000 less the deleted ids 10/20/30 => 997. A generated snapshot id
// cannot be used here because the harness extracts parameters before it substitutes the
// snapshot placeholders
SELECT count(*) AS count FROM usersNoSnapshot AT timestamp $ts;
