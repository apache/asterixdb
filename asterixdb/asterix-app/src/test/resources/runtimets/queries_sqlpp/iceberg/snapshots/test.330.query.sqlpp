// UNION ALL of the same collection at a snapshot and at latest: each branch is its own FROM term,
// built by the set-operation rewrite, so each keeps its own value. snapshot 1 contributes 800 rows
// (ids 1-800) and latest contributes 997 (ids 1-1000 less the deleted ids 10/20/30) => 1797
SELECT count(*) AS c
FROM (SELECT u.id FROM usersNoSnapshot AS u AT snapshot %SNAPSHOT_1_SNAPSHOT_ID%
      UNION ALL
      SELECT v.id FROM usersNoSnapshot AS v) AS t;
