-- The mirror image: bucket 1 lives in a fully shredded file whose bound matches, while the files with no bound for
-- "bucket" still have to be read.
SELECT id, variant_field.bucket AS bucket FROM variantMixedShredding WHERE variant_field.bucket = 1;
