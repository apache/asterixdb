// Binding rounds a pushed literal to a float or decimal column's type, while the engine compares against the
// literal as written. numericPrecision holds ONE ROW PER FILE, each sitting where a rounded literal lands on it, so a
// pushed predicate whose literal was rounded skips the file and drops the row.
DROP COLLECTION numericPrecision IF EXISTS;
DROP TYPE numericPrecision IF EXISTS;

CREATE TYPE numericPrecision AS open {};
CREATE EXTERNAL COLLECTION numericPrecision(numericPrecision)
USING S3
(
    ("table-format"="iceberg"),
    ("namespace"="my_namespace"),
    ("tableName"="numericPrecision"),
    ("region"="custom-region"),
    ("serviceEndpoint"="%DOCKER_S3_CONTAINER%"),
    ("pathStyleAddressing"="true"),
    ("catalogName"="myNessieCatalog"),
    ("format"="parquet"),
    ("decimal-to-double"="true")
);
