-- A bucket value no file contains: every file's bounds exclude it, so nothing matches and (with pushdown) no
-- data file needs to be opened at all.
SELECT id,
       variant_field.bucket AS bucket,
       variant_field.name AS name
FROM manyFilesVariant
WHERE variant_field.bucket = 999999
ORDER BY id;
