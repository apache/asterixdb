// Analytics reads an Iceberg timestamp through ADateTime, which holds MILLISECONDS, while the column is
// microseconds. The predicate pushed into Iceberg is evaluated against the untruncated value in the manifest,
// row-group statistics and delete-file bounds, so it must cover the whole millisecond the literal names or Iceberg
// discards a file holding a row the engine would have matched.
//
// temporalPrecision holds ONE ROW PER FILE, so every row is its own file's minimum — the shape where an
// un-widened predicate drops it. temporalEqDelete adds an equality delete, where the same mistake makes a DELETED
// row reappear instead.
DROP COLLECTION temporalPrecision IF EXISTS;
DROP TYPE temporalPrecision IF EXISTS;

CREATE TYPE temporalPrecision AS open {};
CREATE EXTERNAL COLLECTION temporalPrecision(temporalPrecision)
USING S3
(
    ("table-format"="iceberg"),
    ("namespace"="my_namespace"),
    ("tableName"="temporalPrecision"),
    ("region"="custom-region"),
    ("serviceEndpoint"="%DOCKER_S3_CONTAINER%"),
    ("pathStyleAddressing"="true"),
    ("catalogName"="myNessieCatalog"),
    ("format"="parquet")
);

DROP COLLECTION temporalEqDelete IF EXISTS;
DROP TYPE temporalEqDelete IF EXISTS;

CREATE TYPE temporalEqDelete AS open {};
CREATE EXTERNAL COLLECTION temporalEqDelete(temporalEqDelete)
USING S3
(
    ("table-format"="iceberg"),
    ("namespace"="my_namespace"),
    ("tableName"="temporalEqDelete"),
    ("region"="custom-region"),
    ("serviceEndpoint"="%DOCKER_S3_CONTAINER%"),
    ("pathStyleAddressing"="true"),
    ("catalogName"="myNessieCatalog"),
    ("format"="parquet")
);
