-- Every read path at once, for the rows around the epoch: micro- and nanosecond columns with and without a
-- zone, and the same four inside a variant. Each value is the millisecond that CONTAINS the stored instant, so
-- id 6 (-500us) is 23:59:59.999 and id 8 (-1876544us) is 23:59:58.123, never one millisecond later.
SELECT e.id, e.ts, e.tsn, e.tsnz, e.tsnn, e.v.ts AS vts, e.v.ntz AS vntz, e.v.tsn AS vtsn, e.v.ntzn AS vntzn
FROM temporalPrecision e WHERE e.id >= 5 ORDER BY e.id;
