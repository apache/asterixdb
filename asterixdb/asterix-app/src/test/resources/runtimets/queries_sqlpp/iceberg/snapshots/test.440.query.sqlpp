// a clock must name the current instant, not the wall time in the server's zone: T1 is a true epoch instant
// taken after snapshot 1, so a correct clock is later than T1 by less than the window and the CASE picks T1,
// which selects snapshot 1 => 800. A clock off by its zone's UTC offset falls outside the window and reads
// the latest snapshot instead => 997
SELECT count(*) AS count
FROM usersNoSnapshot AT timestamp
  CASE WHEN current_datetime_immediate() >= datetime_from_unix_time_in_ms(%SNAPSHOT_1_TIMESTAMP_LONG_PLACEHOLDER%)
        AND current_datetime_immediate() < datetime_from_unix_time_in_ms(%SNAPSHOT_1_TIMESTAMP_LONG_PLACEHOLDER%)
            + duration("PT2H")
       THEN datetime_from_unix_time_in_ms(%SNAPSHOT_1_TIMESTAMP_LONG_PLACEHOLDER%)
       ELSE current_datetime_immediate() END;
