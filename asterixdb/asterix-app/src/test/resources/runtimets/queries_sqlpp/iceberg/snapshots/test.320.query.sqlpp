// a window function over a snapshotted scan: the window rewrite restructures the select block
// above the FROM term. row_number() numbers the snapshot's own rows, so the highest is snapshot
// 1's cardinality -- ids 1-800 => 800, where the latest snapshot would reach 997
SELECT max(t.rn) AS maxRn
FROM (SELECT row_number() OVER (ORDER BY u.id) AS rn
      FROM usersNoSnapshot AS u AT snapshot %SNAPSHOT_1_SNAPSHOT_ID%) AS t;
