// Does a variant sub-field whose NAME contains a dot get confused with nesting?
//
// This table's variant holds a field literally named "a.b" (= 5) and, separately, a nested a -> b (= 99). A filter's
// reference name is built by joining the field-access path with dots, so both spellings arrive as the same string
// "variant_field.a.b". If that is read as nesting, the predicate prunes against the nested path's bounds -- which
// cannot contain 5 -- and the table's only data file is skipped, returning nothing.
DROP COLLECTION variantDottedFieldName IF EXISTS;
DROP TYPE variantDottedFieldName IF EXISTS;

CREATE TYPE variantDottedFieldName AS open {};
CREATE EXTERNAL COLLECTION variantDottedFieldName(variantDottedFieldName)
USING S3
(
    ("table-format"="iceberg"),
    ("namespace"="my_namespace"),
    ("tableName"="dottedFieldNameVariant"),
    ("region"="custom-region"),
    ("serviceEndpoint"="%DOCKER_S3_CONTAINER%"),
    ("pathStyleAddressing"="true"),
    ("catalogName"="myNessieCatalog"),
    ("format"="parquet")
);
