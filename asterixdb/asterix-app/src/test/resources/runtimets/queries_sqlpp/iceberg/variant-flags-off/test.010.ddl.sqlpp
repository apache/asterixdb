// The same shreddedVariant table as the variant-shredded suite, read with BOTH pushdown flags disabled.
//
// This is the break-glass guarantee: if either optimization has to be turned off in the field, Iceberg VARIANT data
// must still be fully readable — every physical type, serialized and fully shredded rows alike. The expected files here
// are copied verbatim from variant-shredded's, so any divergence between the optimized and unoptimized read fails.
DROP COLLECTION shreddedVariantNoPushdown IF EXISTS;
DROP TYPE shreddedVariantNoPushdown IF EXISTS;

CREATE TYPE shreddedVariantNoPushdown AS open {};
CREATE EXTERNAL COLLECTION shreddedVariantNoPushdown(shreddedVariantNoPushdown)
USING S3
(
    ("table-format"="iceberg"),
    ("namespace"="my_namespace"),
    ("tableName"="shreddedVariant"),
    ("region"="custom-region"),
    ("serviceEndpoint"="%DOCKER_S3_CONTAINER%"),
    ("pathStyleAddressing"="true"),
    ("catalogName"="myNessieCatalog"),
    ("format"="parquet"),
    ("decimal-to-double"="true"),
    ("variantProjectionPushdown"="false"),
    ("variantStatsPushdown"="false")
);
