// partitionedVariant is the only PARTITIONED table with a shredded VARIANT: buckets 0..11, one row per file, grouped
// three consecutive buckets to a partition (grp = g0..g3). Every other variant fixture is unpartitioned, so partition
// pruning and variant sub-field pruning have never been exercised on the same scan.
//
// The three steps prune by different amounts so the mechanisms can be told apart: grp alone leaves one partition,
// a variant sub-field alone leaves one file across all partitions, and both together still leave one.
DROP COLLECTION partitionedVariant IF EXISTS;
DROP TYPE partitionedVariant IF EXISTS;

CREATE TYPE partitionedVariant AS open {};
CREATE EXTERNAL COLLECTION partitionedVariant(partitionedVariant)
USING S3
(
    ("table-format"="iceberg"),
    ("namespace"="my_namespace"),
    ("tableName"="partitionedVariant"),
    ("region"="custom-region"),
    ("serviceEndpoint"="%DOCKER_S3_CONTAINER%"),
    ("pathStyleAddressing"="true"),
    ("catalogName"="myNessieCatalog"),
    ("format"="parquet")
);
