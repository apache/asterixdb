-- The delete file carries bounds and is pruned by the same predicate. With an un-widened literal it is
-- discarded, the delete never applies, and deleted id 2 REAPPEARS — a filter making more rows show up.
SELECT e.id FROM temporalEqDelete e WHERE e.ts = datetime("2026-03-15T09:00:00.123Z") ORDER BY e.id;
