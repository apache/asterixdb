-- Row-group SKIPPING. The predicate is on the real id column, so it binds against the Iceberg schema and reaches the
-- metrics row-group filter, letting groups outside the range be skipped instead of decoded. (A shredded variant
-- sub-field cannot do this: iceberg-parquet has no extract-term support in its row-group filters.) The answer must be
-- the last ten rows regardless of where the row-group boundaries happen to fall.
SELECT COUNT(*) AS cnt,
       SUM(variant_field.bucket) AS total
FROM manyRowGroupsVariant
WHERE id > 4990;
