// noSchemaId's snapshots record no schema-id, which the Iceberg spec makes optional, and the table evolved after
// its first snapshot. Iceberg plans such a snapshot with the table's current schema, so it must be readable rather
// than fail the query while the snapshot is pinned.
DROP COLLECTION noSchemaId IF EXISTS;
DROP TYPE noSchemaId IF EXISTS;

CREATE TYPE noSchemaId AS open {};
CREATE EXTERNAL COLLECTION noSchemaId(noSchemaId)
USING S3
(
    ("table-format"="iceberg"),
    ("namespace"="my_namespace"),
    ("tableName"="noSchemaId"),
    ("region"="custom-region"),
    ("serviceEndpoint"="%DOCKER_S3_CONTAINER%"),
    ("pathStyleAddressing"="true"),
    ("catalogName"="myNessieCatalog"),
    ("format"="parquet")
);
