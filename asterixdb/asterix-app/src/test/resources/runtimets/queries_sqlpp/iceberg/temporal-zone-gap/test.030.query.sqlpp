-- A spring-forward gap: 02:30 local on 8 Mar 2026 does not exist in this zone, so no stored instant reads back as
-- it and the correct answer is no rows. The rewrite gives the predicate up here too, which costs nothing: the
-- engine matches nothing either way.
SELECT VALUE z.id FROM tzCollgap z WHERE z.tsz = datetime("2026-03-08T02:30:00.123") ORDER BY z.id;
