// A non-boolean pushdown flag must be rejected at DDL time. Boolean.parseBoolean maps anything it does not
// recognise to false, so without this validation the typo below would silently DISABLE the optimization: the
// collection would be created, queries would return correct rows, and the only symptom would be reading more than
// necessary.
DROP COLLECTION variantFlagInvalid IF EXISTS;
DROP TYPE variantFlagInvalid IF EXISTS;

CREATE TYPE variantFlagInvalid AS open {};
CREATE EXTERNAL COLLECTION variantFlagInvalid(variantFlagInvalid)
USING S3
(
    ("table-format"="iceberg"),
    ("namespace"="my_namespace"),
    ("tableName"="allTypesVariant"),
    ("region"="custom-region"),
    ("serviceEndpoint"="%DOCKER_S3_CONTAINER%"),
    ("pathStyleAddressing"="true"),
    ("catalogName"="myNessieCatalog"),
    ("format"="parquet"),
    ("variantProjectionPushdown"="ture")
);
