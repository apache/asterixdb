// requesttype=application/json

// a plan whose time travel value read a clock is not cached: a cached plan would keep reading the first run's
// clock. Run twice; neither run may be served from the plan cache
SELECT count(*) AS count FROM usersNoSnapshot AT timestamp current_datetime_immediate();
