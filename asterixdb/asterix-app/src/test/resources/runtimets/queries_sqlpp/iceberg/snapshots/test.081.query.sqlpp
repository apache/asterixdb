-- Nothing may be MISSING: the column exists in the table schema, so it is materialised for every row including those
-- from files written before it was added. If this ever returns a non-zero count, an evolved column is being dropped
-- from the record instead of nulled, and "IS NULL" would stop finding those rows.
SELECT COUNT(*) AS stillMissing FROM usersNoSnapshot WHERE evolved_note IS MISSING;
