-- The partial-delete case, which equality deletes on single-row files cannot express: buckets 100..102 share one data
-- file and a deletion vector removes only position 1 (bucket 101). The delete-aware read must return the other two
-- rows with their variant sub-fields intact, including the nested obj.deep, through the _pos-widened read.
SELECT id,
       variant_field.bucket AS bucket,
       variant_field.obj.deep AS deep
FROM deletionVectorVariant
WHERE variant_field.bucket >= 100
ORDER BY id;
