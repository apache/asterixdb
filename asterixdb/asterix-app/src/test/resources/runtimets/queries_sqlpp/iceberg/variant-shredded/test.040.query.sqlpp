-- A shredded decimal with more digits than a double holds must not lose its file to pruning. The engine reads
-- decimal16Value as its double, 1.2345678901234568E20, which equals this literal, so both copies of the row match.
-- The fully shredded copy (id=7) is the one whose manifest carries a bound for decimal16Value; comparing that bound
-- with the literal exactly would call it unmatchable and drop id=7, leaving only the serialized copy (id=1).
SELECT VALUE id
FROM shreddedVariant
WHERE variant_field.decimal16Value = 123456789012345678901.123456789
ORDER BY id;
