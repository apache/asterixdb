-- Pruning and deletes must compose: the predicate keeps the six files holding buckets 0..5, and the deletes remove
-- buckets 2 and 3, leaving four rows. Steps start at 030 to mirror the CBAS-side copy of this suite one-for-one.
SELECT id,
       variant_field.bucket AS bucket,
       variant_field.name AS name
FROM deletesVariant
WHERE variant_field.bucket < 6
ORDER BY id;
