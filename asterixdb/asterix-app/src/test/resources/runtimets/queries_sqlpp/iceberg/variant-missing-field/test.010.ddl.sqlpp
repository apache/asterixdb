// missingFieldVariant: a serialized file (ids 1-4) and three shredded files that type different subsets of the
// variant's fields: a,b (ids 11-13), c (ids 21-24) and a,c,d (ids 31-33). "tags" is never typed. A field a file does
// not type, absent from a row's residual, must read MISSING, exactly as it does from the serialized file.
DROP COLLECTION variantMissingField IF EXISTS;
DROP TYPE variantMissingField IF EXISTS;

CREATE TYPE variantMissingField AS open {};
CREATE EXTERNAL COLLECTION variantMissingField(variantMissingField)
USING S3
(
    ("table-format"="iceberg"),
    ("namespace"="my_namespace"),
    ("tableName"="missingFieldVariant"),
    ("region"="custom-region"),
    ("serviceEndpoint"="%DOCKER_S3_CONTAINER%"),
    ("pathStyleAddressing"="true"),
    ("catalogName"="myNessieCatalog"),
    ("format"="parquet")
);
