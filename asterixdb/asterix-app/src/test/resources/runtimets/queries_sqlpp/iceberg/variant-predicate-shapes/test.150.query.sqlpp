-- PREDICATES on a nested path whose root column does not exist. The reference is dotted, but its root is not a variant,
-- so the variant stripping leaves it alone and it reaches the bind rehearsal — the other way into the fail-safe.
-- param max-warnings:json=100
SELECT id
FROM variantPredicateShapes
WHERE nosuchroot.deep = 1
ORDER BY id;
