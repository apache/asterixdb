// a JOIN clause carries its own snapshot. The left side reads latest (ids 1-1000 less the
// deleted ids 10/20/30) and the right side snapshot 1 (ids 1-800), so the ids present in both
// are 1-800 less 10/20/30 => 797
SELECT count(*) AS count
FROM usersNoSnapshot AS a
JOIN usersNoSnapshot AS b AT snapshot %SNAPSHOT_1_SNAPSHOT_ID% ON a.id = b.id;
