-- The epoch millisecond is DOUBLE WIDTH: truncation runs toward zero, so +456us (id 5) and -500us (id 6)
-- both read back as 1970-01-01T00:00:00.000.
SELECT e.id FROM temporalPrecision e WHERE e.ts = datetime("1970-01-01T00:00:00.000Z") ORDER BY e.id;
