-- Control: the runtime's own verdict, as a projection, so nothing is pushed. Row 6 displays 01:59:59.999 on the
-- morning the clocks go forward.
SELECT VALUE z.id FROM tzCollBoundary z WHERE z.id = 6 AND z.tsz = datetime("2026-03-08T01:59:59.999");
