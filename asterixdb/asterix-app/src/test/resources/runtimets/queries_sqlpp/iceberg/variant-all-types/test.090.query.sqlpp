-- Predicates on a TEMPORAL and a DECIMAL sub-field. Both are hazards rather than ordinary cases: a date/time arrives
-- in the manifest bound as a bare epoch number and would compare "successfully" against a numeric literal, so the
-- bounds evaluator refuses those physical types; a decimal literal has no extract type to map to, so the rewrite
-- declines it. Either way the answer must be right.
SELECT id
FROM allTypesVariant
WHERE variant_field.dateValue = date("2024-01-01") OR variant_field.decimal4Value = 3.14
ORDER BY id;
