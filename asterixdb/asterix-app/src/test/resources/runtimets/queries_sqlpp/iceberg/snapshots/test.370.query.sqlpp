// a clock value: the clock is read while the query is compiled, which is after every snapshot of the
// fixture was committed, so the latest snapshot is read => 997 (ids 1-1000 less the deleted 10/20/30);
// snapshot 1 would give 800 and snapshot 2 1000
SELECT count(*) AS count
FROM usersNoSnapshot AT timestamp current_datetime_immediate();
