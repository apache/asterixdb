-- Project shredded typed sub-columns, including a 2-level nested path (objectValue.nestedString), so they come
-- back as addressable, correctly typed fields. Restricted to the two all-types rows (serialized id=1, fully
-- shredded id=7) via the real id column — a variant sub-field can't be used in a pushed-down predicate, but
-- projecting one (at any depth) is fine. Both copies must yield identical projected values.
SELECT id,
       variant_field.int32Value AS i,
       variant_field.stringValue AS s,
       variant_field.objectValue.nestedString AS nested
FROM shreddedVariant
WHERE id = 1 OR id = 7
ORDER BY id;
