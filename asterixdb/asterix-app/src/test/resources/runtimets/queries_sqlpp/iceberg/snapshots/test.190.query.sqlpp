// arithmetic on the snapshot id itself: adding zero must fold back to the same id, so this stays
// on snapshot 1 -- ids 1-800 => 800 rather than the latest 997
SELECT count(*) AS count FROM usersNoSnapshot AT snapshot %SNAPSHOT_1_SNAPSHOT_ID% + 0;
