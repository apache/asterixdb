// three FROM terms, a different value on each, so the result has to discriminate all three:
// a reads snapshot 1 (ids 1-800), b snapshot 2 (ids 1-1000), and c latest (ids 1-1000 less the
// deleted ids 10/20/30). The ids present in all three are 1-800 less 10/20/30 => 797
SELECT count(*) AS c
FROM usersNoSnapshot AS a AT snapshot %SNAPSHOT_1_SNAPSHOT_ID%
JOIN usersNoSnapshot AS b AT timestamp "%SNAPSHOT_2_TIMESTAMP_DATETIME_PLACEHOLDER%" ON a.id = b.id
JOIN usersNoSnapshot AS c ON b.id = c.id;
