-- The decisive case for tsnz: the same comparison in a top-level WHERE, where it is pushed into
-- Iceberg and compared against the UNSHIFTED stored bounds. Expected result is the CORRECT
-- answer -- the control says row 1 matches, so row 1 must come back.
SELECT VALUE z.id FROM tzColltsnz z WHERE z.tsnz = datetime("2026-03-15T02:00:00.123");
