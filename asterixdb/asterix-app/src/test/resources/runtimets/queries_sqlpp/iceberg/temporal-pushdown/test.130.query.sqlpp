-- FLIPPED operand: literal on the LEFT. handleComparison must swap the column to the left AND read the type
-- tag from the left operand; a mistake in either makes the widening silently miss. Same rows as test.030.
SELECT e.id FROM temporalPrecision e WHERE datetime("2026-03-15T09:00:00.123Z") = e.ts ORDER BY e.id;
