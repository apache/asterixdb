-- Step 030's predicate with stats pushdown disabled. The rows must be identical; only the number of data files read
-- differs, which this harness cannot observe (the CBAS-side copy asserts it via processedObjects).
SELECT id,
       variant_field.bucket AS bucket,
       variant_field.name AS name
FROM manyFilesVariantNoPushdown
WHERE variant_field.bucket = 5
ORDER BY id;
