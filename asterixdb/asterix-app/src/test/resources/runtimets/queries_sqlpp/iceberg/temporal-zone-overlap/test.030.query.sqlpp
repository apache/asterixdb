-- A daylight-saving fall-back: 01:30 local on 1 Nov 2026 happens twice, so rows 4 (PDT) and 5 (PST) both read
-- back as this reading and both must be returned. The display-to-stored mapping is not invertible here, so the
-- rewrite gives the predicate up and lets the engine filter -- correct, and pruning is what is sacrificed.
SELECT VALUE z.id FROM tzColloverlap z WHERE z.tsz = datetime("2026-11-01T01:30:00.123") ORDER BY z.id;
