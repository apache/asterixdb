// date arithmetic: the date is the day after the last commit, and subtracting a zero duration
// must not shift it, so this resolves to the latest snapshot -- ids 1-1000 less the deleted ids
// 10/20/30 => 997, overriding the collection's own snapshot 1 (800)
SELECT count(*) as count
FROM usersYesSnapshot AT timestamp date("%SNAPSHOT_3_TIMESTAMP_DATE_PLACEHOLDER%") - duration("P0D");
