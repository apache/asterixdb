// twoVariants has TWO independent shredded VARIANT columns with different shapes: v1 (bucket/name/ratio/flag/obj.deep)
// and v2 (code/score). VariantProjectionPlan is keyed by column and the rewriter resolves each predicate's root
// column, so both should be handled independently — but every other fixture has exactly one variant column.
//
// Row i carries v1.bucket = i and v2.score = i*2, so the two columns can never be confused for one another.
DROP COLLECTION twoVariants IF EXISTS;
DROP TYPE twoVariants IF EXISTS;

CREATE TYPE twoVariants AS open {};
CREATE EXTERNAL COLLECTION twoVariants(twoVariants)
USING S3
(
    ("table-format"="iceberg"),
    ("namespace"="my_namespace"),
    ("tableName"="twoVariants"),
    ("region"="custom-region"),
    ("serviceEndpoint"="%DOCKER_S3_CONTAINER%"),
    ("pathStyleAddressing"="true"),
    ("catalogName"="myNessieCatalog"),
    ("format"="parquet")
);
