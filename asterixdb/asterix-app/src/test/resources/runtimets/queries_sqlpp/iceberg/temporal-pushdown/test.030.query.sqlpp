-- Ids 1, 2 and 3 are .123456 / .123000 / .123999 in three separate files. All three read back as .123, so
-- all three must match. Returning only id 2 means the literal is being compared against raw microseconds.
SELECT e.id FROM temporalPrecision e WHERE e.ts = datetime("2026-03-15T09:00:00.123Z") ORDER BY e.id;
