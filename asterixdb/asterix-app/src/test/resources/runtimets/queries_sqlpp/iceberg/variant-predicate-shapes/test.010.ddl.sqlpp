// A matrix of predicate SHAPES over a shredded VARIANT sub-field, on the same manyFilesVariant table the
// variant-stats-pushdown suite prunes (bucket=i, name="f"+i, ratio=i*1.5, flag=(i%2==0), obj.deep=i, id=i+1).
//
// The point is NOT pruning — most of these cannot be pushed down at all. It is that none of them CRASH. A dotted
// reference into a variant cannot be bound by Iceberg, so any shape the rewriter declines has to be stripped from the
// pushed filter; get that wrong and the query fails with "Cannot find field" instead of merely reading more files.
// Every step here asserts the answer is still correct, whether the predicate was pushed, weakened, or dropped.
DROP COLLECTION variantPredicateShapes IF EXISTS;
DROP TYPE variantPredicateShapes IF EXISTS;

CREATE TYPE variantPredicateShapes AS open {};
CREATE EXTERNAL COLLECTION variantPredicateShapes(variantPredicateShapes)
USING S3
(
    ("table-format"="iceberg"),
    ("namespace"="my_namespace"),
    ("tableName"="manyFilesVariant"),
    ("region"="custom-region"),
    ("serviceEndpoint"="%DOCKER_S3_CONTAINER%"),
    ("pathStyleAddressing"="true"),
    ("catalogName"="myNessieCatalog"),
    ("format"="parquet")
);
