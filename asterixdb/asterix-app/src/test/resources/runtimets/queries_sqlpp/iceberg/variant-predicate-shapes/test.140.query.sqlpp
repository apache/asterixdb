-- SELECTS a field the Iceberg table does not have, alongside a normal pushable predicate. The projection asks for a
-- column that is not in the schema, which must not disturb the scan; the absent field simply comes back MISSING and is
-- omitted from the record. No filter is unbindable here, so this must NOT warn.
SELECT id, nosuchfield AS absent
FROM variantPredicateShapes
WHERE variant_field.bucket = 5
ORDER BY id;
