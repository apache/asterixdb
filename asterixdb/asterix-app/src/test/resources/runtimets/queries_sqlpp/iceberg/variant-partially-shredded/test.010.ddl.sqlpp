// The partiallyShreddedVariant table holds two rows carrying the SAME logical variant object (covering every
// supported Variant PhysicalType): one row written serialized, one row written PARTIALLY shredded (a subset of
// fields promoted to typed sub-columns, the rest kept in the object-level residual value). Reading the collection
// exercises the typed_value + residual merge — the path Iceberg 1.10.x corrupted and 1.11.0 fixed (issue #15086 /
// PR #15087) — and proves the read pipeline reconstructs identical values regardless of encoding. Full shredding is
// covered separately by variant-shredded. decimal-to-double is required for the DECIMAL4/8/16 values.
DROP COLLECTION partiallyShreddedVariant IF EXISTS;
DROP TYPE partiallyShreddedVariant IF EXISTS;

CREATE TYPE partiallyShreddedVariant AS open {};
CREATE EXTERNAL COLLECTION partiallyShreddedVariant(partiallyShreddedVariant)
USING S3
(
    ("table-format"="iceberg"),
    ("namespace"="my_namespace"),
    ("tableName"="partiallyShreddedVariant"),
    ("region"="custom-region"),
    ("serviceEndpoint"="%DOCKER_S3_CONTAINER%"),
    ("pathStyleAddressing"="true"),
    ("catalogName"="myNessieCatalog"),
    ("format"="parquet"),
    ("decimal-to-double"="true")
);
