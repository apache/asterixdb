// Both read fallbacks off: delete files loaded per data file, and every file opened by asking storage for its length
// rather than trusting the manifest. This is the read as it was before either optimization, and must agree too.
DROP COLLECTION deletesOldPath IF EXISTS;
DROP TYPE deletesOldPath IF EXISTS;
CREATE TYPE deletesOldPath AS open {};
CREATE EXTERNAL COLLECTION deletesOldPath(deletesOldPath)
USING S3
(
    ("table-format"="iceberg"),
    ("namespace"="my_namespace"),
    ("tableName"="deletesVariant"),
    ("region"="custom-region"),
    ("serviceEndpoint"="%DOCKER_S3_CONTAINER%"),
    ("pathStyleAddressing"="true"),
    ("catalogName"="myNessieCatalog"),
    ("format"="parquet"),
    ("useDeleteCache"="false"),
    ("useManifestFileSizes"="false")
);
