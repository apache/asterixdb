-- Deliberately does NOT project id, the equality-delete key. DeleteFilter.requiredSchema() must therefore widen the
-- read beyond what the query asked for, and the extra column must be dropped again before the results are returned.
-- Projects a nested sub-field (obj.deep) and a DOUBLE one to prove multi-level variant reconstruction survives that
-- widened read. Buckets 0..3 pass the predicate; 2 and 3 are deleted.
SELECT variant_field.obj.deep AS deep,
       variant_field.ratio AS ratio
FROM deletesVariant
WHERE variant_field.bucket < 4
ORDER BY deep;
