// a time travelling scan inside a subquery: the value belongs to the inner FROM term, so the
// outer count still sees only snapshot 1's ids 1-800 => 800, not the latest 997
SELECT count(*) AS count
FROM (SELECT VALUE u FROM usersNoSnapshot AS u AT snapshot %SNAPSHOT_1_SNAPSHOT_ID%) AS t;
