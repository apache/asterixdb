// a snapshotted JOIN that precedes a RIGHT OUTER JOIN: the rewrite rebuilds the preceding
// clause, and its snapshot has to survive that rebuild. a and c read usersYesSnapshot, pinned to
// snapshot 1 (ids 1-800), and b is aimed at snapshot 1 too, so all 800 ids match => 800. Had the
// rebuild dropped b's snapshot, b would read latest, lose 10/20/30, and give 797
SELECT count(b.id) AS matched
FROM usersYesSnapshot AS a
JOIN usersNoSnapshot AS b AT snapshot %SNAPSHOT_1_SNAPSHOT_ID% ON a.id = b.id
RIGHT OUTER JOIN usersYesSnapshot AS c ON b.id = c.id;
