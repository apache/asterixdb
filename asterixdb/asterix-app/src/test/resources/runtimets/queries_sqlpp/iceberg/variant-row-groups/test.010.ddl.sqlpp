// manyRowGroupsVariant is a SINGLE data file holding 5000 rows, written with a tiny Parquet row-group size so it
// contains many row groups. Every other variant fixture writes one row group per file, which means the reader's
// row-group loop never iterates and its skipping decisions are never taken. The fixture asserts on write that more
// than one row group was actually produced, so this suite cannot silently degrade into the single-group case.
//
// Row i carries bucket=i (0..4999) and id=i+1, so aggregates over the whole file have exact closed-form answers and
// a single dropped or repeated row at a row-group boundary changes them.
DROP COLLECTION manyRowGroupsVariant IF EXISTS;
DROP TYPE manyRowGroupsVariant IF EXISTS;

CREATE TYPE manyRowGroupsVariant AS open {};
CREATE EXTERNAL COLLECTION manyRowGroupsVariant(manyRowGroupsVariant)
USING S3
(
    ("table-format"="iceberg"),
    ("namespace"="my_namespace"),
    ("tableName"="manyRowGroupsVariant"),
    ("region"="custom-region"),
    ("serviceEndpoint"="%DOCKER_S3_CONTAINER%"),
    ("pathStyleAddressing"="true"),
    ("catalogName"="myNessieCatalog"),
    ("format"="parquet")
);
