// RIGHT OUTER JOIN with a snapshot on *both* sides: the rewrite swaps the join inputs, so both
// values have to survive the swap. Counting the LEFT id is what discriminates -- the join keeps
// all 800 right rows either way, but a.id is null wherever the left side lacks that id. Both
// sides read snapshot 1 (ids 1-800), so every row matches => 800; had the left snapshot been
// dropped, the left side would read latest, lose 10/20/30, and give 797
SELECT count(a.id) AS matched
FROM usersNoSnapshot AS a AT snapshot %SNAPSHOT_1_SNAPSHOT_ID%
RIGHT OUTER JOIN usersNoSnapshot AS b AT snapshot %SNAPSHOT_1_SNAPSHOT_ID% ON a.id = b.id;
