-- the double 0.1 rounds to the float 0.1f, so a pushed "f > 0.1f" would skip id 1, which the engine widens to
-- 0.10000000149011612 > 0.1.
SELECT n.id FROM numericPrecision n WHERE n.f > 0.1 ORDER BY n.id;
