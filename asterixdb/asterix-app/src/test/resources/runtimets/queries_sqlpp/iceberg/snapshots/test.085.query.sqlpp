// a bare integer snapshot id: the value is an expression now, not only a string literal.
// snapshot 1 holds ids 1-800, so pointing this latest-reading collection at it gives 800
// rather than the 997 it returns on its own
SELECT count(*) as count
FROM usersNoSnapshot AT snapshot %SNAPSHOT_1_SNAPSHOT_ID%;
