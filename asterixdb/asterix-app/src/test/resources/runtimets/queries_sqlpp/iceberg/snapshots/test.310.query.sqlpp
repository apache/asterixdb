// GROUP BY above a snapshotted JOIN: the group-by sugar rewrite clones the FROM clause, so the
// JOIN's snapshot has to survive that clone. The left side reads latest (ids 1-1000 less the
// deleted ids 10/20/30) and the right side snapshot 1 (ids 1-800), so 797 ids match: 397 at or
// below 400 (400 less the deleted 10/20/30) and 400 above it. Had the clone dropped the snapshot,
// the right side would read latest too and the false group would be 600 instead of 400
SELECT lo, count(*) AS c
FROM usersNoSnapshot AS a
JOIN usersNoSnapshot AS b AT snapshot %SNAPSHOT_1_SNAPSHOT_ID% ON a.id = b.id
GROUP BY a.id <= 400 AS lo
ORDER BY lo;
