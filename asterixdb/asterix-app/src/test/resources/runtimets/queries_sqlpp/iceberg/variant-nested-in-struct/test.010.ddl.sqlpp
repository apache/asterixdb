// nestedVariantInStruct holds a VARIANT nested inside a struct (st.v) next to an ordinary string sibling (st.label).
//
// Iceberg cannot resolve a name through a variant at any depth, so neither st.v nor st.v.bucket can be bound and a
// predicate on the nested variant can never be pushed down. The point of this suite is that such a query still WORKS:
// the values are read and reconstructed and the engine applies the predicate to the rows. Step 040 is the control — a
// predicate on the ordinary sibling must still push down, so a variant inside a struct does not poison pruning for the
// whole struct.
DROP COLLECTION nestedVariantInStruct IF EXISTS;
DROP TYPE nestedVariantInStruct IF EXISTS;

CREATE TYPE nestedVariantInStruct AS open {};
CREATE EXTERNAL COLLECTION nestedVariantInStruct(nestedVariantInStruct)
USING S3
(
    ("table-format"="iceberg"),
    ("namespace"="my_namespace"),
    ("tableName"="nestedVariantInStruct"),
    ("region"="custom-region"),
    ("serviceEndpoint"="%DOCKER_S3_CONTAINER%"),
    ("pathStyleAddressing"="true"),
    ("catalogName"="myNessieCatalog"),
    ("format"="parquet")
);
