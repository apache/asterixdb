-- The decisive case for tsz-long: the same comparison pushed into Iceberg. The value is already in the
-- stored frame, so shifting the literal by the zone offset would prune row 1's file. The control says
-- row 1 matches, so row 1 must come back.
SELECT VALUE z.id FROM tzColltszl z WHERE z.tsz = 1773565200123456;
