// a datetime at millisecond precision names the same instant as the epoch value it came from: T1 as a
// datetime selects snapshot 1, as test.050 does with T1 as milliseconds => 800
SELECT count(*) AS count
FROM usersNoSnapshot AT timestamp datetime_from_unix_time_in_ms(%SNAPSHOT_1_TIMESTAMP_LONG_PLACEHOLDER%);
