-- A FLOAT compared with an integer: the engine compares in float precision, where 16777217 reads as 16777216, so
-- id 1 matches. Comparing the file's bound with the literal as doubles would call the file unmatchable.
SELECT VALUE id
FROM floatNanVariant
WHERE variant_field.f = 16777217
ORDER BY id;
