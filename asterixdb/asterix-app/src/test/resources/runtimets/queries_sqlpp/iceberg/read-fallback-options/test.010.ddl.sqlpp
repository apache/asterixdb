// The deletesVariant table of variant-deletes, read with useDeleteCache off: each reader loads the equality deletes
// of every data file itself instead of sharing them, which is the fallback the option exists for. The queries and
// their expected results are variant-deletes' own, so turning the cache off must change nothing.
DROP COLLECTION deletesNoCache IF EXISTS;
DROP TYPE deletesNoCache IF EXISTS;
CREATE TYPE deletesNoCache AS open {};
CREATE EXTERNAL COLLECTION deletesNoCache(deletesNoCache)
USING S3
(
    ("table-format"="iceberg"),
    ("namespace"="my_namespace"),
    ("tableName"="deletesVariant"),
    ("region"="custom-region"),
    ("serviceEndpoint"="%DOCKER_S3_CONTAINER%"),
    ("pathStyleAddressing"="true"),
    ("catalogName"="myNessieCatalog"),
    ("format"="parquet"),
    ("useDeleteCache"="false")
);
