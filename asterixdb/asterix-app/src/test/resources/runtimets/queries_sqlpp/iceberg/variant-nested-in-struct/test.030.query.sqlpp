-- Projects and filters on a sub-field of the NESTED variant, i.e. one that is not a top-level column.
-- The path's first segment is the struct, so the variant is found by walking prefixes (st, then st.v) and only what
-- follows it is treated as the variant sub-path. This DOES prune: the fixture shreds st.v, so its sub-fields carry
-- manifest bounds.
SELECT id,
       st.v.bucket AS bucket,
       st.label AS label
FROM nestedVariantInStruct
WHERE st.v.bucket < 2
ORDER BY id;
