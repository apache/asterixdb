// the same collection at two snapshots and at latest, in one statement: each subquery resolves
// its own value. snapshot 1 is ids 1-800 (800), snapshot 2 is ids 1-1000 (1000), and latest is
// ids 1-1000 less the deleted ids 10/20/30 (997)
SELECT (SELECT VALUE count(*) FROM usersNoSnapshot AT snapshot %SNAPSHOT_1_SNAPSHOT_ID%)[0] AS s1,
       (SELECT VALUE count(*) FROM usersNoSnapshot AT timestamp "%SNAPSHOT_2_TIMESTAMP_DATETIME_PLACEHOLDER%")[0] AS s2,
       (SELECT VALUE count(*) FROM usersNoSnapshot)[0] AS latest;
