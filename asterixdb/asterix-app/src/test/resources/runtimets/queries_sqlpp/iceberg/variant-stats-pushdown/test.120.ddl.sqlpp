// floatNanVariant holds two fully shredded files whose bounds the engine reads differently from a plain double
// comparison: f=16777216 as a FLOAT (id 1), and d=1.0 and d=NaN as DOUBLEs in one file (ids 2 and 3), whose bounds
// leave the NaN out. Steps 130 and 140 each return a row from a file that pruning on those bounds as doubles skips.
DROP COLLECTION floatNanVariant IF EXISTS;
DROP TYPE floatNanVariant IF EXISTS;

CREATE TYPE floatNanVariant AS open {};
CREATE EXTERNAL COLLECTION floatNanVariant(floatNanVariant)
USING S3
(
    ("table-format"="iceberg"),
    ("namespace"="my_namespace"),
    ("tableName"="floatNanVariant"),
    ("region"="custom-region"),
    ("serviceEndpoint"="%DOCKER_S3_CONTAINER%"),
    ("pathStyleAddressing"="true"),
    ("catalogName"="myNessieCatalog"),
    ("format"="parquet")
);
