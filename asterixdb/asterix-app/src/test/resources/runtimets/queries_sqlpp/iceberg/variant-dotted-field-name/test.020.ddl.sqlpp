// The same table again with variantStatsPushdown DISABLED, as an oracle. If the predicate below returns the row here
// but not against the pushdown-enabled collection, the missing row is caused by data-file skipping and nothing else.
DROP COLLECTION variantDottedFieldNameNoPushdown IF EXISTS;
DROP TYPE variantDottedFieldNameNoPushdown IF EXISTS;

CREATE TYPE variantDottedFieldNameNoPushdown AS open {};
CREATE EXTERNAL COLLECTION variantDottedFieldNameNoPushdown(variantDottedFieldNameNoPushdown)
USING S3
(
    ("table-format"="iceberg"),
    ("namespace"="my_namespace"),
    ("tableName"="dottedFieldNameVariant"),
    ("region"="custom-region"),
    ("serviceEndpoint"="%DOCKER_S3_CONTAINER%"),
    ("pathStyleAddressing"="true"),
    ("catalogName"="myNessieCatalog"),
    ("format"="parquet"),
    ("variantStatsPushdown"="false")
);
