// A second collection over the same table read with variantStatsPushdown turned off. The flag is a
// break-glass switch: it must change how much is read, never what is returned. Step 110 runs step 030's exact
// predicate against this collection, so the two together are a differential test — identical rows, different
// numbers of files touched.
DROP COLLECTION manyFilesVariantNoPushdown IF EXISTS;
DROP TYPE manyFilesVariantNoPushdown IF EXISTS;

CREATE TYPE manyFilesVariantNoPushdown AS open {};
CREATE EXTERNAL COLLECTION manyFilesVariantNoPushdown(manyFilesVariantNoPushdown)
USING S3
(
    ("table-format"="iceberg"),
    ("namespace"="my_namespace"),
    ("tableName"="manyFilesVariant"),
    ("region"="custom-region"),
    ("serviceEndpoint"="%DOCKER_S3_CONTAINER%"),
    ("pathStyleAddressing"="true"),
    ("catalogName"="myNessieCatalog"),
    ("format"="parquet"),
    ("variantStatsPushdown"="false")
);
