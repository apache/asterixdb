// The shreddedVariant table holds two rows carrying the SAME logical variant object (covering every supported
// Variant PhysicalType): one row written serialized, one row written FULLY shredded (every field promoted to a
// typed sub-column). Reading the collection exercises the (fully) shredded reconstruction path and proves the read
// pipeline is transparent to the on-disk encoding. Partial shredding is covered separately by
// variant-partially-shredded. decimal-to-double is required for the DECIMAL4/8/16 values.
DROP COLLECTION shreddedVariant IF EXISTS;
DROP TYPE shreddedVariant IF EXISTS;

CREATE TYPE shreddedVariant AS open {};
CREATE EXTERNAL COLLECTION shreddedVariant(shreddedVariant)
USING S3
(
    ("table-format"="iceberg"),
    ("namespace"="my_namespace"),
    ("tableName"="shreddedVariant"),
    ("region"="custom-region"),
    ("serviceEndpoint"="%DOCKER_S3_CONTAINER%"),
    ("pathStyleAddressing"="true"),
    ("catalogName"="myNessieCatalog"),
    ("format"="parquet"),
    ("decimal-to-double"="true")
);
