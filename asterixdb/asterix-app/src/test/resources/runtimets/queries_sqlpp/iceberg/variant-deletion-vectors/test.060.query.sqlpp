-- A deletion vector holding MORE THAN ONE position. Every other step here deletes a single position, so the
-- multi-position path through the roaring bitmap is otherwise never read back. The file holds buckets 50..53 and
-- positions 0 and 2 are deleted, so 51 and 53 survive.
SELECT id, variant_field.bucket AS bucket
FROM deletionVectorVariant
WHERE variant_field.bucket >= 50 AND variant_field.bucket < 60
ORDER BY id;
