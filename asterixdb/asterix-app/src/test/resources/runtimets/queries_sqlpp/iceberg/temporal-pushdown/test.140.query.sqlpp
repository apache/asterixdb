-- FLIPPED >= : literal >= column means column <= literal, so flipComparison must turn GE into LE and the
-- widening must then use the <= window (the upper bound), not the >= one. Same rows as test.040.
SELECT e.id FROM temporalPrecision e WHERE datetime("2026-03-15T09:00:00.123Z") >= e.ts ORDER BY e.id;
