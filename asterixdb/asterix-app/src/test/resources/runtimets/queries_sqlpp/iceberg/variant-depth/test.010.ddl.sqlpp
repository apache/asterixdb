// {"a":{"b":42}} is nested two levels deep, so variantDepth 2 must read it.
DROP COLLECTION depthAtLimit IF EXISTS;
DROP TYPE depthAtLimit IF EXISTS;
CREATE TYPE depthAtLimit AS open {};
CREATE EXTERNAL COLLECTION depthAtLimit(depthAtLimit)
USING S3
(
    ("table-format"="iceberg"),
    ("namespace"="my_namespace"),
    ("tableName"="depthTestVariant"),
    ("region"="custom-region"),
    ("serviceEndpoint"="%DOCKER_S3_CONTAINER%"),
    ("pathStyleAddressing"="true"),
    ("catalogName"="myNessieCatalog"),
    ("format"="parquet"),
    ("variantDepth"="2")
);

// 1000 objects deep, the most variantDepth allows.
DROP COLLECTION maxDepthAtLimit IF EXISTS;
DROP TYPE maxDepthAtLimit IF EXISTS;
CREATE TYPE maxDepthAtLimit AS open {};
CREATE EXTERNAL COLLECTION maxDepthAtLimit(maxDepthAtLimit)
USING S3
(
    ("table-format"="iceberg"),
    ("namespace"="my_namespace"),
    ("tableName"="maxDepthVariant"),
    ("region"="custom-region"),
    ("serviceEndpoint"="%DOCKER_S3_CONTAINER%"),
    ("pathStyleAddressing"="true"),
    ("catalogName"="myNessieCatalog"),
    ("format"="parquet"),
    ("variantDepth"="1000")
);
