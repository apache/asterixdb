USE test;

-- Only the documents that wrote a real value at the leaf return one. Null and missing are both UNKNOWN here, so a
-- count above 400 would mean a null had been read back as a value.
SELECT VALUE COUNT(*)
FROM NestedDataset c
WHERE c.EVENT_DATA.linked_users.hot IS NOT UNKNOWN;
