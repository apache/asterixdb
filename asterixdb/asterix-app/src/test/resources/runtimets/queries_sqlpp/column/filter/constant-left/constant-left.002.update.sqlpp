USE test;

-- Each query's constant is the column's max or min, so a mega leaf holding it is skipped unless the filter is
-- inclusive at that bound
INSERT INTO ds ([
  {"id": 0, "d": double(1.0), "i": 1, "s": "apple"},
  {"id": 1, "d": double(5.0), "i": 5, "s": "mango"},
  {"id": 2, "d": double(7.0), "i": 7, "s": "zebra"}
]);
