USE test;

-- Now "x" is in ev.users of every document: dense, so it is promoted into a column of its own.
UPSERT INTO LowIndexDataset (
    SELECT VALUE {"id": x, "x": x, "ev": {"users":
                    object_add_fields({"x": -x}, [{"field-name": "k" || to_string(x), "field-value": x}])}}
    FROM RANGE(2001, 2300) x
);
