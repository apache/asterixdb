USE test;

-- Guards against a vacuous pass: 4000 distinct names went under m, two per document, so a partition where m did not
-- collapse holds roughly a thousand columns. One where it did holds only the names seen before the detector fired.
SELECT VALUE MAX(v.columnCount) < 600
FROM `estimated-collection-column-count`("Default", "test", "ColumnDataset") AS v;
