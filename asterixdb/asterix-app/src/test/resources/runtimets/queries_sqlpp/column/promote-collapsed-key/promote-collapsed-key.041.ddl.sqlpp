USE test;

-- A key promoted under a name the dictionary already held. The dictionary is shared by the whole schema, so "x",
-- interned by the root in the first document, has an index below ev.users' collapse boundary; ev.users still routes
-- it into its map (it has no child "x"), and promotes it once it turns dense. A reader that decided "promoted" from
-- the index alone read only the new column and lost every value written into the map before.

CREATE DATASET LowIndexDataset(OpenType)
PRIMARY KEY id WITH {
    "storage-format": {"format" : "column"}
};
