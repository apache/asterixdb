USE test;

-- Every record of both eras through the whole-record reader: object_length needs the entire record, so nothing is
-- projected away. A record whose node has a key promoted out of its collapsed child used to come back as {} or as the
-- promoted field alone, which shortens this total. 2000 documents carry {id, k} and 600 carry {id, hot, k}.
SELECT VALUE SUM(object_length(c))
FROM ColumnDataset c;
