USE test;

-- Every entry of both components, by value type. 2000 * 2 strings from the first component plus 400 from the second;
-- 400 bigints and 400 objects from the second.
SELECT VALUE {"firstComponentStrings": COUNT(CASE WHEN c.id <= 2000 AND is_string(p.`value`) THEN 1 END),
              "strings": COUNT(CASE WHEN is_string(p.`value`) THEN 1 END),
              "numbers": COUNT(CASE WHEN is_number(p.`value`) THEN 1 END),
              "objects": COUNT(CASE WHEN is_object(p.`value`) THEN 1 END),
              "entries": COUNT(*)}
FROM ColumnDataset c, OBJECT_PAIRS(c.m) p;
