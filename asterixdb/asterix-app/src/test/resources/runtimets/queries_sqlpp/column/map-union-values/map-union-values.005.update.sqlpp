USE test;

-- The second component adds bigint- and object-valued keys under the already collapsed m, so its map value becomes
-- a union. Each document also carries one string entry, which lands in a union arm that is not first.
UPSERT INTO ColumnDataset (
    SELECT VALUE {"id": x,
                  "m": object_add_fields({},
                          [{"field-name": "a" || to_string(x), "field-value": "v" || to_string(x)},
                           {"field-name": "n" || to_string(x), "field-value": x},
                           {"field-name": "o" || to_string(x), "field-value": {"deep": "d" || to_string(x)}}])}
    FROM RANGE(2001, 2400) x
);
