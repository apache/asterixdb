USE test;

-- A null AT the leaf, separated from the null and the missing above it: EVENT_DATA exists, linked_users exists, and
-- "hot" is present with a null value. This is the case a rebuilt definition level is most likely to get wrong.
SELECT VALUE COUNT(*)
FROM NestedDataset c
WHERE c.EVENT_DATA IS NOT UNKNOWN
  AND c.EVENT_DATA.linked_users IS NOT UNKNOWN
  AND c.EVENT_DATA.linked_users.hot IS NULL;
