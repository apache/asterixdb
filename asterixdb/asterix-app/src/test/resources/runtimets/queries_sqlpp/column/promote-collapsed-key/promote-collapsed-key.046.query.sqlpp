USE test;

-- Both components, read through the newest schema of their lineage: 200 values from the collapsed child of the first
-- (1005, 1010, ... 2000) and 300 from the second (2001-2300), all negated. Only 300 means the map was not consulted.
SELECT COUNT(*) AS n, SUM(c.ev.users.x) AS s
FROM LowIndexDataset c
WHERE c.ev.users.x IS NOT UNKNOWN;
