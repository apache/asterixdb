USE test;
-- A value predicate on a promoted key is pushed down as a column filter. Values written before the promotion went to
-- the collapsed child; a filter that consults only the column must not run while any component may still hold them
-- there, and once a merge has moved them into the column it may: either way all 600 must pass.
SELECT VALUE COUNT(*)
FROM ColumnDataset c
WHERE c.hot >= 2001;
