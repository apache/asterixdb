USE test;

-- One new key per document collapses ev.users. "x" sits at the root of every document, and in ev.users of one in
-- five past 1000 only -- too sparse to promote, so those values stay in the collapsed child.
UPSERT INTO LowIndexDataset (
    SELECT VALUE {"id": x, "x": x, "ev": {"users":
                    object_add_fields(CASE WHEN x > 1000 AND x % 5 = 0 THEN {"x": -x} ELSE {} END,
                                      [{"field-name": "k" || to_string(x), "field-value": x}])}}
    FROM RANGE(1, 2000) x
);
