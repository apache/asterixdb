USE test;

-- The second era: "hot" is by now promoted, and a quarter of these documents still write null into it -- a promoted
-- column must carry nulls as faithfully as the collapsed child did.
UPSERT INTO NestedDataset (
    SELECT VALUE CASE x % 4
        WHEN 0 THEN {"id": x}
        WHEN 1 THEN {"id": x, "EVENT_DATA": null}
        WHEN 2 THEN {"id": x, "EVENT_DATA": {"channel": "web", "linked_users":
                        object_add_fields(CASE WHEN x > 2400 THEN {"hot": x} ELSE {} END,
                                          [{"field-name": "k" || to_string(x), "field-value": x}])}}
        ELSE {"id": x, "EVENT_DATA": {"channel": "web", "linked_users":
                        object_add_fields(CASE WHEN x > 2400 THEN {"hot": null} ELSE {} END,
                                          [{"field-name": "k" || to_string(x), "field-value": x}])}}
    END
    FROM RANGE(3201, 4000) x
);
