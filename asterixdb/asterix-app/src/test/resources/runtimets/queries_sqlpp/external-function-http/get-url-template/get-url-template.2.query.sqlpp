-- an argument fills its parameter in the URL, always encoded, so urlencode does not apply to it; the other
-- parameters go in the query string
SELECT VALUE {
  "encoded": test.item("a b?c~d"),
  "number": test.item(42),
  "uuid": test.item(uuid("5c0e4a2b-1f3d-4e8a-9b7c-2d6f8a1e3c90")),
  "raw": test.rawItem("a+b%20c"),
  "mixed": test.itemPart("x", 1, "y")
};
