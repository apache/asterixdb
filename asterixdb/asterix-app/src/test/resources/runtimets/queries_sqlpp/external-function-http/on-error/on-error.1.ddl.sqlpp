DROP DATAVERSE test IF EXISTS;
CREATE DATAVERSE test;
USE test;

CREATE EXTERNAL FUNCTION echo(a) AT 'http://127.0.0.1:19371/echo' WITH { "on-error": "null" };
CREATE EXTERNAL FUNCTION status(code) AT 'http://127.0.0.1:19371/status/{code}' WITH { "on-error": "null" };
CREATE EXTERNAL FUNCTION content(kind) AT 'http://127.0.0.1:19371/content/{kind}' WITH { "on-error": "null" };
CREATE EXTERNAL FUNCTION sized(length) AT 'http://127.0.0.1:19371/sized/{length}' WITH { "on-error": "null" };
CREATE EXTERNAL FUNCTION slow() AT 'http://127.0.0.1:19371/slow' WITH { "on-error": "null", "timeout": 1 };
-- nothing listens on port 1
CREATE EXTERNAL FUNCTION refused() AT 'http://127.0.0.1:1/refused' WITH { "on-error": "null" };
CREATE EXTERNAL FUNCTION throttled(status, failures, id, after)
  AT 'http://127.0.0.1:19371/throttled/{status}/{failures}/{id}' WITH { "on-error": "null" };
CREATE EXTERNAL FUNCTION item(id) AT 'http://127.0.0.1:19371/echo/{id}' WITH { "on-error": "null" };
CREATE EXTERNAL FUNCTION untrusted(a) AT 'https://127.0.0.1:19372/echo' WITH { "on-error": "null" };
CREATE EXTERNAL FUNCTION wrongSecret(a) AT 'https://127.0.0.1:19372/oauth/echo' WITH {
  "on-error": "null",
  "oauthTokenUri": "https://127.0.0.1:19372/token",
  "oauthClientId": "on-error",
  "oauthClientSecret": "wrong",
  "certificates": "-----BEGIN CERTIFICATE-----
