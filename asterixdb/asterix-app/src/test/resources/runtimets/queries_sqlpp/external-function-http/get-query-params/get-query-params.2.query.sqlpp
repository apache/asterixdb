-- the parameters go in the query string in declared order: a string as it is, a value JSON writes as a
-- string, such as a date or a uuid, without its quotes, and any other value as JSON
SELECT VALUE test.search(t.q, t.page)
FROM [ { "id": 1, "q": "a b&c=d", "page": 2 },
       { "id": 2, "q": { "k": [ 1, "v" ] }, "page": 2.5 },
       { "id": 3, "q": true, "page": "x" },
       { "id": 4, "q": date("2026-11-20"), "page": uuid("5c0e4a2b-1f3d-4e8a-9b7c-2d6f8a1e3c90") } ] AS t
ORDER BY t.id;
