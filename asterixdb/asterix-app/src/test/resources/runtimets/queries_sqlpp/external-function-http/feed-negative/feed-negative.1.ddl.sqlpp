DROP DATAVERSE test IF EXISTS;
CREATE DATAVERSE test;
USE test;

CREATE TYPE Item AS OPEN { id: int64 };
CREATE DATASET Items(Item) PRIMARY KEY id;
CREATE FEED ItemFeed WITH {
  "adapter-name": "socket_adapter",
  "sockets": "127.0.0.1:10001",
  "address-type": "IP",
  "type-name": "Item",
  "format": "adm"
};

CREATE EXTERNAL FUNCTION enrich(item) AT 'http://127.0.0.1:19371/echo' WITH { "method": "post" };
CREATE FUNCTION enrichAll(item) { object_merge(item, { "enriched": test.enrich(item) }) };
CREATE FUNCTION wrapEnrich(item) { test.enrichAll(item) };
