DROP DATAVERSE test IF EXISTS;
CREATE DATAVERSE test;
USE test;

CREATE EXTERNAL FUNCTION lookup(id) AT 'https://api.example.com/items/{id}';

CREATE EXTERNAL FUNCTION score(a, b) AT 'https://localhost:8080/score' WITH {
  "method": "post",
  "body": "urlencoded",
  "timeout": 30,
  "urlencode": false,
  "on-error": "null",
  "headers": { "X-Trace": "on", "Authorization": "Bearer t" },
  "deterministic": true,
  "null-call": true
};

CREATE EXTERNAL FUNCTION secured(q) AT 'https://api.example.com/search' WITH {
  "username": "alice",
  "password": "secret"
};

CREATE EXTERNAL FUNCTION submit(a) AT 'https://api.example.com/submit' WITH { "method": "Post" };

CREATE EXTERNAL FUNCTION authorized(q) AT 'https://api.example.com/search' WITH {
  "oauthTokenUri": "https://auth.example.com/token",
  "oauthClientId": "id",
  "oauthClientSecret": "secret",
  "oauthAllowedScopes": "read"
};

CREATE OR REPLACE EXTERNAL FUNCTION lookup(id) AT 'https://api.example.com/v2/items/{id}';

CREATE EXTERNAL FUNCTION IF NOT EXISTS lookup(id) AT 'https://ignored.example.com/{id}';
