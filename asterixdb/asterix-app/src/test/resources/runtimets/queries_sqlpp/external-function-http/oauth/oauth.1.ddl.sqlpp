DROP DATAVERSE test IF EXISTS;
CREATE DATAVERSE test;
USE test;

-- every client of the mock server has the secret 'se+cr:et', which form encoding changes; the token cache outlives a
-- query and is shared by the node, so each query that shows a token uses a client that no other query uses
CREATE EXTERNAL FUNCTION oauth(a) AT 'https://127.0.0.1:19372/oauth/echo' WITH {
  "oauthTokenUri": "https://127.0.0.1:19372/token",
  "oauthClientId": "shared",
  "oauthClientSecret": "se+cr:et",
  "certificates": "-----BEGIN CERTIFICATE-----
MIIBUTCB+KADAgECAggxBTH93Sc6kzAKBggqhkjOPQQDAjAUMRIwEAYDVQQDEwkx
MjcuMC4wLjEwIBcNMjYxMTA5MjAxOTA1WhgPMjEyNjEwMTYyMDE5MDVaMBQxEjAQ
BgNVBAMTCTEyNy4wLjAuMTBZMBMGByqGSM49AgEGCCqGSM49AwEHA0IABHnNSvgh
kUlVlzs7WxjekuGCWnTP1LwHFiM0KJjxIg0eeQc2/guaxN3Xa3vrBRH5mgOBoRmG
R0oWS4X8otn0RLejMjAwMB0GA1UdDgQWBBQKBDoFywwkCxcfctfZVZivU7UfhDAP
BgNVHREECDAGhwR/AAABMAoGCCqGSM49BAMCA0gAMEUCIHRTVnKlOW/AF/zhhaqc
t8j3Ab29/4U6mjqRv7cFmA4SAiEAtKtOvva8FwlE8WC8WZo2Jn8pB+IY/cuHcsQ+
qX7PRcM=
-----END CERTIFICATE-----"
};
