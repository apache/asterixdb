-- gets a token for client rotating itself, which revokes the one the node has cached for it
CREATE EXTERNAL FUNCTION issue(grant_type) AT 'https://127.0.0.1:19372/token' WITH {
  "method": "post",
  "body": "urlencoded",
  "headers": { "Authorization": "Basic cm90YXRpbmc6c2UlMkJjciUzQWV0" },
  "certificates": "-----BEGIN CERTIFICATE-----
