DROP DATAVERSE test IF EXISTS;
CREATE DATAVERSE test;
USE test;

CREATE EXTERNAL FUNCTION slow() AT 'http://127.0.0.1:19371/slow' WITH { "timeout": 1 };
CREATE EXTERNAL FUNCTION slowDefault() AT 'http://127.0.0.1:19371/slow';
CREATE EXTERNAL FUNCTION slowClamped() AT 'http://127.0.0.1:19371/slow' WITH { "timeout": 60 };
