/*
 * Description: equalities on a prefix of an untyped composite index and a one-sided range on the next key, on a
 *              collection with no declared fields.
 * Expected Result: Success
 */

DROP DATAVERSE test IF EXISTS;
CREATE DATAVERSE test;
USE test;

CREATE DATASET ds PRIMARY KEY (id: bigint);
CREATE DATASET ds2 PRIMARY KEY (k1: bigint, k2: bigint);
CREATE INDEX idx_cd ON ds(c, d);
CREATE INDEX idx_cde ON ds(c, d, e);
