USE test;

INSERT INTO ds (SELECT VALUE {"id": i, "a": i % 50, "b": i % 7, "c": i % 5, "d": i % 11, "e": i % 4, "n": "s" || to_string(i % 20)}
                FROM range(1, 600) i);
INSERT INTO ds (SELECT VALUE {"id": i, "a": to_double(i % 50), "b": i % 7, "c": to_double(i % 5), "d": to_double(i % 11), "e": i % 4,
                              "n": "s" || to_string(i % 20)} FROM range(601, 620) i);
INSERT INTO ds (SELECT VALUE {"id": i, "a": to_string(i % 50), "b": i % 7, "c": to_string(i % 5), "d": to_string(i % 11), "e": i % 4,
                              "n": i % 20} FROM range(621, 630) i);
INSERT INTO ds (SELECT VALUE {"id": i, "b": i % 7} FROM range(631, 640) i);
INSERT INTO ds2 (SELECT VALUE {"k1": i % 10, "k2": i DIV 10, "v": i} FROM range(1, 300) i);
