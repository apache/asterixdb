USE test;

INSERT INTO col1 ([
  {"id": 1, "a": 1, "b": 3, "n": "x"},
  {"id": 2, "a": 1, "b": 4, "n": "y"},
  {"id": 3, "a": 2, "b": 3, "n": "z"},
  {"id": 4, "a": 2, "b": 5, "n": "x"},
  {"id": 5, "a": 3, "b": 4, "n": "y"},
  {"id": 6, "a": 4, "b": 3, "n": "z"},
  {"id": 7, "a": 5},
  {"id": 8}
]);

INSERT INTO col2 (SELECT VALUE c FROM col1 c);

INSERT INTO col3 (SELECT VALUE {"id": i, "a": i % 100} FROM range(1, 2000) i);

ANALYZE DATASET col3;
