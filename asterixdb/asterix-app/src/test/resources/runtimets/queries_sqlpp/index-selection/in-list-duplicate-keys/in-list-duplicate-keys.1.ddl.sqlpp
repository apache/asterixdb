DROP DATAVERSE test IF EXISTS;
CREATE DATAVERSE test;
USE test;

CREATE TYPE T AS { id: bigint };
CREATE DATASET col1(T) PRIMARY KEY id;
CREATE INDEX idx_a ON col1(a: bigint);
CREATE INDEX idx_n ON col1(n: string);
CREATE DATASET col2(T) PRIMARY KEY id;
CREATE INDEX idx_ab ON col2(a: bigint, b: bigint);
CREATE DATASET col3(T) PRIMARY KEY id;
CREATE INDEX idx3_a ON col3(a: bigint);
