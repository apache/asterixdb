USE tpch;

// The projection queries below check the doc-size the CBO derives from a sample, so the sample must
// exist in every suite, including the ones that do not ANALYZE on their own. A fixed seed keeps the
// numbers reproducible.
ANALYZE DATASET Orders WITH {"sample-seed": "1000"};
ANALYZE DATASET LineItem WITH {"sample-seed": "1000"};
