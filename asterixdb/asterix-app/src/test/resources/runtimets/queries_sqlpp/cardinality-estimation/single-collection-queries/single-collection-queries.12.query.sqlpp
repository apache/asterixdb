/*
 * Description: The doc size flowing out of the data scan must not be reported as zero
 * for single table queries returning a column as a value.
 */

USE tpch;

-- To keep the costs independent of the number of cores
SET `compiler.parallelism` "0";

EXPLAIN
SELECT VALUE o.o_orderdate
FROM Orders o;
