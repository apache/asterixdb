/*
 * COUNT(DISTINCT) inside a correlated subquery (nested subplan): the aggregate is evaluated once
 * per outer tuple, exercising the per-group init()/reuse path of the hash aggregate.
 * Salaries: 100, 100, 200, 300, 300, 400.
 * id 1 (100) -> distinct salaries >= 100 = {100,200,300,400} = 4
 * id 2 (100) -> 4
 * id 3 (200) -> {200,300,400} = 3
 */

use test;

/* Same query as hashbased.12 but with the hash rewrite disabled: results must be identical. */
SET `compiler.aggregate.distinct.hash` "false";

SELECT e.id AS id,
       (SELECT VALUE COUNT(DISTINCT e2.salary) FROM emp e2 WHERE e2.salary >= e.salary)[0] AS ge_distinct
FROM emp e
WHERE e.id <= 3
ORDER BY e.id;
