/*
 * COUNT(DISTINCT) over a computed expression with a WHERE filter and no GROUP BY.
 * salary % 200 over 100, 100, 200, 300, 300, 400 -> 100, 100, 0, 100, 100, 0 -> {0, 100} = 2.
 */

use test;

/* Same query as hashbased.14 but with the hash rewrite disabled: results must be identical. */
SET `compiler.aggregate.distinct.hash` "false";

SELECT COUNT(DISTINCT salary % 200) AS m
FROM emp
WHERE salary >= 100;
