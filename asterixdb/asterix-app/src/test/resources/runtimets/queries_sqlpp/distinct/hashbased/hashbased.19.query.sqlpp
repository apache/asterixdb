/*
 * COUNT(DISTINCT) over a self-join, repeated in the HAVING clause. The join multiplies duplicate
 * salary values per group; the hash aggregate must still count each salary once.
 */

use test;

/* Same query as hashbased.13 but with the hash rewrite disabled: results must be identical. */
SET `compiler.aggregate.distinct.hash` "false";

SELECT e1.dept AS dept, COUNT(DISTINCT e2.salary) AS ds
FROM emp e1 JOIN emp e2 ON e1.dept = e2.dept
GROUP BY e1.dept
HAVING COUNT(DISTINCT e2.salary) > 1
ORDER BY e1.dept;
