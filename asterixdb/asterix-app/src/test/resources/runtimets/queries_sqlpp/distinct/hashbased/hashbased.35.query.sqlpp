/*
 * Two distinct aggregates on the same column with the hash aggregate enabled (flag true). They share a
 * single DISTINCT today; rewriting only COUNT(DISTINCT) would deduplicate salary twice while the sort
 * needed by SUM(DISTINCT salary) remains. The rewrite is skipped, so no agg-sql-count-distinct-hash
 * appears and both aggregates read one MICRO_PRE_SORTED_DISTINCT_BY.
 */

use test;

SET `compiler.aggregate.distinct.hash` "true";

explain SELECT dept,
       COUNT(DISTINCT salary) AS distinct_salaries,
       SUM(DISTINCT salary) AS sum_distinct_salary
FROM emp
GROUP BY dept
ORDER BY dept;
