/*
 * Duplicates that straddle the in-memory -> spill transition: i % 45000 over range(1, 90000)
 * produces every residue exactly twice, so duplicates seen before the switch (deduplicated in the
 * hash table) and after it (deduplicated by the sorted merge) must collapse to 45000.
 */

use test;

SET `compiler.aggregate.distinct.hash` "true";
SET `compiler.aggregate.distinct.hash.memory` "512KB";

SELECT VALUE COUNT(DISTINCT i % 45000)
FROM range(1, 90000) AS i;
