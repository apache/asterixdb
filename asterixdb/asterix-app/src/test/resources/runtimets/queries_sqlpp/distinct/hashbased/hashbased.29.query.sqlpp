/*
 * Plan for the mixed aggregate with the hash aggregate enabled (flag true): the two
 * COUNT(DISTINCT) should appear as agg-sql-count-distinct-hash; COUNT(salary)/SUM(salary) unchanged.
 */

use test;

SET `compiler.aggregate.distinct.hash` "true";

explain SELECT COUNT(DISTINCT salary) AS distinct_salaries,
       COUNT(DISTINCT id) AS distinct_ids,
       COUNT(salary) AS salaries,
       SUM(salary) AS sum_salary
FROM emp;
