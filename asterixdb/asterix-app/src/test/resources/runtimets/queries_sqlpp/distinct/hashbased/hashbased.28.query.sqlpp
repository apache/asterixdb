/*
 * Same mixed aggregate as hashbased.27 but with the hash aggregate disabled (flag false):
 * the sort-based path must return the same result.
 */

use test;

SET `compiler.aggregate.distinct.hash` "false";

SELECT COUNT(DISTINCT salary) AS distinct_salaries,
       COUNT(DISTINCT id) AS distinct_ids,
       COUNT(salary) AS salaries,
       SUM(salary) AS sum_salary
FROM emp;
