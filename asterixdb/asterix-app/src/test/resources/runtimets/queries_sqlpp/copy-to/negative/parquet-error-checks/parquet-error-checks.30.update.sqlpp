USE test;

/*
 * A null top-level row has no representation in parquet: the root schema element is a required group. The
 * PARTITION BY matters beyond the partitioning itself -- it puts a sort in the plan, and the sort used to
 * replace this error with a NullPointerException raised while closing a half-opened writer.
 */
COPY (
    SELECT VALUE (CASE WHEN t.id = 1 THEN null ELSE object_concat([t, {"grp": "a"}]) END)
    FROM MergedRecordCollection AS t
) toWriter
TO %adapter%
PATH (%pathprefix% "copy-to-result", "parquet-errorchecks30", grp)
OVER ( PARTITION BY toWriter.grp AS grp )
WITH {
    %template_colons%,
    %additionalProperties%
    "format":"parquet"
};
