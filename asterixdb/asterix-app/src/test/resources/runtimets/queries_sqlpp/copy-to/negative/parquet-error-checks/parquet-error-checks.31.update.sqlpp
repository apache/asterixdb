USE test;

/*
 * The declared-schema path does not build the schema-inference visitors, so the record visitor is the only
 * place the source type is checked. A scalar source must be refused there with the same coded error.
 */
COPY (
    SELECT VALUE t.id
    FROM MergedRecordCollection AS t
) toWriter
TO %adapter%
PATH (%pathprefix% "copy-to-result", "parquet-errorchecks31")
TYPE ( {id:int} )
WITH {
    %template_colons%,
    %additionalProperties%
    "format":"parquet"
};
