USE test;

/*
 * object_concat builds the same nullable record type through a function call rather than the star, so it
 * exercises the union unwrap independently of how the merge got into the plan.
 */
COPY (
    SELECT VALUE object_concat([t, {"grp": upper(t.grp_source)}])
    FROM col1 AS t
) toWriter
TO %adapter%
PATH (%pathprefix% "copy-to-result", "parquet-partition-merged-record-concat")
WITH {
    %template_colons%,
    %additionalProperties%
    "format":"parquet"
};
