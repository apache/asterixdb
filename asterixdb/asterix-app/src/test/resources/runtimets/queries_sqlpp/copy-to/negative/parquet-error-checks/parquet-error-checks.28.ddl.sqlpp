USE test;

/*
 * A collection of its own: TestCollection is deliberately heterogeneous for the checks above, and schema
 * inference would hit the max-schemas limit before reaching the type error these steps are about.
 */
CREATE COLLECTION MergedRecordCollection(ColumnType1) PRIMARY KEY id;
