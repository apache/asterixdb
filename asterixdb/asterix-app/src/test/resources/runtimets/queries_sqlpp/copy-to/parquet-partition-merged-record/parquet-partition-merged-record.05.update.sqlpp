USE test;

/*
 * Same nullable record type, reached without a sort in the plan: the type is rejected by the schema visitors
 * regardless of PARTITION BY, so the un-partitioned shape needs its own coverage.
 */
COPY (
    SELECT t.*, upper(t.grp_source) AS grp
    FROM col1 AS t
) toWriter
TO %adapter%
PATH (%pathprefix% "copy-to-result", "parquet-partition-merged-record-nopart")
WITH {
    %template_colons%,
    %additionalProperties%
    "format":"parquet"
};
