USE test;

INSERT INTO col1 (
    [
        {"id": 1, "name": "one",   "grp_source": "a"},
        {"id": 2, "name": "two",   "grp_source": "b"},
        {"id": 3, "name": "three", "grp_source": "a"}
    ]
);

/*
 * The star plus an added field compiles to a record merge, whose result type is a *nullable* record. The writer
 * has to accept that union rather than rejecting it as an unsupported type.
 */
COPY (
    SELECT t.*, upper(t.grp_source) AS grp
    FROM col1 AS t
) toWriter
TO %adapter%
PATH (%pathprefix% "copy-to-result", "parquet-partition-merged-record", grp)
OVER ( PARTITION BY toWriter.grp AS grp )
WITH {
    %template_colons%,
    %additionalProperties%
    "format":"parquet"
};
