/*
 * Description  : Timestamps around 1970 at micro- and nanosecond precision, one row per file
 * Expected Res : Success
 */

// Each value is narrowed to the millisecond that CONTAINS it, so -500us is 1969-12-31T23:59:59.999 and
// -1876544us is 23:59:58.123. Every row sits alone in its own file, so it is its row group's only statistic and a
// pushed window on the wrong side of it prunes the row rather than merely reading too much.
// id: 1 = 2026-03-15T09:00:00.123456, 2 = +456us, 3 = -500us, 4 = -1500us, 5 = -1876544us, 6 = -1000us, 7 = 0.

DROP DATAVERSE test IF EXISTS;
CREATE DATAVERSE test;

USE test;

CREATE TYPE PreEpochType AS {
};

CREATE EXTERNAL DATASET PreEpoch(PreEpochType) USING %adapter%
(
  %template%,
  %additional_Properties%
  ("container"="playground"),
  ("definition"="parquet-data/pre-epoch"),
  ("format" = "parquet")
);
