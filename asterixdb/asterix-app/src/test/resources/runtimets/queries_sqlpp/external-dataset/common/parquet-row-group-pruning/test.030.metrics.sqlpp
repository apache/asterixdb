/*
 * Description  : A predicate no row group can satisfy reads nothing at all
 * Expected Res : Success
 */

// The step that fails loudest if the predicate stops reaching the reader: this goes from 0 to the whole file.

USE test;

SELECT COUNT(*) AS cnt FROM RowGroups WHERE id = -1;
