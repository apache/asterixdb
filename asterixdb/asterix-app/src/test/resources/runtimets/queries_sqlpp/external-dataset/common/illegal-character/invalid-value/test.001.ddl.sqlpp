USE test;

// illegalCharacterHandling only accepts "replace" or "fail" -- this typo must be rejected at DDL time, not
// silently treated as "replace"
DROP DATASET ds1 IF EXISTS;
CREATE EXTERNAL DATASET ds1(t1) USING %adapter% (
%template%,
%additional_Properties%
("container"="illegal-character-invalid-value"),
("definition"="illegal-character-data"),
("format"="json"),
("illegalCharacterHandling"="bogus")
);
