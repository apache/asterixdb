/*
 * Description  : The same file read as temporal values and as the numbers it stores
 * Expected Res : Success
 */

// Three rows whose ts carries a sub-millisecond remainder. Read as a datetime that remainder is discarded; read
// as a number it survives, which is what these options are for.

DROP DATAVERSE test IF EXISTS;
CREATE DATAVERSE test;

USE test;

CREATE TYPE TemporalType AS {
};

CREATE EXTERNAL DATASET TemporalNumbers(TemporalType) USING %adapter%
(
  %template%,
  %additional_Properties%
  ("container"="playground"),
  ("definition"="parquet-data/temporal-types"),
  ("format" = "parquet"),
  ("date-to-int" = "true"),
  ("time-to-int" = "true"),
  ("timestamp-to-long" = "true")
);

CREATE EXTERNAL DATASET TemporalValues(TemporalType) USING %adapter%
(
  %template%,
  %additional_Properties%
  ("container"="playground"),
  ("definition"="parquet-data/temporal-types"),
  ("format" = "parquet")
);

// A number carries no zone, so this must read identically to TemporalNumbers above.
CREATE EXTERNAL DATASET TemporalNumbersZoned(TemporalType) USING %adapter%
(
  %template%,
  %additional_Properties%
  ("container"="playground"),
  ("definition"="parquet-data/temporal-types"),
  ("format" = "parquet"),
  ("timestamp-to-long" = "true"),
  ("timezone" = "+03:00")
);
