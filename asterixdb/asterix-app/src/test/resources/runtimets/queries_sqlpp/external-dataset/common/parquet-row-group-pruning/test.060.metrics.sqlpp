/*
 * Description  : A timezone must not cost the pruning
 * Expected Res : Success
 */

// The literal is three hours ahead of the stored value, so converting it back is what keeps this on the handful
// of row groups holding ids above 4990. Pushed unconverted it names an instant past every row group's maximum.

USE test;

SELECT COUNT(*) AS cnt FROM RowGroupsZoned r WHERE r.ts > datetime("1970-01-01T03:00:04.990Z");
