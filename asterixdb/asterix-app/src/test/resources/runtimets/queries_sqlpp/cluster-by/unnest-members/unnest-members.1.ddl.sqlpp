-- Members unnested straight after CLUSTER BY take the collect-then-unnest shortcut in the optimizer (the
-- member list is never built; see RewriteClusterByToKMeansRule#membersOf). These cases pin that the shortcut
-- returns what building the list would have, across the shapes that take it and the ones that must not.
-- Four tight blobs of ten points, so every seeding lands on the same clustering.
drop dataverse test if exists;
create dataverse test;
use test;
create type PointType as { id : integer };
create dataset Points(PointType) primary key id;
