use test;
-- CLUSTER BY syntax (desugared to distributed k-means). k=2 on the tiny 2-D dataset; the descriptor sc
-- (cluster_id, centroid) and CLUSTER AS members are all exercised.
from Points as p
cluster by p.vec as sc
cluster as members
with { "clustering_algorithm": "K-Means", "dimension": [2], "num_clusters": 2, "init_mode": "random" }
select sc.cluster_id as cid,
       array_count(members) as cnt,
       array_count(sc.centroid) as dim
order by cid;
