-- A members subquery pushed into the operator, then unnested: the subquery's pipeline is hoisted onto the
-- rows, the project the logical phase pushed into it dropped so the cluster id survives.
use test;
with mc as (
  from Points as p
  cluster by p.vec as sc cluster as members
  with { "clustering_algorithm": "K-Means", "dimension": [2], "num_clusters": 4, "seed": 7 }
  select sc.cluster_id as cid,
         (select value { "g": x.p.grp, "half": x.p.id div 20 } from members as x) as members
)
from mc, mc.members as mi
group by mc.cid as cid, mi.g as g, mi.half as half
select cid, g, half, count(*) as n
order by cid, g, half;
