-- CLUSTER BY execution test: distributed k-means (SQL++ form) on a tiny 2-D dataset. Two well-separated
-- Six distinct points. Every one attracts its own row, so none has zero weight and the pad has nothing
-- to draw from -- the regime where the shortfall must surface as an error rather than be papered over.
use test;

insert into Points ([
  {"id":1,"vec":[1.0,1.0]}, {"id":2,"vec":[2.0,2.0]}, {"id":3,"vec":[3.0,3.0]},
  {"id":4,"vec":[4.0,4.0]}, {"id":5,"vec":[5.0,5.0]}, {"id":6,"vec":[6.0,6.0]}
]);
