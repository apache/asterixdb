-- The same two-FROM-term path reached through UNNEST, where the second term is correlated with the first.

drop dataverse test if exists;
create dataverse test;
use test;

create type MovieType as closed {
  movie_id : integer,
  movie_year : integer,
  reviews : [{ review_id : integer, vec : [double] }]
};
create dataset Movies(MovieType) primary key movie_id;
