-- The inner CLUSTER BY names its descriptor sc, the same name the enclosing FROM binds. The inner
-- binding shadows the outer one and nothing in the block reads the enclosing row, so the block is not
-- correlated and must compile. The clause's own variables were once left in the block's free-variable
-- set, which made the correlation check see this shadowing as a read of the enclosing sc.
use test;
from [ {"rid": 1}, {"rid": 2} ] as sc
select sc.rid as rid,
       (from Points as p
        cluster by p.vec as sc cluster as members
        with {"clustering_algorithm": "K-Means", "dimension": [2], "num_clusters": 2 }
        select array_count(members) as cnt
        order by cnt) as clusters
order by rid;
