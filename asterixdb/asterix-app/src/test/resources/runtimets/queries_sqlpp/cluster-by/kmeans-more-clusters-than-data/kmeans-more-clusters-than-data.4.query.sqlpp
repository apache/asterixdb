-- One more than the data supports. The reduction yields six, the pad finds no zero-weight candidate to
-- top up from, and the Lloyd stage reports what the input actually supports instead of returning a
-- seventh centroid that duplicates one of the six.
use test;

from Points as p cluster by p.vec as sc cluster as members
with { "clustering_algorithm": "K-Means", "dimension": [2], "num_clusters": 7 }
select value sc.cluster_id
order by sc.cluster_id;
