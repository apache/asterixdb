-- Members carry the movie and the unnested review, and nothing else. The whole movie record repeats per
-- member, as plain GROUP BY ... GROUP AS does over the same UNNEST; project before clustering to avoid it.

use test;

select value (
  select value object_names(mem)
  from (
    from Movies as m, m.reviews as re
    where m.movie_year < 2020
    cluster by re.vec as sc
    cluster as members
    with { "clustering_algorithm": "K-Means", "dimension": [2], "num_clusters": 4 }
    select members
  ) as c
  unnest c.members as mem
  limit 1
)[0];
