-- CLUSTER AS yields one field per live FROM variable, as GROUP AS does: here both sides of the join, and
-- nothing else.

use test;

select value (
  select value object_names(mem)
  from (
    from Movies as m, Reviews as r
    where r.movie_id = m.movie_id and m.movie_year < 2020
    cluster by r.vec as sc
    cluster as members
    with { "clustering_algorithm": "K-Means", "dimension": [2], "num_clusters": 4 }
    select members
  ) as c
  unnest c.members as mem
  limit 1
)[0];
