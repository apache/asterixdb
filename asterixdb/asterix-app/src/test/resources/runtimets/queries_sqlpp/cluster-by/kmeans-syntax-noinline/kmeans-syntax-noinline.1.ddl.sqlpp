-- CLUSTER BY execution test: distributed k-means (SQL++ form) on a tiny 2-D dataset. Two well-separated
-- clusters {A,B,E} near origin and {C,D,F} near (8,8); k=2.
drop dataverse test if exists;
create dataverse test;
use test;
set `inline_with` "false";

create type PointType as closed {
  id : integer,
  vec : [double]
};
create dataset Points(PointType) primary key id;
