-- Two well-separated points, forty exact copies of each. Copies must count as many rows, not one: k-means||
-- draws every copy independently. A draw keyed on the vector contents made the forty copies one trial, and the
-- second point then never entered the pool in most seeds, so the run came back with a single cluster.
drop dataverse test if exists;
create dataverse test;
use test;

create type PT as closed { pk : bigint, vec : [double] };
create dataset uc(PT) primary key pk;
