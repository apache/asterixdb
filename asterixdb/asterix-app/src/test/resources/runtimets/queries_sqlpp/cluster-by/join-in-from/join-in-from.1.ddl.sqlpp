-- CLUSTER BY over a two-term FROM clause: the vector comes from one dataset, the predicate spans both.

drop dataverse test if exists;
create dataverse test;
use test;

create type MovieType as closed {
  movie_id : integer,
  movie_year : integer
};
create dataset Movies(MovieType) primary key movie_id;

create type ReviewType as closed {
  review_id : integer,
  movie_id : integer,
  vec : [double]
};
create dataset Reviews(ReviewType) primary key review_id;
