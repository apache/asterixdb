-- Eight movies of twenty nested reviews; six pass "< 2020", leaving 30 rows in each of the four groups.

use test;

insert into Movies (
  select m as movie_id,
         2000 + m * 3 as movie_year,
         (select value {
            "review_id": (j - 1) * 8 + m,
            "vec": [ ((j - 1) % 4) * 10.0 + sin(j * 8 + m),
                     ((j - 1) % 4) * 10.0 + cos(j * 8 + m) ]
          }
          from range(1, 20) as j) as reviews
  from range(1, 8) as m
);
