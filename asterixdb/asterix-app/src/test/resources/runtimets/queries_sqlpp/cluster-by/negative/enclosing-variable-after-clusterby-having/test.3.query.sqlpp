-- HAVING after CLUSTER BY reads the enclosing query's row. It parses into the same clause list as a HAVING
-- after GROUP BY, so it has to be traversed when the block's free variables are computed; otherwise the
-- correlation check never sees the read and the block reaches the optimizer as a correlated CLUSTER BY.
use test;
from [ {"threshold": 1} ] as o
select (from Points as p cluster by p.vec as sc cluster as members
        with {"clustering_algorithm": "K-Means", "dimension": [2], "num_clusters": 2 }
        having array_count(members) > o.threshold
        select sc.cluster_id as cid
        order by cid) as clusters;
