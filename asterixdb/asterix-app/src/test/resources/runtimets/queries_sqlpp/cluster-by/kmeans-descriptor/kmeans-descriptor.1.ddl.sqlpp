-- The cluster descriptor reads like an ordinary record: as a whole value it is the record of its fields, and
-- a field it does not have is MISSING rather than an error. Two well-separated pairs, so the clustering is
-- unambiguous, and both centroids (0.5 and 10.5) are exact in binary floating point.
drop dataverse test if exists;
create dataverse test;
use test;

create type PointType as closed {
  id : integer,
  vec : [double]
};
create dataset Points(PointType) primary key id;
