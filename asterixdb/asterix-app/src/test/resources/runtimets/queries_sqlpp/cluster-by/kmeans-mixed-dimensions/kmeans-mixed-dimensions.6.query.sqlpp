-- The same Dimension 2 verdict as query 3, through a nested subquery ordered outside the clustering block:
-- the shape that once split the width test from its is-array guard, and whose id 9 (no vector field) always
-- won the seed draw, since random(pv[0]) is unknown there and unknown orders first. Bad rows must be
-- excluded with a warning while the good ones still cluster.
use test;

select ids from (
  from Points as p
  cluster by p.vec as sc
  cluster as members
  with { "clustering_algorithm": "K-Means", "num_clusters": 2, "dimension": [2] }
  select array_sort((select value m.p.id from members as m)) as ids
) as c
order by ids;
