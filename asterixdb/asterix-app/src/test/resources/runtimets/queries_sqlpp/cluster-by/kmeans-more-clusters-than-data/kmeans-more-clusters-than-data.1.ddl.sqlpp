-- CLUSTER BY execution test: distributed k-means (SQL++ form) on a tiny 2-D dataset. Two well-separated
-- Asking for more clusters than the data can separate. Only candidates that attract rows become means, so
-- the k-means++ reduction comes up short of NumClusters and the pad runs -- the one path in RECLUSTER that
-- no other test reaches.
drop dataverse test if exists;
create dataverse test;
use test;

create type PT as closed { id : bigint, vec : [double] };
create dataset Points(PT) primary key id;
