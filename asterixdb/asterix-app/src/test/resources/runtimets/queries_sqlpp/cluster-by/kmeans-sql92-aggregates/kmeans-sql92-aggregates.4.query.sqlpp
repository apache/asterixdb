-- In HAVING, ORDER BY and a LET, and with a FILTER.
use test;
from Points as p cluster by p.vec as sc cluster as members
with {"clustering_algorithm": "K-Means",  "dimension": [2], "num_clusters": 2, "seed": 10 }
let big = count(p.id) filter (where p.id > 2)
having count(*) >= 3
select sc.cluster_id as cid, big
order by sum(p.id) desc;
