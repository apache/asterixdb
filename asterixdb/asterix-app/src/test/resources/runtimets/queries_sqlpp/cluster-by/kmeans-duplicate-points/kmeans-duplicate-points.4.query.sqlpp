-- Eleven asked for, ten distinct points available. The pad has zero-weight candidates here -- the duplicate
-- copies -- but they are the same points as the ten already chosen, so they add no new centre and the
-- shortfall is reported rather than filled with a duplicate.
use test;

from Points as p cluster by p.vec as sc cluster as members
with { "dimension": [2], "num_clusters": 11 }
select value sc.cluster_id
order by sc.cluster_id;
