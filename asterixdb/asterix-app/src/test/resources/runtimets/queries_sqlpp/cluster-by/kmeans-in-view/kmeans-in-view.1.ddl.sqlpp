-- CLUSTER BY inside a view body and a function body: both go through SqlppFunctionBodyRewriter, which
-- must run the CLUSTER BY rewrite like the query rewriter does. Same data and query as kmeans-syntax.
drop dataverse test if exists;
create dataverse test;
use test;
create type PointType as closed {
  id : integer,
  vec : [double]
};
create dataset Points(PointType) primary key id;
create view Clusters as
  from Points as p
  cluster by p.vec as sc
  cluster as members
  with { "dimension": [2], "num_clusters": 2 }
  select sc.cluster_id as cid,
         array_count(members) as cnt,
         array_count(sc.centroid) as dim;
create function clusters() {
  from Points as p
  cluster by p.vec as sc
  cluster as members
  with { "dimension": [2], "num_clusters": 2 }
  select sc.cluster_id as cid,
         array_count(members) as cnt,
         array_count(sc.centroid) as dim
};
