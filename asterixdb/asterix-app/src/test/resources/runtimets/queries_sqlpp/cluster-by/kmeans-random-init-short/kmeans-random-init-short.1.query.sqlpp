-- The Lloyd backstop, which is the only check on this path. initMode "random" seeds Lloyd directly from k
-- rows and never runs RECLUSTER, so the distinct-vector check that reports the shortfall for the default
-- init mode does not exist here. Three rows, eight clusters asked for: the seed is short, and it is Lloyd
-- that has to notice.

from [{"v":[1.0,1.0]}, {"v":[5.0,5.0]}, {"v":[9.0,9.0]}] as p
cluster by p.v as sc
cluster as members
with { "dimension": [2], "num_clusters": 8, "init_mode": "random" }
select value sc.cluster_id
order by sc.cluster_id;
