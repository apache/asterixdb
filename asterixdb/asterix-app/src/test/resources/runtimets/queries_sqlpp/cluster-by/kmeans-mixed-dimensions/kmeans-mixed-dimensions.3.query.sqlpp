-- Dimension 2: exactly the six 2-D rows take part, and they split into the two groups they were built as.
-- ids 7..12 are excluded -- the 3-D row by width, the rest by not being a vector.
use test;

from Points as p cluster by p.vec as sc cluster as members
with { "dimension": [2], "num_clusters": 2 }
select array_count(members) as cnt,
       (select value gi.p.id from members as gi order by gi.p.id) as ids
order by ids;
