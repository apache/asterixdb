-- 2000 x 128 doubles would be a ~2 MB data file.
use test;

insert into Points (
  select value { "id": i,
                 "vec": (select value (((i * 37 + d * 101 + (i*d) % 71) % 1000) / 1000.0)
                         from range(0, 127) as d) }
  from range(1, 2000) as i
);
