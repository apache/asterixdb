-- Requested in review: one dataset holding vectors of different widths alongside rows whose clustering
-- expression is not a vector at all, with the expected membership written down so the assignment can be
-- checked rather than eyeballed. Declared Dimension is what decides which rows take part, so the same data
-- clusters differently -- and correctly -- under two different declarations.
--
-- Open type: the bad rows could not be inserted under a closed one.
drop dataverse test if exists;
create dataverse test;
use test;

create type PointType as open { id : integer };
create dataset Points(PointType) primary key id;
create dataset IntPoints(PointType) primary key id;
