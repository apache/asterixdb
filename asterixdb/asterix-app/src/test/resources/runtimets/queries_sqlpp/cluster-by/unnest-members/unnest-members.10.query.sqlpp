-- No unnest at all: the cluster id and a second key both derived from the clustering. With statistics on,
-- the optimizer's sample query for the keys' distinct counts holds two copies of the k-means expansion,
-- and ExtractCommonOperatorsRule shares them; that needs the stages declared blocking
-- (AbstractKMeansStagePOperator#getInputOutputDependencyLabels), or its cluster walk never ends.
use test;
with mc as (
  from Points as p
  cluster by p.vec as sc cluster as members
  with { "clustering_algorithm": "K-Means", "dimension": [2], "num_clusters": 4, "seed": 7 }
  select sc.cluster_id as cid, members
)
from mc
group by mc.cid as cid, array_count(mc.members) as size
select cid, size
order by cid;
