-- CLUSTER BY 'seed'. Fixture: kmeans-budget-sensitivity's 2000 distinct 128-d vectors, which have no
-- cluster structure, so the result is decided by the seeded draws rather than by an obvious clustering.
drop dataverse test if exists;
create dataverse test;
use test;

create type PT as closed {
  id : bigint,
  vec : [double]
};
create dataset Points(PT) primary key id;
