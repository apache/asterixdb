-- The list is read twice, once unnested and once whole: the shortcut must stand aside and the list be
-- built, and the answer is the same either way.
use test;
with mc as (
  from Points as p
  cluster by p.vec as sc cluster as members
  with { "clustering_algorithm": "K-Means", "dimension": [2], "num_clusters": 4, "seed": 7 }
  select sc.cluster_id as cid, members
)
from mc, mc.members as m
group by mc.cid as cid, array_count(mc.members) as size
select cid, size, count(*) as n
order by cid;
