-- Integer-written and mixed-tag vectors must produce a real centroid, not NULL. The CENTROID aggregate once
-- accepted DOUBLE elements alone while every other reader of a vector took the whole numeric family, so
-- these rows clustered and then had no centroid to show for it.
use test;

from IntPoints as p
cluster by p.vec as sc
with {"clustering_algorithm": "K-Means","dimension": [2], "num_clusters": 2 }
select sc.cluster_id as cid, sc.centroid as centroid
order by cid;
