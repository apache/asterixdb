-- Arm 3: 256 KB = 8 frames, twice the minimum. A middle budget spills the same structures at different
-- boundaries -- 247-vector blocks and windows rather than 123 -- so agreeing with both neighbours shows
-- the result does not depend on WHERE the boundaries fall, only that the order across them is fixed.
use test;

set `compiler.clusterbymemory` "256KB";

from Points as p
cluster by p.vec as sc
cluster as members
with { "dimension": [128], "num_clusters": 64 }
select (select value gi.p.id from members as gi order by gi.p.id) as ids,
       array_count(members) as cnt,
       sc.cluster_radius as radius
order by ids;
