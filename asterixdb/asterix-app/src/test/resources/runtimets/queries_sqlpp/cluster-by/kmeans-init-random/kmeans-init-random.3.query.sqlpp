use test;

-- Cluster sizes, sorted, plus the total. Deterministic: the k seeds are the k smallest row hashes, a pure
-- function of the data set, and Lloyd is deterministic from there. Seeding from the k lexicographically
-- smallest vectors instead would place all k centroids inside one group and change this output.
select array_count(members) as cnt
from (
  from Points as p
  cluster by p.vec as sc
  cluster as members
  with { "dimension": [2], "num_clusters": 4, "init_mode": "random" }
  select members
) as c
order by cnt;
