use test;

-- No initMode: the default k-means|| initialization -- oversampling, then the weighted k-means++ reduction of
-- the candidate pool down to k. Four groups of 40 is the whole assertion: reducing that pool by any rule that
-- ignores distance seats several centroids in one group and leaves another empty, which shows up here as
-- unequal counts.
select array_count(members) as cnt
from (
  from Points as p
  cluster by p.vec as sc
  cluster as members
  with { "clustering_algorithm": "K-Means", "dimension": [2], "num_clusters": 4 }
  select members
) as c
order by cnt;
