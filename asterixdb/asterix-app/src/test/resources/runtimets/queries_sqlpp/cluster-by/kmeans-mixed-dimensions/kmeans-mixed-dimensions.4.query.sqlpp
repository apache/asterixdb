-- The same data under Dimension 3: now only id 7 qualifies, and the six 2-D rows are the excluded ones.
-- The opposite verdict on identical input, which is the point of declaring the width.
use test;

from Points as p cluster by p.vec as sc cluster as members
with { "clustering_algorithm": "K-Means", "dimension": [3], "num_clusters": 1 }
select array_count(members) as cnt,
       (select value gi.p.id from members as gi order by gi.p.id) as ids
order by ids;
