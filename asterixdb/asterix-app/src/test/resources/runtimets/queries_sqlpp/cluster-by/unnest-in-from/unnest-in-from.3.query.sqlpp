-- Four equal counts of 30: the unnested vectors were clustered and the year predicate applied.

use test;

select array_count(members) as cnt
from (
  from Movies as m, m.reviews as re
  where m.movie_year < 2020
  cluster by re.vec as sc
  cluster as members
  with { "dimension": [2], "num_clusters": 4 }
  select members
) as c
order by cnt;
