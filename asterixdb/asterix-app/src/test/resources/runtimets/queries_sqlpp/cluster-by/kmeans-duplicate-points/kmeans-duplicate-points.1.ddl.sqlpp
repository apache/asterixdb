-- Duplicate points are the only way a candidate ends up attracting nothing: a candidate wins its own row
-- unless an earlier candidate sits at distance zero from it. This fixture puts several copies of each
-- point in the data so duplicates reach the candidate pool, which is the regime where the pad has
-- zero-weight candidates to draw from.
drop dataverse test if exists;
create dataverse test;
use test;

create type PT as closed { id : bigint, vec : [double] };
create dataset Points(PT) primary key id;
