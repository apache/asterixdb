-- Seedless execution 1.
use test;
set `compiler.groupmemory` "4MB";
insert into Runs (
  select 1 as run_no,
         (from Points as p cluster by p.vec as sc cluster as members
          with { "clustering_algorithm": "K-Means", "dimension": [128], "num_clusters": 64 }
          select value (select value gi.p.id from members as gi order by gi.p.id) order by sc.centroid) as ids
);
