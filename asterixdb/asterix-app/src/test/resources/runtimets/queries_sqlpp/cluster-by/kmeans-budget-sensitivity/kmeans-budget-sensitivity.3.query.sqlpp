-- Arm 1: the default budget (32 MB = 1024 frames). A frame holds 123 vectors of this width, so the
-- budget covers 31,655 -- more than the 640-candidate pool, the 640 accumulator slots and every sort,
-- so nothing spills. This is the reference the other two arms must reproduce exactly.
use test;

from Points as p
cluster by p.vec as sc
cluster as members
with { "clustering_algorithm": "K-Means", "dimension": [128], "num_clusters": 64 }
select (select value gi.p.id from members as gi order by gi.p.id) as ids,
       array_count(members) as cnt
order by ids;
