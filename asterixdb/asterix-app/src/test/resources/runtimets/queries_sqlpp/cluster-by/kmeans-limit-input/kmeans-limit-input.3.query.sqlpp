use test;

-- A global LIMIT collapses its input to one partition, and the stages follow it: one loop instance on that
-- partition, no repartition, the group-by above it unpartitioned too. Every row placed exactly once, into k
-- clusters. (This used to be repartitioned into the compute domain through an unseeded random exchange,
-- which is why only invariants are asserted here: the clustering itself was not fixed across runs.)
select count(*) as clusters, sum(cnt) as total
from (
  from (select value p from Points p order by p.id limit 100) as t
  cluster by t.vec as sc
  cluster as members
  with { "clustering_algorithm": "K-Means", "dimension": [2], "num_clusters": 2, "seed": 10 }
  select array_count(members) as cnt
) as c;
