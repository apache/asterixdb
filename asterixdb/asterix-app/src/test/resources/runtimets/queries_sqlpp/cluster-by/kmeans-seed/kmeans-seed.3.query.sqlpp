-- Seed 42. Pins all three seeded choices at once: the initial-centre row key, the oversampling draws
-- and RECLUSTER's roulette. A leak at any of them changes the membership.
use test;

from Points as p
cluster by p.vec as sc
cluster as members
with { "dimension": [128], "num_clusters": 64, "seed": 42 }
select (select value gi.p.id from members as gi order by gi.p.id) as ids,
       array_count(members) as cnt
order by ids;
