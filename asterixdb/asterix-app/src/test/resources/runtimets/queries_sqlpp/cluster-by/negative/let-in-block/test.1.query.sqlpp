-- The block's LET is not yet supported with CLUSTER BY (its bindings would need re-scoping into
-- every emitted clustering subquery); must be rejected at compile time.
from [{"x": [1.0, 2.0]}] as r
let y = r.x
cluster by y as sc
with { "clustering_algorithm": "K-Means", "dimension": [2], "num_clusters": 2 }
select sc.cluster_id;
