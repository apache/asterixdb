-- The CLUSTER BY memory budget is a real, live knob, not a value the stages ignore: a budget below the
-- declared minimum of 4 frames is rejected before the query runs. This is what makes the
-- kmeans-budget-sensitivity arms meaningful -- if `compiler.clusterbymemory` were unregistered or
-- silently dropped, those arms would all run at the default budget and agree trivially.
set `compiler.clusterbymemory` "64KB";

from [{"v": [1.0, 2.0]}, {"v": [3.0, 4.0]}] as p
cluster by p.v as sc
cluster as members
with { "dimension": [2], "num_clusters": 2 }
select value sc.cluster_id;
