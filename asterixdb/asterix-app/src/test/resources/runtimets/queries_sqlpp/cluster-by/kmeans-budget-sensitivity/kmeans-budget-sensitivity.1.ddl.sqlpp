-- CLUSTER BY budget sensitivity: the same clustering must come out byte-identical whether the stages
-- hold their working sets in memory or spill them, because every spilling path was built to preserve
-- the order its in-memory form produced. 128 dimensions and k=64 are chosen so the arithmetic below
-- leaves no doubt that the small budget really does spill -- see the .4 query.
drop dataverse test if exists;
create dataverse test;
use test;

create type PT as closed {
  id : bigint,
  vec : [double]
};
create dataset Points(PT) primary key id;
