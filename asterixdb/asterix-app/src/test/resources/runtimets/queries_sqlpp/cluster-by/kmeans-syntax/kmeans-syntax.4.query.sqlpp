-- Members normally hold one field per FROM binding, but cluster_radius aggregates a pre-group distance
-- binding, and only group fields can be aggregated -- so asking for the radius puts $__cbdist in members
-- too. Pinned so the exception stays visible; see SqlppClusterByVisitor.

use test;

select value (
  select value object_names(mem)
  from (
    from Points as p
    cluster by p.vec as sc
    cluster as members
    with { "dimension": [2], "num_clusters": 2 }
    select members, sc.cluster_radius as radius
  ) as c
  unnest c.members as mem
  limit 1
)[0];
