-- Filters that were pushed between the UNNEST and the operator: one on the cluster id (constant across a
-- cluster's rows, so it goes back on top of the per-row form), one on the member itself.
use test;
with mc as (
  from Points as p
  cluster by p.vec as sc cluster as members
  with { "clustering_algorithm": "K-Means", "dimension": [2], "num_clusters": 4, "seed": 7 }
  select sc.cluster_id as cid, members
)
from mc, mc.members as m
where mc.cid >= 2 and m.p.id % 2 = 1
select mc.cid as cid, m.p.id as id
order by cid, id;
