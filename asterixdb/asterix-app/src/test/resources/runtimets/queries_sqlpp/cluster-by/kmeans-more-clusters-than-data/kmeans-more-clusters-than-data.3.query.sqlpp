-- CLUSTER BY execution test: distributed k-means (SQL++ form) on a tiny 2-D dataset. Two well-separated
-- k equal to the number of distinct points still succeeds: six candidates, six means, no shortfall.
use test;

from Points as p cluster by p.vec as sc cluster as members
with { "clustering_algorithm": "K-Means", "dimension": [2], "num_clusters": 6 }
select array_count(members) as cnt
order by cnt;
