-- The two seedless executions drew different seeds.
use test;
from Runs as r1, Runs as r2
where r1.run_no = 1 and r2.run_no = 2
select value (array_count(r1.ids) = 64 and array_count(r2.ids) = 64 and r1.ids != r2.ids);
