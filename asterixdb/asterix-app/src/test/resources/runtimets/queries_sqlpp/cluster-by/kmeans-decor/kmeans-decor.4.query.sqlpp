-- In HAVING, ORDER BY, inside an aggregate and in a LET after the clause.
use test;
with lo as 1, tag as "c"
from Points as p cluster by p.vec as sc cluster as members
with {"clustering_algorithm": "K-Means",  "dimension": [2], "num_clusters": 2, "seed": 10 }
let label = tag || string(sc.cluster_id)
having count(*) > lo
select label, count(p.id) + lo as n
order by lo, label;
