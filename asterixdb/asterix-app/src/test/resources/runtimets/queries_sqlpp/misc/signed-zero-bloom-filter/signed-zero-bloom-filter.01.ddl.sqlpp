/*
 * Description: -0.0 equals 0.0, so a bloom filter must not rule out one when the other is stored.
 */

DROP DATAVERSE test IF EXISTS;
CREATE DATAVERSE test;
USE test;

CREATE TYPE DoubleKeyType AS { k: double };
CREATE TYPE FloatKeyType AS { k: float };

CREATE DATASET FlushedZero(DoubleKeyType) PRIMARY KEY k;
CREATE DATASET FlushedNegativeZero(DoubleKeyType) PRIMARY KEY k;
CREATE DATASET FlushedFloatZero(FloatKeyType) PRIMARY KEY k;
CREATE DATASET FlushedDelete(DoubleKeyType) PRIMARY KEY k;
