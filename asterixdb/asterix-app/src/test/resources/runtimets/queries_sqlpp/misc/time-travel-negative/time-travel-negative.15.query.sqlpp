use tt;
// every function in the value is evaluated while the query is compiled, uuid() included; the value it
// yields is of type uuid, which is neither an integer nor a string, so it is rejected before anything
// could try to use it as a snapshot id
// expect: ASX1265, reporting uuid
select value d.uid from ds as d AT SNAPSHOT uuid();
