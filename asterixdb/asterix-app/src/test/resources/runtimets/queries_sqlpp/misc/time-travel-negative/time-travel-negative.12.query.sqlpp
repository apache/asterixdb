use tt;

// the value is resolved before the FROM term opens its own scope, so the term cannot see the
// variable it is itself binding. Expect ASX1073 "undefined identifier d" pointing at the value,
// not ASX1106 "expected constant value" pointing at the whole clause: had the value been resolved
// inside the scope, d would bind to the term's own item and become a per-row field access, which
// fails much later and much less helpfully
select value d.uid from ds as d AT SNAPSHOT d.uid;
