use tt;
// the JOIN clause validates its own value, not only the FROM term
// expect: ASX1266, raised for the JOIN clause rather than the FROM term
select value d.uid from ds as d join ds as e AT SNAPSHOT get_job_param("x") on d.uid = e.uid;
