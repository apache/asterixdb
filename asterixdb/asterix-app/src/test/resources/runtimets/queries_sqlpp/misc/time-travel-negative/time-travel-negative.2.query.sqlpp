use tt;
// a time travel value is resolved while the query is compiled, and a job parameter exists only once the
// job runs, so this value can never be produced here
// expect: ASX1266, naming the value that could not be resolved
select value d.uid from ds as d AT SNAPSHOT get_job_param("x");
