/* flushing puts the keys behind bloom filters */
USE test;

INSERT INTO FlushedZero ({ 'k': 0.0, 'x': 1 });
INSERT INTO FlushedNegativeZero ({ 'k': -0.0, 'x': 2 });
INSERT INTO FlushedFloatZero ({ 'k': float('0.0'), 'x': 3 });
INSERT INTO FlushedDelete ({ 'k': -0.0, 'x': 6 });
ANALYZE DATASET FlushedZero;
ANALYZE DATASET FlushedNegativeZero;
ANALYZE DATASET FlushedFloatZero;
ANALYZE DATASET FlushedDelete;
