/*
 * Description  : ANALYZE builds the sample index by bulk loading whole documents into a row format
 *              : BTree. A document larger than a page needs a page spanning several slots, and such
 *              : a page carries one header for all of them. On cloud storage the writes are mirrored
 *              : to an append-only writer, so the bytes the page leaves unwritten at its tail used
 *              : to desynchronize it and the next page write was rejected as misaligned (MB-73296).
 * Expected Res : Success
 */

drop dataverse test if exists;
create dataverse test;
use test;

create dataset ds(id uuid not unknown) open type primary key `id` autogenerated;
