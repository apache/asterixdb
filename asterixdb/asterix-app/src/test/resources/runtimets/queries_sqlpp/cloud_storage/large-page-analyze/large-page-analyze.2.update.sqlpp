use test;

-- The buffer cache page is 32KB here and an element costs about 14 bytes, so a 4000 element array
-- makes a document of roughly 56KB. That is more than one page, so the sample index bulk load has to
-- take a page spanning two slots for it, which is the shape that failed. The reported case used a
-- 32768 element array, which is the same shape with more frames but exceeds this configuration's
-- sort budget.
INSERT INTO ds (
    SELECT VALUE { "k": i, "arr": (SELECT VALUE j FROM range(1, 4000) j) }
    FROM range(1, 5) i
);
