/*
 * Description  : The WITH alias referenced inside a subquery over the group variable: it is
 *                the array, not the member's field, so each element is MISSING (y.t.b is
 *                the member's field).
 * Expected Res : Success
 */

WITH t AS (FROM [{"a":1,"b":10},{"a":1,"b":20},{"a":2,"b":30}] AS x SELECT x.a, x.b)
FROM t
GROUP BY t.a GROUP AS g
SELECT a, (FROM g AS y SELECT VALUE t.b) AS bs
ORDER BY a;
