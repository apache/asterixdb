/*
 * Description  : An outer alias shadowed by the FROM of a subquery two levels down, with a
 *                GROUP BY in between. The reference after the innermost GROUP BY reads the
 *                outer row, so the enclosing GROUP BY has to carry the outer variable through
 *                although the innermost block binds the same name.
 * Expected Res : Success
 */

FROM [{"id": 1, "target": 7}, {"id": 2, "target": 9}] AS s
SELECT s.id,
       (FROM [{"month": 1, "category": "x"}, {"month": 1, "category": "y"}] AS m
        GROUP BY m.month
        SELECT VALUE (FROM [{"category": "x", "target": 1}, {"category": "y", "target": 2}] AS s
                      GROUP BY s.category
                      SELECT VALUE s.target)) AS r
ORDER BY s.id;
