/*
 * Description  : A field of the WITH alias inside a window function after GROUP BY: the
 *                argument is MISSING, so the sum is null.
 * Expected Res : Success
 */

WITH t AS (FROM [{"a":1,"b":10},{"a":1,"b":20},{"a":2,"b":30}] AS x SELECT x.a, x.b)
FROM t
GROUP BY t.a
SELECT a, SUM(t.b) OVER () AS tot
ORDER BY a;
