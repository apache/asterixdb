/*
 * Description  : An outer variable (WITH alias, top-level LET, enclosing query variable)
 *                referenced after GROUP BY while a FROM variable of the block has the same
 *                name. After the GROUP BY the name denotes the outer variable again, so the
 *                reference reads that variable, not an arbitrary row of the block. Here: a
 *                field of the WITH alias, which is an array, so the field is MISSING.
 * Expected Res : Success
 */

WITH t AS (FROM [{"a":1,"b":10},{"a":1,"b":20},{"a":2,"b":30}] AS x SELECT x.a, x.b)
FROM t
GROUP BY t.a
SELECT a, t.b AS b
ORDER BY a;
