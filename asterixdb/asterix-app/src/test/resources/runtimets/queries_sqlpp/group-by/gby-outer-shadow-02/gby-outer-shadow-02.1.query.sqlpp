/*
 * Description  : The shapes of gby-outer-shadow-01-error without the name clash, and
 *                references that resolve through the group variable. Here: an enclosing
 *                query alias referenced after the subquery GROUP BY.
 * Expected Res : Success
 */

FROM [{"b":5}] AS o
SELECT o.b AS outer_b,
       (FROM [{"a":1,"b":10},{"a":1,"b":20},{"a":2,"b":30}] AS r
        GROUP BY r.a
        SELECT a, o.b AS b
        ORDER BY a) AS inr;
