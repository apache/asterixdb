/*
 * Description  : An undefined name inside a subquery over the group variable resolves
 *                as a field of the subquery variable.
 * Expected Res : Success
 */

FROM [{"a":1,"b":10},{"a":1,"b":20},{"a":2,"b":30}] AS t
GROUP BY t.a GROUP AS g
SELECT a, (FROM g AS y SELECT VALUE t.b) AS bs
ORDER BY a;
