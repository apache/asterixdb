// A search whose collection is also joined: the vector index and the join index are independent
// opportunities and both are expected to be advised from the one query.

DROP DATAVERSE test IF EXISTS;
CREATE DATAVERSE test;
USE test;

CREATE TYPE MovieType AS {
  id: int,
  year: int,
  code: int,
  embedding: [double]
};
CREATE TYPE RatingType AS {
  rid: int,
  movie_code: int,
  stars: int
};
CREATE DATASET MovieSmall(MovieType) PRIMARY KEY id;
CREATE DATASET Ratings(RatingType) PRIMARY KEY rid;
