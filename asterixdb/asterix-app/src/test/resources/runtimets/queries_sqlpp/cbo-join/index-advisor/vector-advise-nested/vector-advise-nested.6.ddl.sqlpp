// Advice is only useful if it runs as reported: this is the statement recommended for the previous query,
// with only its database-qualified name rewritten to the dataverse spelling this test suite uses. It runs
// last so the searches above are advised against a dataset that has no vector index.

USE test;

CREATE INDEX idx_adv_vector_meta_embedding ON `test`.`MovieNested`(`meta`.`embedding` VECTOR) INCLUDE (`genre`,`year`) TYPE VTREE WITH {"dimension": 4, "similarity": "cosine"};
