// Every cluster probed and thirty candidates collected per requested row, all of them fetched and reranked
// because the projected field is not in the index: the data scan is cheaper, so nothing is advised.

USE test;

ADVISE SELECT VALUE m.year
FROM Vec m
ORDER BY ann_distance(m.embedding, [0.0, 0.0, 0.0, 0.0], "euclidean", 1.0, 30)
LIMIT 10;
