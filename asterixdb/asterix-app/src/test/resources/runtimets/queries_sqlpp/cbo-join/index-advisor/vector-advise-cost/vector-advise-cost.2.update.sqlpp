USE test;

// Four hundred rows in two well separated vector clusters; `year` is unique per row.
INSERT INTO Vec (
  SELECT VALUE {
    "id": i,
    "year": 1600 + i,
    "embedding": CASE WHEN i <= 200 THEN [0.0, 0.0, 0.0, i / 100.0] ELSE [10.0, 10.0, 10.0, i / 100.0] END
  }
  FROM range(1, 400) i
);
