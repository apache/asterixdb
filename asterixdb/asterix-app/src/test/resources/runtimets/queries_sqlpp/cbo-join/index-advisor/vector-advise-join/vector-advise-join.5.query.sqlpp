// The same search placed ABOVE the join ranks joined rows, not the rows of one collection, so no vector
// index can serve it; the join is still advised one.

USE test;

ADVISE SELECT m.id, r.stars
FROM MovieSmall m JOIN Ratings r ON r.movie_code = m.code
WHERE m.code < 5
ORDER BY ann_distance(m.embedding, [0.0, 0.0, 0.0, 0.0], "euclidean", 1.0)
LIMIT 3;
