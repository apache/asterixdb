USE testcpk;

// Exact top-3 with a pushed INCLUDE filter over a composite PK. Projecting the
// non-indexed `title` forces the lookup-and-rerank shape (where the pushdown rule
// fires); min_probe_fraction 1.0 scans every cluster, so the result is independent of
// centroid placement. year > 2000 admits (1,11)..(1,15) at distances 1.1..1.5 plus all
// of group id1=2 at distance >= sqrt(300); expected: [1,11], [1,12], [1,13]. Before
// the composite-PK offset fix, the pushed filter read PK column id2 (<= 15) instead of
// year and admitted nothing.
SELECT VALUE [m.id1, m.id2, m.title]
FROM MovieCpk m
WHERE m.year > 2000
ORDER BY ann_distance(m.embedding, [0.0, 0.0, 0.0, 0.0], "euclidean", 1.0)
LIMIT 3;
