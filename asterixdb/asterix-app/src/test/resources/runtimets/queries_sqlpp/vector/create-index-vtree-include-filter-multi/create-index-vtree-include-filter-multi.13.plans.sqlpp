-- param compile-only:string=true
-- param optimized-logical-plan:string=true
SET `compiler.cbo` "false";

// The .10 query as a plan assertion. The .10 result is the same whichever plan is chosen, so only this
// pins the claim the record constructor is there to make: a pushed condition may contain an expression
// a later rule has to type, and the index-only plan still carries it.
SELECT VALUE m.id
FROM test.MovieMulti m
WHERE {"y": m.year} = {"y": 2006}
ORDER BY ann_distance(m.embedding, [0.0, 0.0, 0.0, 0.0], "euclidean", 1.0)
LIMIT 3;
