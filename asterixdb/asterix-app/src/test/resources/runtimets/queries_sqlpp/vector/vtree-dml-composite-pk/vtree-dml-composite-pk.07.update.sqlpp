// Replacing one of the pair moves it behind its sibling, which exercises the previous-tuple key
// on the upsert delete as well as the new key on the insert.
USE testcpk;
UPSERT INTO MovieCpk ([{"id1": 1, "id2": 101, "embedding": [0.0, 0.0, 0.0, 0.5]}]);
