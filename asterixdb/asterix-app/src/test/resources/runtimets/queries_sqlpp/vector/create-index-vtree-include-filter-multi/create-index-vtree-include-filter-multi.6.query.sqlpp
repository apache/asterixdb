USE test;
// Flipping only the second predicate must flip the answer to the odd ids 7, 9, 11. A pushdown that
// bound the two filter variables to each other's physical column would still satisfy .5 by luck; it
// cannot satisfy both .5 and this.
SELECT VALUE m.id
FROM MovieMulti m
WHERE m.year > 2005 AND m.rating = 1
ORDER BY ann_distance(m.embedding, [0.0, 0.0, 0.0, 0.0], "euclidean", 1.0)
LIMIT 3;
