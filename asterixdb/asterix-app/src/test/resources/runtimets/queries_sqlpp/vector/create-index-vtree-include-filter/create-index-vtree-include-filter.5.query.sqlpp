USE test;
// PK-only projection (SELECT VALUE m.id) + WHERE on the INCLUDE field `year`. min_probe_fraction 1.0
// scans every cluster, so the expected result is clustering-independent. Filtered set is ids 6..30;
// nearest 3 to [0,0,0,0] are the near-origin ids 6, 7, 8. Before the guard this returned zero rows.
SELECT VALUE m.id
FROM MovieSmall m
WHERE m.year > 2005
ORDER BY ann_distance(m.embedding, [0.0, 0.0, 0.0, 0.0], "euclidean", 1.0)
LIMIT 3;
