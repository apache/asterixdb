USE test;

// Above compiler.vector.index.max.num.clusters, which is checked before any rule derived from the
// collection: the k-means holds every centroid in memory, so this bound holds whatever the data says.
CREATE INDEX idx_emb
  ON MovieSmall(embedding VECTOR)
  TYPE VTREE
  WITH { "dimension": 4, "similarity": "euclidean", "num_clusters": 70000, "seed": 42 };
