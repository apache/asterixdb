// The rows the index actually leaves out, using the accounting query the isvector javadoc
// recommends. Negating the predicate alone is not enough: isvector answers unknown for a null or
// absent embedding, and NOT unknown is unknown, which WHERE drops.
USE testue;
SELECT VALUE m.id
FROM MovieUE m
WHERE NOT if_missing_or_null(isvector(m.embedding, 4), false)
ORDER BY m.id;
