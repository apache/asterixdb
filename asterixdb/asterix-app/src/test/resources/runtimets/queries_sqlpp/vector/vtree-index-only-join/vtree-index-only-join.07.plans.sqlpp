-- param compile-only:string=true
-- param optimized-logical-plan:string=true

// CBO costs depend on the cluster shape, so it is off for a stable plan.
SET `compiler.cbo` "false";

// Step 5 also projecting title, which the index does not emit: the primary lookup on Docs stays.
FROM (FROM test.Docs d
      SELECT d.id, d.year, d.title
      ORDER BY ann_distance(d.embedding, [0.0, 0.0, 0.0, 0.0], "euclidean", 1.0)
      LIMIT 3) t
JOIN test.Labels l ON t.id = l.id
SELECT l.label, t.year, t.title
ORDER BY t.year;
