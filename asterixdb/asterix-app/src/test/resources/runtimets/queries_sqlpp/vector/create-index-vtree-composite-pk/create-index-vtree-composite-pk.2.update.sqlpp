USE testcpk;

// Two well-separated groups. Group (id1=1): near the origin, years 1991..2005.
// Group (id1=2): near [10,10,10,*], years 2001..2015. Distances to the query point
// [0,0,0,0] are unique by construction, so top-k is fully hand-derivable.
// The `year` values (>= 1991) never overlap the id2 values (<= 15): a filter that is
// mistakenly evaluated against a PK column admits nothing, making the bug observable.
INSERT INTO MovieCpk ([
  {"id1": 1, "id2": 1, "year": 1991, "title": "t1_1", "embedding": [0.0, 0.0, 0.0, 0.1]},
  {"id1": 1, "id2": 2, "year": 1992, "title": "t1_2", "embedding": [0.0, 0.0, 0.0, 0.2]},
