USE test;

// Every WITH parameter is given a non-default value, and one INCLUDE path is nested, so the
// expected record below shows the actual persisted value of each rather than a default that
// would also be produced by dropping the field.
CREATE INDEX idx_emb
  ON MovieSmall(embedding VECTOR)
  INCLUDE (title, info.year)
  TYPE VTREE
  WITH {
    "dimension": 4,
    "similarity": "cosine",
    "quantization": "SQ4",
    "num_clusters": 2,
    "train_list_fraction": 1.0,
    "seed": 42,
    "epsilon": 0.5,
    "cross_pollination_m": 3,
    "rng_factor": 1.5
  }
  EXCLUDE UNKNOWN KEY;
