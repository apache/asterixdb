// The plain negation of isvector. It is a MissingNullInOutFunction, so it answers null for a null
// or absent embedding, and NOT null is null, which WHERE drops. The query therefore names the
// wrong-dimension and non-numeric rows only.
USE testue;
SELECT VALUE m.id FROM MovieUE m WHERE NOT isvector(m.embedding, 4) ORDER BY m.id;
