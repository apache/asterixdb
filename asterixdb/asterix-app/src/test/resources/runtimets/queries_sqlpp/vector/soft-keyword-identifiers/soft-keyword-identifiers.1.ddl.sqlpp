// ASTERIXDB-3771 review (Ian Maxon): 'vector' and 'vtree' are soft keywords, so they must be usable as
// ordinary identifiers. This declares fields literally named 'vector' and 'vtree'; before the soft-keyword
// change these were reserved tokens and this DDL failed to parse.
DROP DATAVERSE test IF EXISTS;
CREATE DATAVERSE test;
USE test;

CREATE TYPE T AS {
  id: int,
  vector: bigint,
  vtree: string
};

CREATE DATASET ds(T) PRIMARY KEY id;
