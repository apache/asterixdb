USE test;
// similarity given as the alias "L2" (not the canonical "euclidean"); validateSimilarity must accept it
// via VectorSimilarityMetric.fromAlias and normalize the stored value to the canonical spelling.
CREATE INDEX idx_emb
  ON MovieSmall(embedding VECTOR)
  TYPE VTREE
  WITH { "dimension": 4, "similarity": "L2", "num_clusters": 2, "train_list_fraction": 1.0, "seed": 42 }
  EXCLUDE UNKNOWN KEY;
