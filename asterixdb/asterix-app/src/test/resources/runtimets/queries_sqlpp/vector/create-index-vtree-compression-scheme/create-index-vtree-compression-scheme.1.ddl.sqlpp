// A vector index takes its own block compression scheme, as a BTREE does: the one its WITH clause names, or the
// configured default. The dataset is uncompressed, so an index that is compressed got it from its own clause.
DROP DATAVERSE test IF EXISTS;
CREATE DATAVERSE test;
USE test;

CREATE TYPE MovieType AS {
  id: int,
  title: string,
  info: { year: int },
  embedding: [double]
};

CREATE DATASET MovieSmall(MovieType) PRIMARY KEY id WITH {"storage-block-compression": {"scheme": "none"}};
