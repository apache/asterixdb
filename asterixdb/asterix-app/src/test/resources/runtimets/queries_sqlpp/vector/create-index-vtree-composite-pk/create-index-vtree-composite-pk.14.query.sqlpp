USE testcpk;

// WHERE spanning BOTH the primary key and an INCLUDE field. The PK conjunct wins the same way it does
// in .12: id1 = 1 becomes a primary-index range search and `year > 2000` is left as a residual SELECT
// above it, so the INCLUDE column is filtered from the materialized record rather than pushed into a
// vector cursor. Mixing a PK column into the predicate therefore costs the ANN path even though the
// other conjunct is exactly what INCLUDE is for. id1 = 1 keeps the near-origin group and year > 2000
// keeps id2 11..15 within it; nearest 3 are (1,11), (1,12), (1,13).
SELECT VALUE [m.id1, m.id2]
FROM MovieCpk m
WHERE m.id1 = 1 AND m.year > 2000
ORDER BY ann_distance(m.embedding, [0.0, 0.0, 0.0, 0.0], "euclidean", 1.0)
LIMIT 3;
