USE test;
// The .6 case with the projected column changed to the index's INCLUDE column, and nothing else.
// The search reads `year` out of the secondary tuple and returns it, so the ninety-row fetch and
// rerank that made the plain scan win there does not happen and the index wins instead.
EXPLAIN
SELECT VALUE m.year
FROM Vec m
ORDER BY ann_distance(m.embedding, [0.0, 0.0, 0.0, 0.0], "euclidean", 1.0, 30)
LIMIT 3;
