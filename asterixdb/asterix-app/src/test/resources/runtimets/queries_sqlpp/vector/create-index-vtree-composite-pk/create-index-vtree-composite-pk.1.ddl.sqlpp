// Regression test for composite-primary-key filter pushdown: the INCLUDE-field physical
// index in PushFilterIntoVectorSearchRule must skip ALL primary key columns, not just one.

DROP DATAVERSE testcpk IF EXISTS;
CREATE DATAVERSE testcpk;
USE testcpk;

CREATE TYPE MovieCpkType AS CLOSED {
  id1: int,
  id2: int,
  year: int,
  title: string,
  embedding: [double]
};

CREATE DATASET MovieCpk(MovieCpkType) PRIMARY KEY id1, id2;
