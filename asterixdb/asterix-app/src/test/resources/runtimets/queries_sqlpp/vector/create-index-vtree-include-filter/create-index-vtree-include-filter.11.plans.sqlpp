-- param compile-only:string=true
-- param optimized-logical-plan:string=true
SET `compiler.cbo` "false";
USE test;
// A predicate that reads no dataset field at all. Its variable set is empty, so every "is this variable
// safe" test passes vacuously; only asking whether the predicate can actually be bound catches it.
SELECT VALUE m.id
FROM MovieSmall m
WHERE random() > 0.5
ORDER BY ann_distance(m.embedding, [0.0, 0.0, 0.0, 0.0], "euclidean", 1.0)
LIMIT 3;
