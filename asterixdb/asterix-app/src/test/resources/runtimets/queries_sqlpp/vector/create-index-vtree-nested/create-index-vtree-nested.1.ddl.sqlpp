// Nested-path variant of create-index-vtree: the vector field lives one level deep (meta.embedding),
// exercising CreateIndexStatement path extraction (getProjectList().get(0).first) for a dotted key AND
// a dotted INCLUDE field, not just a flat reference.
DROP DATAVERSE test IF EXISTS;
CREATE DATAVERSE test;
USE test;

CREATE TYPE InnerType AS {
  embedding: [double],
  year: int
};

CREATE TYPE MovieType AS {
  id: int,
  meta: InnerType
};

CREATE DATASET MovieNested(MovieType) PRIMARY KEY id;
