-- param compile-only:string=true
-- param optimized-logical-plan:string=true
SET `compiler.cbo` "false";

// The .11 query as a plan assertion. Same reason as .13: if_null() in the predicate is the shape that
// broke when the select condition was created during the access-method phase, and a regression that
// dropped it back to lookup-and-rerank would leave the .11 result untouched.
SELECT VALUE m.id
FROM test.MovieMulti m
WHERE if_null(m.year, 0) > 2005 AND m.rating = 5
ORDER BY ann_distance(m.embedding, [0.0, 0.0, 0.0, 0.0], "euclidean", 1.0)
LIMIT 3;
