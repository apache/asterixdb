USE test;

// Distances to [0,0,0,0] grow with id, so the top 3 are ids 1-3.
INSERT INTO Docs ([
  {"id": 1, "year": 2001, "title": "a", "embedding": [0.0, 0.0, 0.0, 0.1]},
  {"id": 2, "year": 2002, "title": "b", "embedding": [0.0, 0.0, 0.0, 0.2]},
  {"id": 3, "year": 2003, "title": "c", "embedding": [0.0, 0.0, 0.0, 0.3]},
  {"id": 4, "year": 2004, "title": "d", "embedding": [0.0, 0.0, 0.0, 0.4]},
  {"id": 5, "year": 2005, "title": "e", "embedding": [10.0, 10.0, 10.0, 0.1]},
  {"id": 6, "year": 2006, "title": "f", "embedding": [10.0, 10.0, 10.0, 0.2]},
  {"id": 7, "year": 2007, "title": "g", "embedding": [10.0, 10.0, 10.0, 0.3]},
  {"id": 8, "year": 2008, "title": "h", "embedding": [10.0, 10.0, 10.0, 0.4]}
]);

INSERT INTO Labels ([
  {"id": 1, "label": "one"}, {"id": 2, "label": "two"}, {"id": 3, "label": "three"}, {"id": 4, "label": "four"},
  {"id": 5, "label": "five"}, {"id": 6, "label": "six"}, {"id": 7, "label": "seven"}, {"id": 8, "label": "eight"}
]);
