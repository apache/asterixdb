// Regression for a VTREE index-only plan bug: the dataset's primary key is sourced from META()
// and named "id", while the data record ALSO has its own unrelated field named "id". The two must
// never be confused when the vector-index-only optimization decides which projections are PK-safe.

DROP DATAVERSE test IF EXISTS;
CREATE DATAVERSE test;
USE test;

// 'id' is deliberately left UNDECLARED (the type is OPEN): a declared field would get devirtualized
// to positional field-access-by-index by an earlier rewrite rule, which would never reach the
// field-access-by-name check this regression targets. Leaving it open keeps m.id as a genuine
// field-access-by-name all the way to IntroduceTopKAccessMethodRule.
CREATE TYPE VecType AS OPEN {
  embedding: [double]
};

CREATE TYPE VecMetaType AS {
  id: int
};

CREATE DATASET VecMeta(VecType) WITH META(VecMetaType)
PRIMARY KEY META().id;

// Datasets with a meta part cannot be populated via INSERT/LOAD/COPY; a feed is required to set a
// literal meta id per record. Column 0 of the CSV is the meta id, column 1 is the escaped record.
CREATE FEED VecMetaStream WITH {
 "adapter-name" : "localfs",
 "reader" : "localfs",
 "parser" : "record-with-metadata",
 "type-name" : "VecType",
 "meta-type-name" : "VecMetaType",
 "path" : "asterix_nc1://data/csv/vector-meta-pk.csv",
 "format" : "csv",
 "delimiter" : ",",
 "record-format" : "adm",
 "record-index" : "1",
 "key-indexes" : "0",
 "key-indicators" : "1",
 "header" : "false"
};
