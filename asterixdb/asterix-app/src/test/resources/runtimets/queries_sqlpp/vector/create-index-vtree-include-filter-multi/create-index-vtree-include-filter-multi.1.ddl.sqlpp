// A conjunction over several INCLUDE fields, the shape a real filtered ANN query has. One filter
// variable per INCLUDE field is created, and each must be bound to its own physical column of the
// secondary tuple -- a single-field test cannot catch two of them being swapped. `title` additionally
// covers a string column, whose stored bytes compare differently from the integer ones, and
// `verified` covers a boolean one -- a type that is not legal as a BTREE or ARRAY key but is fine as a
// payload column that is only ever read to evaluate a pushed predicate.
DROP DATAVERSE test IF EXISTS;
CREATE DATAVERSE test;
USE test;
CREATE TYPE MovieType AS {
  id: int,
  year: int,
  rating: int,
  title: string,
  verified: boolean,
  embedding: [double]
};
CREATE DATASET MovieMulti(MovieType) PRIMARY KEY id;
