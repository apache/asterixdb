// A closed, non-optional vector field makes the distance builtins' inputs non-nullable, so their result
// type must itself admit NULL: a SELECT over them builds a closed record, which reads a NULL slot typed as
// a plain double back as 0.0.
DROP DATAVERSE test IF EXISTS;
CREATE DATAVERSE test;
USE test;

CREATE TYPE VectorType AS CLOSED {
  id: int,
  embedding: [double]
};

CREATE DATASET Vectors(VectorType) PRIMARY KEY id;
