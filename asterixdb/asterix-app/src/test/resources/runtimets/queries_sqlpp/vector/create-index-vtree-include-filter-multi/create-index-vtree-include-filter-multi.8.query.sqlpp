USE test;
// A STRING INCLUDE column: the pushed predicate is evaluated by the vector cursor over the stored
// column bytes, so a string comparison exercises a different comparator from the integer ones above.
// title = "t<id>", so this matches exactly one row and LIMIT 3 returns it alone.
SELECT VALUE m.id
FROM MovieMulti m
WHERE m.title = "t8"
ORDER BY ann_distance(m.embedding, [0.0, 0.0, 0.0, 0.0], "euclidean", 1.0)
LIMIT 3;
