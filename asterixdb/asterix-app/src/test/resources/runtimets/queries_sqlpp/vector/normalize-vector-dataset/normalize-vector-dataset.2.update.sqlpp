USE test;

// id 2 is id 1 scaled by 10, so both normalize to the same direction.
INSERT INTO Docs ([
  {"id": 1, "embedding": [3.0, 0.0, 4.0]},
  {"id": 2, "embedding": [30.0, 0.0, 40.0]},
  {"id": 3, "embedding": [1.0, 2.0, 2.0]},
  {"id": 4, "embedding": [-2.0, 1.0, 2.0]},
  {"id": 5, "embedding": [0.0, 0.0, 0.0]},
  {"id": 6, "embedding": [1.0, "x", 2.0]}
]);
