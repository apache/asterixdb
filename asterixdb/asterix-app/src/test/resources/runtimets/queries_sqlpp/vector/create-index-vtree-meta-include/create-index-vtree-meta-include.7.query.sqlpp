USE test;
// A WHERE on meta().id. It must not be evaluated against the record's `id` INCLUDE column: bound there it
// would compare 1..11 with 902 and return nothing. Correct answer: 903, 904, 905.
SELECT VALUE meta(m).id
FROM VecMeta m
WHERE meta(m).id > 902
ORDER BY ann_distance(m.embedding, [0.0, 0.0, 0.0, 0.0], "euclidean", 1.0)
LIMIT 3;
