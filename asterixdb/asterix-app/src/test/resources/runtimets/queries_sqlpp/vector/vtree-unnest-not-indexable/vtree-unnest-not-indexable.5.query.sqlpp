USE test;
// Only the primary key leaves the pipeline, so the projection is covered and this query used to
// reach the index-only plan, where the UNNEST read a source neutralized to MISSING and every row
// was dropped. The nearest 15 have no genres; the answer is 16, 17, 18.
SELECT VALUE m.id
FROM Movies m UNNEST m.genres g
ORDER BY ann_distance(m.embedding, [0.0, 0.0, 0.0, 0.0], "euclidean", 1.0)
LIMIT 3;
