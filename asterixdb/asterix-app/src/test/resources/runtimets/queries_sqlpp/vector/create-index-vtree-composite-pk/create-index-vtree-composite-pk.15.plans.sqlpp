-- param compile-only:string=true
-- param optimized-logical-plan:string=true
SET `compiler.cbo` "false";

// Plan for .14: BTREE_SEARCH on the primary index for the PK conjunct, STREAM_SELECT above it for the
// INCLUDE conjunct, exact distance, and no vector index-search. Contrast with .10, where the same
// INCLUDE predicate alone reaches the index-only plan and is evaluated by the vector cursor.
SELECT VALUE [m.id1, m.id2]
FROM testcpk.MovieCpk m
WHERE m.id1 = 1 AND m.year > 2000
ORDER BY ann_distance(m.embedding, [0.0, 0.0, 0.0, 0.0], "euclidean", 1.0)
LIMIT 3;
