// A stated train_list_fraction that leaves fewer training records per partition than the clusters
// derived for the collection is rejected at DDL time. Same collection shape as create-index-vtree.
DROP DATAVERSE test IF EXISTS;
CREATE DATAVERSE test;
USE test;
CREATE TYPE MovieType AS {
  id: int,
  embedding: [double]
};
CREATE DATASET MovieSmall(MovieType) PRIMARY KEY id;
