USE test;
// Meta PK and the record's INCLUDE column, both returned, with a WHERE on the column. Index-only.
// Records have id 1..11 and meta().id 901..911; filtered set is id 3..11, nearest 3 are 3, 4, 5.
SELECT VALUE [meta(m).id, m.id]
FROM VecMeta m
WHERE m.id > 2
ORDER BY ann_distance(m.embedding, [0.0, 0.0, 0.0, 0.0], "euclidean", 1.0)
LIMIT 3;
