// param max-warnings:json=100
//
// normalize_vector(v) with aliases (NORMALISE_VECTOR, VECTOR_NORMALIZE, VECTOR_NORMALISE).
// Non-happy paths mirror isvector's coverage (mixed, nested, empty, non-list, null, missing) but
// return null (with a warning) rather than false, matching cosine_similarity's zero-norm path.
// "m_missing" is absent.
{
  "a_1234":      normalize_vector([1, 2, 3, 4]),
  "b_34":        normalize_vector([3, 4]),
  "c_unit":      normalize_vector([0, 1]),
  "d_ints":      normalize_vector([1, 0, 0]),
  "e_alias_ise": normalise_vector([0, 1]),
  "f_alias_vn":  vector_normalize([0, 1]),
  "g_alias_vne": vector_normalise([0, 1]),
  "i_hyphen":    `normalize-vector`([0, 1]),
  "j_neg":       normalize_vector([-3, 4]),
  "k_one":       normalize_vector([5]),
  "l_null":      normalize_vector(null),
  "m_missing":   normalize_vector(missing),
  "n_empty":     normalize_vector([]),
  "o_not_list":  normalize_vector("x"),
  "p_mixed":     normalize_vector([1, "s"]),
  "q_zero":      normalize_vector([0, 0, 0]),
  "r_nan":       normalize_vector([double("NaN"), 1]),
  "s_inf":       normalize_vector([double("INF"), 0]),
  "t_null_elem": normalize_vector([1, null]),
  "u_nested":    normalize_vector([0.2, 0.1, [1], 0.3]),
  "v_all_string": normalize_vector(["a", "b", "c", "d"])
};
