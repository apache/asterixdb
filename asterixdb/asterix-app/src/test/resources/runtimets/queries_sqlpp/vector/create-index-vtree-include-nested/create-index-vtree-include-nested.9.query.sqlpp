USE test;
// A sibling of the INCLUDE column under the same parent: info.title is not info.year, so the predicate cannot
// be evaluated by the search and no vector index is offered. Filtered set is ids 2..30; nearest 3 are 2, 3, 4.
SELECT VALUE m.id
FROM MovieSmall m
WHERE m.info.title != "t1"
ORDER BY ann_distance(m.embedding, [0.0, 0.0, 0.0, 0.0], "euclidean", 1.0)
LIMIT 3;
