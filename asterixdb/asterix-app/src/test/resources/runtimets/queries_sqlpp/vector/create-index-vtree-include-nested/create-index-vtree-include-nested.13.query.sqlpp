USE test;
// The same leaf name under another parent: other.year is not info.year. A match on the leaf name alone would
// evaluate the predicate against the wrong column (info.year is 2000 + id; other.year is 1900 + id) and
// return 1, 2, 3. Correct: no vector index, filtered set ids 6..30, nearest 3 are 6, 7, 8.
SELECT VALUE m.id
FROM MovieSmall m
WHERE m.other.year > 1905
ORDER BY ann_distance(m.embedding, [0.0, 0.0, 0.0, 0.0], "euclidean", 1.0)
LIMIT 3;
