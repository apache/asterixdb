// The primary key comes from meta() and the record has a field of the SAME name, `id`, which is an
// INCLUDE column of the vector index. Neither may be served from the other: a predicate on meta().id
// is not evaluable by the search, and a projection of it binds to the primary key, not the column.
DROP DATAVERSE test IF EXISTS;
CREATE DATAVERSE test;
USE test;
CREATE TYPE VecType AS OPEN {
  id: int,
  embedding: [double]
};
CREATE TYPE VecMetaType AS {
  id: int
};
CREATE DATASET VecMeta(VecType) WITH META(VecMetaType)
PRIMARY KEY META().id;
CREATE FEED VecMetaStream WITH {
 "adapter-name" : "localfs",
 "reader" : "localfs",
 "parser" : "record-with-metadata",
 "type-name" : "VecType",
 "meta-type-name" : "VecMetaType",
 "path" : "asterix_nc1://data/csv/vector-meta-pk.csv",
 "format" : "csv",
 "delimiter" : ",",
 "record-format" : "adm",
 "record-index" : "1",
 "key-indexes" : "0",
 "key-indicators" : "1",
 "header" : "false"
};
