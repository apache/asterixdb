-- param compile-only:string=true
-- param optimized-logical-plan:string=true

// CBO cost estimates vary with the cluster shape (partition count / core count), which
// differs between a local run and CI. Disable the CBO so the plan is stable everywhere.
SET `compiler.cbo` "false";

// The .5 query again, as a plan assertion. A PK-only projection whose WHERE reads nothing but an
// INCLUDE field must take the INDEX-ONLY plan: the vector unnest-map carries "condition (...)" AND
// there is no BTREE_SEARCH above it, because the predicate is evaluated by the vector cursor and the
// distance comes off the cursor rather than from a refetched record. Before this, any WHERE on an
// INCLUDE field forced lookup-and-rerank, which fetches and reranks every candidate.
USE test;

SELECT VALUE m.id
FROM MovieSmall m
WHERE m.year > 2005
ORDER BY ann_distance(m.embedding, [0.0, 0.0, 0.0, 0.0], "euclidean", 1.0)
LIMIT 3;
