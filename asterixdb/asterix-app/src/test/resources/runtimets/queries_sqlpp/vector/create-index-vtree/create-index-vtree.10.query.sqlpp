USE test;

// Same exact top-3 as step 6, with the ann_distance arguments swapped. A distance is symmetric,
// so the query vector may be written on either side and the index search must still be built from
// the argument that is not the indexed field.
SELECT VALUE m.id
FROM MovieSmall m
ORDER BY ann_distance([0.0, 0.0, 0.0, 0.0], m.embedding, "euclidean", 1.0)
LIMIT 3;
