// With cross_pollination_m > 1 an index-only ANN plan dedups the search's primary keys, and it does so
// after the INCLUDE columns the query does not read have been dropped from the search's output. Both
// must hold at once: a query reading no INCLUDE column, and one reading only some of them.
DROP DATAVERSE test IF EXISTS;
CREATE DATAVERSE test;
USE test;
CREATE TYPE MovieType AS {
  id: int,
  year: int,
  rating: int,
  embedding: [double]
};
CREATE DATASET MovieCp(MovieType) PRIMARY KEY id;
