// TYPE is optional for a VECTOR field, but an explicit type that is not VTREE contradicts the
// annotation and must be rejected rather than quietly building a BTREE over the vector field.
DROP DATAVERSE test IF EXISTS;
CREATE DATAVERSE test;
USE test;

CREATE TYPE MovieType AS {
  id: int,
  embedding: [double]
};

CREATE DATASET MovieSmall(MovieType) PRIMARY KEY id;

CREATE INDEX idx_emb
  ON MovieSmall(embedding VECTOR)
  TYPE BTREE
  WITH { "dimension": 4, "similarity": "euclidean" }
  EXCLUDE UNKNOWN KEY;
