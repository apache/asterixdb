USE test;
// 'year' is undeclared, which is exactly the case where a user reaches for a type annotation. It is
// still not accepted: the INCLUDE field resolves to ANY from the schema on its own.
CREATE INDEX idx_emb
  ON MovieOpen(embedding VECTOR)
  INCLUDE (year: int)
  TYPE VTREE
  WITH { "dimension": 4, "similarity": "euclidean", "num_clusters": 2, "train_list_fraction": 1.0, "seed": 42 };
