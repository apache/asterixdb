USE test;
// Same as step 5 with the ann_distance arguments swapped: the query vector may be written on either
// side of a symmetric distance, and the filter pushdown must still see the same index search.
SELECT VALUE m.id
FROM MovieSmall m
WHERE m.year > 2005
ORDER BY ann_distance([0.0, 0.0, 0.0, 0.0], m.embedding, "euclidean", 1.0)
LIMIT 3;
