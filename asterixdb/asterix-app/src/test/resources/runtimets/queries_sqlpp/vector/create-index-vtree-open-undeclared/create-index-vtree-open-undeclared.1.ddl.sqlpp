// An UNDECLARED vector field on an OPEN type is a supported, indexable case. The vector DDL requires
// EXCLUDE UNKNOWN KEY, which skips records whose key is missing and indexes those that have it, so an
// open/undeclared embedding present in the records builds and queries normally (it does not fail with
// "no training vectors"). This test guards that behavior end to end.
DROP DATAVERSE test IF EXISTS;
CREATE DATAVERSE test;
USE test;

// OPEN type: 'embedding' is NOT declared; it exists only in the record data.
CREATE TYPE MovieType AS OPEN {
  id: int
};
CREATE DATASET MovieOpen(MovieType) PRIMARY KEY id;
