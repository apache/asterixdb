// Four shapes the index cannot represent, inserted after the build: null, a list holding a string,
// a value that is not a list at all, and no embedding field. Each row stays in the collection.
USE testue;
INSERT INTO MovieUE ([
  {"id": 101, "embedding": null},
  {"id": 102, "embedding": [0.1, "two", 0.3, 0.4]},
  {"id": 103, "embedding": "not a list"},
  {"id": 104}
]);
