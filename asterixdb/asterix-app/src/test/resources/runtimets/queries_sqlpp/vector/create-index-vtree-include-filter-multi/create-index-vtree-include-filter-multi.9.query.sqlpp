USE test;
// A BOOLEAN INCLUDE column, the shape the filtered-ANN perf workload uses (verified_purchase = true
// AND rating = 5). Boolean is not a legal BTREE or ARRAY key, but an INCLUDE column is not a key.
// verified is true when id is a multiple of 3, so this keeps 6, 12, 18, 24, 30 -- nearest 3 are
// 6, 12, 18.
SELECT VALUE m.id
FROM MovieMulti m
WHERE m.verified = true AND m.rating = 5
ORDER BY ann_distance(m.embedding, [0.0, 0.0, 0.0, 0.0], "euclidean", 1.0)
LIMIT 3;
