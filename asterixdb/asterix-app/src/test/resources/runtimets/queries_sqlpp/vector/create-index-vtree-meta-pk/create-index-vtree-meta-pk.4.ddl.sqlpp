USE test;

// Pin the k-means training RNG so index creation is reproducible run-to-run.
SET `compiler.vector.trainseed` "42";

CREATE INDEX idx_emb
  ON VecMeta(embedding VECTOR)
  TYPE VTREE
  WITH { "dimension": 4, "similarity": "euclidean", "num_clusters": 2, "train_list_fraction": 1.0 }
  EXCLUDE UNKNOWN KEY;
