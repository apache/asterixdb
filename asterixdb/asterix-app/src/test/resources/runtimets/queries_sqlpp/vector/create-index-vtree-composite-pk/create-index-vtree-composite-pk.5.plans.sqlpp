-- param compile-only:string=true
-- param optimized-logical-plan:string=true

// CBO cost estimates vary with the cluster shape (partition count / core count), which
// differs between a local run and CI. Disable the CBO so the plan is stable everywhere.
SET `compiler.cbo` "false";

// The optimized plan must show the year filter PUSHED into the vector index search:
// the vector unnest-map (index-search on idx_cpk_emb) carries "condition (...)"
// (PushFilterIntoVectorSearchRule). Projecting the non-indexed `title` forces the
// lookup-and-rerank shape, which is where the rule fires. Same query executed in .6.
USE testcpk;

SELECT VALUE [m.id1, m.id2, m.title]
FROM MovieCpk m
WHERE m.year > 2000
ORDER BY ann_distance(m.embedding, [0.0, 0.0, 0.0, 0.0], "euclidean", 1.0)
LIMIT 3;
