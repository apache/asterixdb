// An UNNEST between the vector search and the LIMIT drops a row whenever the array is empty, so the
// candidate set the search capped can run out before the LIMIT is satisfied. No vector index is
// offered for such a query (ASTERIXDB-3892); these queries must take the exact scan.
DROP DATAVERSE test IF EXISTS;
CREATE DATAVERSE test;
USE test;
CREATE TYPE MovieType AS {
  id: int,
  genres: [string],
  embedding: [double]
};
CREATE DATASET Movies(MovieType) PRIMARY KEY id;
