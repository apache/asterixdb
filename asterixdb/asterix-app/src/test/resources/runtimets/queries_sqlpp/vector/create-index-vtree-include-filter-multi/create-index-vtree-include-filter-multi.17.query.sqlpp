USE test;
// `embedding` is not an INCLUDE column, so the projection is not covered and the plan is
// lookup-and-rerank. rating = 5 on the even ids; nearest 3 are 2, 4, 6.
SELECT m.id, array_length(m.embedding) AS dim
FROM MovieMulti m
WHERE m.rating = 5
ORDER BY ann_distance(m.embedding, [0.0, 0.0, 0.0, 0.0], "euclidean", 1.0)
LIMIT 3;
