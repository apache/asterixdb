-- param compile-only:string=true
-- param optimized-logical-plan:string=true

// A DESC order-by asks for the farthest K, but the top-K cursor returns the nearest K. So
// IntroduceTopKAccessMethodRule must NOT rewrite this into a vector index search: the optimized
// plan falls back to a full scan and therefore does not name idx_emb. (Contrast with step 7, ASC.)
SELECT VALUE m.id
FROM test.MovieSmall m
ORDER BY ann_distance(m.embedding, [0.0, 0.0, 0.0, 0.0], "euclidean", 1.0) DESC
LIMIT 3;
