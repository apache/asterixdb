/*
 * Description: sanity check that meta().id (the actual PK) still resolves correctly (901, 902, 903)
 * and is unaffected by the fix to the "id" collision case in step 5.
 */

USE test;

SELECT VALUE meta(m).id
FROM VecMeta m
ORDER BY ann_distance(m.embedding, [0.0, 0.0, 0.0, 0.0], "euclidean", 1.0)
LIMIT 3;
