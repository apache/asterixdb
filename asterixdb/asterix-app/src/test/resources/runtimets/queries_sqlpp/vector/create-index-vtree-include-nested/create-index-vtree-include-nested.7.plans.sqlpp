-- param compile-only:string=true
-- param optimized-logical-plan:string=true
SET `compiler.cbo` "false";
USE test;
// A NESTED INCLUDE column, filtered on and returned. Addressed by its full path [info, year], and served
// index-only: the projection reads the column off the search even though the compiler splits the nested
// access across two ASSIGNs, and the predicate is pushed into the search.
SELECT m.id, m.info.year AS year
FROM MovieSmall m
WHERE m.info.year > 2005
ORDER BY ann_distance(m.embedding, [0.0, 0.0, 0.0, 0.0], "euclidean", 1.0)
LIMIT 3;
