// A vector index on a composite primary key must accept DML after the build. The tuple the
// maintenance path writes carries every key field, so it matches the type traits the resource
// layer sizes from the dataset's primary keys.
DROP DATAVERSE testcpk IF EXISTS;
CREATE DATAVERSE testcpk;
USE testcpk;
CREATE TYPE MovieCpkType AS CLOSED {
  id1: int,
  id2: int,
  embedding: [double]
};
CREATE DATASET MovieCpk(MovieCpkType) PRIMARY KEY id1, id2;
