// Two rows sharing id1 and differing only in id2, both inserted after the build. A key that
// carried id1 alone could not tell them apart, so the index must hold both distinctly. Their
// distances are far apart relative to the quantization step, so the order does not depend on
// quantization error: ann_distance answers from quantized vectors and is approximate.
USE testcpk;
INSERT INTO MovieCpk ([
  {"id1": 1, "id2": 100, "embedding": [0.0, 0.0, 0.0, 0.07]},
  {"id1": 1, "id2": 101, "embedding": [0.0, 0.0, 0.0, 0.01]}
]);
