        </compilation-unit>
    </test-case>
    <test-case FilePath="vector">
        <compilation-unit name="create-index-vtree">
            <output-dir compare="Clean-JSON">create-index-vtree</output-dir>
        </compilation-unit>
    </test-case>
    <test-case FilePath="vector">
        <compilation-unit name="create-index-vtree-metadata">
            <output-dir compare="Clean-JSON">create-index-vtree-metadata</output-dir>
        </compilation-unit>
    </test-case>
    <test-case FilePath="vector">
        <compilation-unit name="create-index-vtree-meta-pk">
            <output-dir compare="Clean-JSON">create-index-vtree-meta-pk</output-dir>
        </compilation-unit>
    </test-case>
    <test-case FilePath="vector">
        <compilation-unit name="create-index-vtree-nested">
