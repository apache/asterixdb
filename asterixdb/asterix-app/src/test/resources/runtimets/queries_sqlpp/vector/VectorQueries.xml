        </compilation-unit>
    </test-case>
    <test-case FilePath="vector">
        <compilation-unit name="create-index-vtree-include-filter">
            <output-dir compare="Clean-JSON">create-index-vtree-include-filter</output-dir>
        </compilation-unit>
    </test-case>
    <test-case FilePath="vector">
        <compilation-unit name="create-index-vtree-include-nested">
            <output-dir compare="Clean-JSON">create-index-vtree-include-nested</output-dir>
