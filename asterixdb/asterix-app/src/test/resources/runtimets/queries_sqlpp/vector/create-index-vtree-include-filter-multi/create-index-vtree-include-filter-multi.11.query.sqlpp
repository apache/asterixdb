USE test;
// if_null() in the predicate: a function InjectTypeCastForFunctionArgumentsRule rewrites, typing it
// against the operator's INPUT environment. Harmless while the predicate is still a SELECT over the
// unnest-map's output variables; it is the shape that broke when the predicate was moved into the
// unnest-map's select condition during the access-method phase.
SELECT VALUE m.id
FROM MovieMulti m
WHERE if_null(m.year, 0) > 2005 AND m.rating = 5
ORDER BY ann_distance(m.embedding, [0.0, 0.0, 0.0, 0.0], "euclidean", 1.0)
LIMIT 3;
