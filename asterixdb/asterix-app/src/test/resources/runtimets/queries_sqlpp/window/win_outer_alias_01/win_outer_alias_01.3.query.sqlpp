/*
 * Description  : The FROM alias of a subquery is also the alias of the enclosing query.
 * Expected Res : Success
 */

FROM [{"x":1}] AS r
SELECT (FROM [{"a":1},{"a":2}] AS r GROUP BY r.a SELECT a, COUNT(*) OVER () AS c ORDER BY a) AS inr;
