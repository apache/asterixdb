/*
 * Description  : A FROM alias that is also the name of a WITH alias, followed by GROUP BY
 *                and a window function. The window frame record must not reference the
 *                FROM variable, which is dead after the GROUP BY.
 * Expected Res : Success
 */

WITH t AS (FROM [{"a":1},{"a":2}] AS x SELECT x.a)
FROM t
GROUP BY t.a
SELECT a, COUNT(*) OVER () AS c
ORDER BY a;
