/*
 * Description  : As above, the window function over an aggregate computed by a LET after
 *                the GROUP BY.
 * Expected Res : Success
 */

WITH t AS (FROM [{"a":1,"b":10},{"a":1,"b":20},{"a":2,"b":30}] AS x SELECT x.a, x.b)
FROM t
GROUP BY t.a
LET s = SUM(t.b)
SELECT a, s, SUM(s) OVER () AS tot
ORDER BY a;
