/*
 * Description     : UPSERT INTO a collection selecting from a DIFFERENT collection that shares the
 *                   same dataset name in another dataverse. Not a self-scan, so no materialize is
 *                   introduced; this verifies the results are still correct without it.
 * Expected Result : Success
 */

drop  dataverse syncdv if exists;
drop  dataverse proddv if exists;
create  dataverse syncdv;
create  dataverse proddv;

create type syncdv.myDataType as
{
  id : bigint
};

create type proddv.myDataType as
{
  id : bigint
};

create  dataset syncdv.myData(syncdv.myDataType) primary key id;
create  dataset proddv.myData(proddv.myDataType) primary key id;
