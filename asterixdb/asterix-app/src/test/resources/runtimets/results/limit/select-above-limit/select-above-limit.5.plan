distribute result [$$35]
-- DISTRIBUTE_RESULT  |UNPARTITIONED|
  exchange
  -- ONE_TO_ONE_EXCHANGE  |UNPARTITIONED|
    order (ASC, $$35)
    -- STABLE_SORT [$$35(ASC)]  |UNPARTITIONED|
      exchange
      -- ONE_TO_ONE_EXCHANGE  |UNPARTITIONED|
        select (gt($$36, 2001)) project: [$$35]
        -- STREAM_SELECT  |UNPARTITIONED|
          limit 3
          -- STREAM_LIMIT  |UNPARTITIONED|
            exchange
            -- SORT_MERGE_EXCHANGE [$$36(ASC) ]  |PARTITIONED|
              limit 3
              -- STREAM_LIMIT  |PARTITIONED|
                exchange
                -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                  order (topK: 3) (ASC, $$36)
                  -- STABLE_SORT [topK: 3] [$$36(ASC)]  |PARTITIONED|
                    exchange
                    -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                      assign [$$36] <- [$$m.getField(1)] project: [$$35, $$36]
                      -- ASSIGN  |PARTITIONED|
                        exchange
                        -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                          data-scan []<-[$$35, $$m] <- test.Movies
                          -- DATASOURCE_SCAN  |PARTITIONED|
                            exchange
                            -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                              empty-tuple-source
                              -- EMPTY_TUPLE_SOURCE  |PARTITIONED|
