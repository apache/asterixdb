distribute result [$$22]
-- DISTRIBUTE_RESULT  |UNPARTITIONED|
  exchange
  -- ONE_TO_ONE_EXCHANGE  |UNPARTITIONED|
    limit 3
    -- STREAM_LIMIT  |UNPARTITIONED|
      project ([$$22])
      -- STREAM_PROJECT  |PARTITIONED|
        exchange
        -- SORT_MERGE_EXCHANGE [$$40(ASC) ]  |PARTITIONED|
          limit 3
          -- STREAM_LIMIT  |PARTITIONED|
            exchange
            -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
              order (topK: 3) (ASC, $$40)
              -- STABLE_SORT [topK: 3] [$$40(ASC)]  |PARTITIONED|
                exchange
                -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                  assign [$$22] <- [{"id": $$39, "y": $$42}] project: [$$22, $$40]
                  -- ASSIGN  |PARTITIONED|
                    assign [$$42] <- [numeric-add($$41, 1)] project: [$$39, $$40, $$42]
                    -- ASSIGN  |PARTITIONED|
                      exchange
                      -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                        unnest-map [$$39, $$40, $$41] <- index-search("idx_emb", 8, "Default", "test", "MovieSmall", false, false, true, 5, $$34, $$35, $$36, $$37, $$38) condition (gt(numeric-add($$41, 1), 2006))
                        -- VECTOR_SEARCH  |PARTITIONED|
                          exchange
                          -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                            assign [$$34, $$35, $$36, $$37, $$38] <- [array: [ 0.0, 0.0, 0.0, 0.0 ], 3, "euclidean", 1.0, 1]
                            -- ASSIGN  |PARTITIONED|
                              empty-tuple-source
                              -- EMPTY_TUPLE_SOURCE  |PARTITIONED|
