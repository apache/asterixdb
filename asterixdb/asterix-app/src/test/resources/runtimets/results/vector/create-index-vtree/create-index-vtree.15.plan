distribute result [$$34]
-- DISTRIBUTE_RESULT  |UNPARTITIONED|
  exchange
  -- ONE_TO_ONE_EXCHANGE  |UNPARTITIONED|
    limit 3
    -- STREAM_LIMIT  |UNPARTITIONED|
      assign [$$34] <- [{"id": $$36, "embedding": $$35}] project: [$$34]
      -- ASSIGN  |PARTITIONED|
        project ([$$36, $$35])
        -- STREAM_PROJECT  |PARTITIONED|
          exchange
          -- SORT_MERGE_EXCHANGE [$$dist(ASC) ]  |PARTITIONED|
            limit 3
            -- STREAM_LIMIT  |PARTITIONED|
              exchange
              -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                order (topK: 3) (ASC, $$dist)
                -- STABLE_SORT [topK: 3] [$$dist(ASC)]  |PARTITIONED|
                  exchange
                  -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                    assign [$$dist] <- [euclidean-distance($$35, array: [ 0.0, 0.0, 0.0, 0.0 ])]
                    -- ASSIGN  |PARTITIONED|
                      assign [$$35] <- [$$m.getField(1)] project: [$$36, $$35]
                      -- ASSIGN  |PARTITIONED|
                        exchange
                        -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                          unnest-map [$$36, $$m] <- index-search("MovieSmall", 0, "Default", "test", "MovieSmall", false, false, 1, $$43, 1, $$43, true, true, true)
                          -- BTREE_SEARCH  |PARTITIONED|
                            exchange
                            -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                              order (ASC, $$43)
                              -- STABLE_SORT [$$43(ASC)]  |PARTITIONED|
                                exchange
                                -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                  unnest-map [$$43] <- index-search("idx_emb", 8, "Default", "test", "MovieSmall", false, false, false, 5, $$38, $$39, $$40, $$41, $$42)
                                  -- VECTOR_SEARCH  |PARTITIONED|
                                    exchange
                                    -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                      assign [$$38, $$39, $$40, $$41, $$42] <- [array: [ 0.0, 0.0, 0.0, 0.0 ], 3, "euclidean", 1.0, 1]
                                      -- ASSIGN  |PARTITIONED|
                                        empty-tuple-source
                                        -- EMPTY_TUPLE_SOURCE  |PARTITIONED|
