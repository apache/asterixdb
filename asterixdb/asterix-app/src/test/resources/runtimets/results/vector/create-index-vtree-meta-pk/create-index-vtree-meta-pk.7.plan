distribute result [$$16]
-- DISTRIBUTE_RESULT  |UNPARTITIONED|
  exchange
  -- ONE_TO_ONE_EXCHANGE  |UNPARTITIONED|
    limit 3
    -- STREAM_LIMIT  |UNPARTITIONED|
      project ([$$16])
      -- STREAM_PROJECT  |PARTITIONED|
        exchange
        -- SORT_MERGE_EXCHANGE [$$20(ASC) ]  |PARTITIONED|
          limit 3
          -- STREAM_LIMIT  |PARTITIONED|
            exchange
            -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
              order (topK: 3) (ASC, $$20)
              -- STABLE_SORT [topK: 3] [$$20(ASC)]  |PARTITIONED|
                exchange
                -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                  assign [$$20, $$16] <- [euclidean-distance($$m.getField(0), array: [ 0.0, 0.0, 0.0, 0.0 ]), $$m.getField("id")] project: [$$16, $$20]
                  -- ASSIGN  |PARTITIONED|
                    project ([$$m])
                    -- STREAM_PROJECT  |PARTITIONED|
                      exchange
                      -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                        unnest-map [$$21, $$m, $$22] <- index-search("VecMeta", 0, "Default", "test", "VecMeta", false, false, 1, $$29, 1, $$29, true, true, true)
                        -- BTREE_SEARCH  |PARTITIONED|
                          exchange
                          -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                            order (ASC, $$29)
                            -- STABLE_SORT [$$29(ASC)]  |PARTITIONED|
                              exchange
                              -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                unnest-map [$$29] <- index-search("idx_emb", 8, "Default", "test", "VecMeta", false, false, false, 5, $$24, $$25, $$26, $$27, $$28)
                                -- VECTOR_SEARCH  |PARTITIONED|
                                  exchange
                                  -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                    assign [$$24, $$25, $$26, $$27, $$28] <- [array: [ 0.0, 0.0, 0.0, 0.0 ], 3, "euclidean", 1.0, 1]
                                    -- ASSIGN  |PARTITIONED|
                                      empty-tuple-source
                                      -- EMPTY_TUPLE_SOURCE  |PARTITIONED|
