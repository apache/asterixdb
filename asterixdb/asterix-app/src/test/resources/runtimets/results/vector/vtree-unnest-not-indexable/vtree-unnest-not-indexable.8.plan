distribute result [$$31]
-- DISTRIBUTE_RESULT  |UNPARTITIONED|
  exchange
  -- ONE_TO_ONE_EXCHANGE  |UNPARTITIONED|
    limit 3
    -- STREAM_LIMIT  |UNPARTITIONED|
      project ([$$31])
      -- STREAM_PROJECT  |PARTITIONED|
        exchange
        -- SORT_MERGE_EXCHANGE [$$35(ASC) ]  |PARTITIONED|
          limit 3
          -- STREAM_LIMIT  |PARTITIONED|
            exchange
            -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
              order (topK: 3) (ASC, $$35)
              -- STABLE_SORT [topK: 3] [$$35(ASC)]  |PARTITIONED|
                exchange
                -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                  assign [$$35, $$31] <- [euclidean-distance($$39, array: [ 0.0, 0.0, 0.0, 0.0 ]), {"id": $$36, "genre": $$g}] project: [$$31, $$35]
                  -- ASSIGN  |PARTITIONED|
                    unnest $$g <- scan-collection($$37) project: [$$36, $$39, $$g]
                    -- UNNEST  |PARTITIONED|
                      assign [$$39, $$37] <- [$$m.getField(2), $$m.getField(1)] project: [$$36, $$39, $$37]
                      -- ASSIGN  |PARTITIONED|
                        exchange
                        -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                          data-scan []<-[$$36, $$m] <- test.Movies
                          -- DATASOURCE_SCAN  |PARTITIONED|
                            exchange
                            -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                              empty-tuple-source
                              -- EMPTY_TUPLE_SOURCE  |PARTITIONED|
