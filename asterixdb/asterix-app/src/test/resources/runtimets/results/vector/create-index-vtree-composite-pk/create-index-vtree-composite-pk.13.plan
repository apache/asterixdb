distribute result [$$20]
-- DISTRIBUTE_RESULT  |UNPARTITIONED|
  exchange
  -- ONE_TO_ONE_EXCHANGE  |UNPARTITIONED|
    limit 3
    -- STREAM_LIMIT  |UNPARTITIONED|
      project ([$$20])
      -- STREAM_PROJECT  |PARTITIONED|
        exchange
        -- SORT_MERGE_EXCHANGE [$$24(ASC) ]  |PARTITIONED|
          limit 3
          -- STREAM_LIMIT  |PARTITIONED|
            exchange
            -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
              order (topK: 3) (ASC, $$24)
              -- STABLE_SORT [topK: 3] [$$24(ASC)]  |PARTITIONED|
                exchange
                -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                  assign [$$24, $$20] <- [euclidean-distance($$m.getField(4), array: [ 0.0, 0.0, 0.0, 0.0 ]), ordered-list-constructor($$26, $$27)] project: [$$20, $$24]
                  -- ASSIGN  |PARTITIONED|
                    exchange
                    -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                      unnest-map [$$26, $$27, $$m] <- index-search("MovieCpk", 0, "Default", "testcpk", "MovieCpk", false, false, 1, $$30, 1, $$31, true, true, true)
                      -- BTREE_SEARCH  |PARTITIONED|
                        exchange
                        -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                          assign [$$30, $$31] <- [1, 1]
                          -- ASSIGN  |PARTITIONED|
                            empty-tuple-source
                            -- EMPTY_TUPLE_SOURCE  |PARTITIONED|
