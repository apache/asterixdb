[{"#operator":"Advise","advice":{"#operator":"IndexAdvice","adviseinfo":{"current_indexes":[],"recommended_indexes":{"indexes":[{"index_statement":"CREATE INDEX idx_adv_vector_meta_embedding ON `Default`.`test`.`MovieNested`(`meta`.`embedding` VECTOR) INCLUDE (`genre`,`year`) TYPE VTREE WITH {\"dimension\": 4, \"similarity\": \"cosine\"};"}]}}}}]