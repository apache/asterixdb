<!-- Everything in testsuite_it_python.xml, plus the cases that can only hold when the UDF
     interpreter is a separate, fenced process reached over a domain socket. Those report
     failures differently from the in-process interpreter the plain suite runs against, so only
     PodmanPythonFunctionIT reads this file. -->
<!DOCTYPE test-suite [
        <!ENTITY PythonQueries SYSTEM "queries_sqlpp/external-library/PythonQueries.xml">
        <!ENTITY PythonFencedQueries SYSTEM "queries_sqlpp/external-library/PythonFencedQueries.xml">
        ]>
<test-suite
             xmlns="urn:xml.testframework.asterix.apache.org"
             ResultOffsetPath="results"
             QueryOffsetPath="queries_sqlpp"
             QueryFileExtension=".sqlpp">
  &PythonQueries;
  &PythonFencedQueries;
</test-suite>
